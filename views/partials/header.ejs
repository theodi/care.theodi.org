<!-- views/partials/header.ejs -->
<!DOCTYPE html>
<html prefix="dct: http://purl.org/dc/terms/
              rdf: http://www.w3.org/1999/02/22-rdf-syntax-ns#
              dcat: http://www.w3.org/ns/dcat#
              odrs: http://schema.theodi.org/odrs#">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= page.title %></title>
<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

<script type="text/javascript" src="/lib/jquery-3.7.1.min.js"></script>
<script type="text/javascript" src="/lib/underscore.js"></script>
<script type="text/javascript" src="/lib/jquery-ui.js"></script>
<script type="text/javascript" src="/lib/jsv.js"></script>
<script type="text/javascript" src="/lib/jsonform.js"></script>
<script type="text/javascript" src="/js/glossary.js"></script>

<link href="/css/water.css" rel="stylesheet">
<link href="/css/glyphicon.css" rel="stylesheet">
<link href="/css/style.css" rel="stylesheet">
<link rel="shortcut icon" href="/images/odifavicon32.ico">

<script>
(function () {
  var meta = document.querySelector('meta[name="csrf-token"]');
  var token = meta && meta.getAttribute('content');
  if (!token) {
    return;
  }

  // Attach CSRF header to all same-origin non-GET jQuery AJAX requests.
  if (window.jQuery && typeof window.jQuery.ajaxSetup === 'function') {
    window.jQuery.ajaxSetup({
      beforeSend: function (xhr, settings) {
        var method = (settings.type || 'GET').toUpperCase();
        if (!/^(GET|HEAD|OPTIONS)$/i.test(method)) {
          xhr.setRequestHeader('X-CSRF-Token', token);
        }
      }
    });
  }

  // Wrap fetch to add CSRF header on same-origin non-GET requests.
  if (window.fetch) {
    var originalFetch = window.fetch;
    window.fetch = function (input, init) {
      init = init || {};
      var method = (init.method || 'GET').toUpperCase();
      if (!/^(GET|HEAD|OPTIONS)$/i.test(method)) {
        if (!init.headers) {
          init.headers = {};
        }
        if (init.headers instanceof Headers) {
          init.headers.set('X-CSRF-Token', token);
        } else if (Array.isArray(init.headers)) {
          init.headers.push(['X-CSRF-Token', token]);
        } else {
          init.headers['X-CSRF-Token'] = token;
        }
      }
      return originalFetch(input, init);
    };
  }
})();
</script>

</head>
<body>
	<div id="contentOverlay" class="overlay">
		<div id="overlay-content" class="overlay-content" style="width: 90%; margin: auto; margin-top: 20px; max-height: 90vh;">
			<span class="close-btn" onclick="closeOverlay()" style="right: 40px;
			top: 20px;
			font-size: 3rem;
			font-weight: normal;">&times;</span>
			<div id="overlay-content-inner" style="overflow-y: scroll; min-width: 100%;"></div>
		</div>
	</div>
	<header class="header">
		<% if (typeof software !== 'undefined' && software && software.version && software.versionLink) { %>
		<p class="version"><a href="<%= software.versionLink %>" target="_blank">v<%= software.version %></a></p>
		<% } %>
		<div class="container">
			<div class="header-top">
			<a href="/" class="logo"></a>
			<nav class="main-nav" aria-label="Main Menu">
				<ul>
				<% if(user) { %>
                    <li><a href="/evaluations" class="toggle-link <% if (page.link === '/evaluations') { %>selected<% } %>">Evaluations</a></li>
                    <li><a href="/projects" class="toggle-link <% if (page.link === '/projects') { %>selected<% } %>">Dashboard</a></li>
					<% if (typeof hasOrganisationMembership !== 'undefined' && hasOrganisationMembership) { %>
					<li><a href="/organisation" class="toggle-link <% if (page.link === '/organisation') { %>selected<% } %>">Organisation</a></li>
					<% } %>
					<li>
						<a style="padding: 0;" class="toggle-link <% if (page.link === '/profile') { %>selected<% } %>" href="/profile"><%= user ? (user.displayName || (user.first_name && user.last_name ? user.first_name + ' ' + user.last_name : user.email)) : 'Guest' %></a>
						<form style="display: inline-flex;" id="logout_form" action="/logout" method="post">
                             &nbsp;(<a href="javascript:;" onclick="document.getElementById('logout_form').submit();">Log out)</a>
						</form>
					</li>
				<% } else { %>
					<li><a href="/auth/django" class="toggle-link">Login</a></li>
				<% } %>
				</ul>
			</nav>
			</div>
		</div>
	</header>