<link href="/lib/DataTables/datatables.min.css" rel="stylesheet">
<script src="/lib/DataTables/datatables.min.js"></script>
<div class="main-content">
  <section class="page-title container white">
    <h1 style="text-align: center;"><%= page.title %></h1>
    <input type="hidden" value="<%= page.link %>" id="pageId"/>
  </section>

  <div class="content-block white">
    <p style="text-align: center;">
      <button class="transparent" type="button" onclick="window.location.href='/subscriptions/new'">New subscription</button>
    </p>
    <div id="subscriptionsMessage" class="alert" style="display:none;"></div>
  </div>

  <div class="content-block light-blue">
    <h2>All subscriptions</h2>
    <table id="subscriptionsTable" class="display" style="width:100%">
      <thead>
        <tr>
          <th>Organisation</th>
          <th>Domain</th>
          <th>Plan</th>
          <th>Seats</th>
          <th>Dates</th>
          <th>Status</th>
          <th>Admins</th>
        </tr>
      </thead>
      <tbody id="subscriptionsTableBody"></tbody>
    </table>
  </div>
</div>
<script src="/js/subscriptions-list.js"></script>
