<section class="content-block light-blue">
  <h1>Profile information</h1>
  <p>
    <b>ID</b>: <%= userProfile.id %><br>
    <b>Email</b>: <%= userProfile.email %><br>
    <b>Name</b>: <%= userProfile.name || user.displayName || (user.first_name + ' ' + user.last_name) %><br>
    <b>Last login:</b> <%= userProfile.lastLoginFormatted %><br>
    <b>Login count:</b> <%= userProfile.loginCount %><br>
    <h2>Membership</h2>
    <% const hs = userProfile.hubspot; %>
    <b>ODI membership status:</b> <%= hs && hs.membershipStatus != null ? hs.membershipStatus : '—' %><br>
    <b>ODI membership as part of company?:</b> <%= hs && hs.companyMembership != null ? hs.companyMembership : '—' %><br>
    <b>ODI membership type: </b> <%= hs && hs.membershipType != null ? hs.membershipType : '—' %> <br>
  </p>
  <h2>Organisation subscription (CARE)</h2>
  <p>
    <% const co = typeof careOrganisationMembership !== 'undefined' ? careOrganisationMembership : null; %>
    <% if (co && co.isMember) { %>
      <b>Status:</b> Active — your sign-in email is on an organisation subscription.<br>
      <b>Organisation:</b>
      <% if (co.organisationName) { %><%= co.organisationName %><% } else if (co.emailDomain) { %>@<%= co.emailDomain %><% } else { %>—<% } %><br>
      <% if (co.organisationName && co.emailDomain) { %>
      <span class="small">Email domain: @<%= co.emailDomain %></span><br>
      <% } %>
      <b>Your access:</b>
      <% if (co.isAdmin) { %>Organisation admin (full access)<% } else { %>Licensed user<% var bits = []; if (co.licenseAdmin) bits.push('license admin'); if (co.aiModelAdmin) bits.push('AI model admin'); if (co.promptAdmin) bits.push('prompt admin'); if (co.reportAdmin) bits.push('report manager'); if (co.projectManager) bits.push('project manager'); if (bits.length) { %> — <%= bits.join(', ') %><% } %><% } %><br>
      <a href="/organisation">Open organisation page</a>
    <% } else { %>
      <b>Status:</b> Not on an active organisation subscription in CARE.<br>
      <span class="small">Organisation access uses your account email. If your organisation uses CARE, ask an admin to add you; you will see shared evaluations once your subscription is active.</span>
    <% } %>
  </p>
</section>

<section class="content-block white">
  <h2>Delete account</h2>
  <form id="deleteForm" action="/profile" method="POST">
    <button type="button" onclick="confirmDelete()">Delete account</button>
  </form>
  <p id="errorMessage" style="color: red;"></p> <!-- Error message element -->
</section>

<script>
  function confirmDelete() {
    const confirmed = confirm('Are you sure you want to delete your account?');
    if (confirmed) {
      deleteUser();
    }
  }

  function deleteUser() {
    fetch('/profile', {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json'
      }
    })
    .then(response => {
      if (response.ok) {
        // Successful deletion, redirect to logout
        window.location.href = '/auth/logout';
      } else {
        // Error handling
        return response.json();
      }
    })
    .then(data => {
      const errorMessage = data.error || 'Failed to delete account';
      console.error('Failed to delete account:', errorMessage);
      // Display error message to the user
      document.getElementById('errorMessage').innerText = errorMessage;
    })
    .catch(error => {
      console.error('Error:', error);
      // Display error message to the user
      document.getElementById('errorMessage').innerText = 'Failed to delete account <br/>' + error;
    });
  }
</script>