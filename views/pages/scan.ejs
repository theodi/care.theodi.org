<!-- views/profile.ejs -->
<form id="dataForm" data-project-id="<%= (typeof project !== 'undefined' && project) ? project._id : '' %>">
</form>

<%- include('../partials/scan-footer') %>

<script>

let form = {};
let schema = {};
let projectData = {};
let projectId = "";
let autosaveTimer = null;
let autosaveInFlight = false;
let autosaveQueued = false;
let autosaveBindingsAttached = false;
const AUTOSAVE_DEBOUNCE_MS = 1200;
/** Bumped on each scan step navigation so stale async renders cannot move the wrong button. */
let scanRenderGeneration = 0;

$('#dataForm').html("");
$('#result').html("");
$('form').show();

document.addEventListener("DOMContentLoaded", function () {

    // Get the project ID
    const form = document.getElementById("dataForm");
    projectId = form.dataset.projectId;

    // Get the form name from the URL
    const urlParts = window.location.pathname.split('/');
    const formName = urlParts.length >= 4 && urlParts[3] !== undefined ? urlParts[3] : 'projectDetails';

    // load the data
    loadPage(formName,projectId);
});

async function loadPage(formName, projectId) {
    const generation = ++scanRenderGeneration;
    projectData = await loadProject(projectId);
    await populateBlankArrays();
    await loadFormComponents(formName);
    await renderForm(projectData, generation);
    if (generation !== scanRenderGeneration) return;
    extractDisabledFieldValues("dataForm");
    if (typeof window.setupCareStepHelp === 'function') {
        await window.setupCareStepHelp();
    }
    try {
        await loadAI();
    } catch (aiErr) {
        console.error('loadAI failed during initial page load', aiErr);
    }
    if (generation !== scanRenderGeneration) return;
    moveSubmitButton(0, generation);
    attachAutosaveBindings();
}

async function reloadPage() {
    if (typeof window.cleanupCareAiCompactUi === 'function') {
        window.cleanupCareAiCompactUi();
    }
    if (typeof window.careCloseStepHelpModal === 'function') {
        window.careCloseStepHelpModal();
    }
    const generation = ++scanRenderGeneration;
    await renderForm(projectData, generation);
    if (generation !== scanRenderGeneration) return;
    extractDisabledFieldValues("dataForm");
    if (typeof window.setupCareStepHelp === 'function') {
        await window.setupCareStepHelp();
    }
    try {
        await loadAI();
    } catch (aiErr) {
        console.error('loadAI failed during step navigation', aiErr);
    }
    if (generation !== scanRenderGeneration) return;
    moveSubmitButton(0, generation);
}

window.mergeFormValuesIntoProjectData = function (values) {
    values = populateMissingElements(schema, values);
    for (const key in values) {
        projectData[key] = values[key];
    }
    return projectData;
};

async function populateBlankArrays() {
    try {
        // Fetch the project schema
        const response = await fetch('/data/schemas/project.json');
        const schema = await response.json();
        const properties = schema.properties;

        // Iterate over each property in the schema
        Object.keys(properties).forEach(propertyName => {
            const property = properties[propertyName];
            // Check if the property is an array
            if (property.type === 'array') {
                // Ensure array fields exist, but do not inject blank entries.
                // Blank nested objects can fail backend validation on save.
                if (!Array.isArray(projectData[propertyName])) {
                    projectData[propertyName] = [];
                }
            }
        });
    } catch (error) {
        console.error('Error fetching or processing schema:', error);
    }
}

async function updatePageTitle(pageLink) {
    const pages = [
        {
            "link": "projectDetails",
            "title": "Project details"
        },
        {
            "link": "intendedConsequences",
            "title": "Intended consequences"
        },
        {
            "link": "unintendedConsequences",
            "title": "Unintended consequences"
        },
        {
            "link": "riskEvaluation",
            "title": "Risk evaluation"
        },
        {
            "link": "stakeholders",
            "title": "Stakeholders"
        },
        {
            "link": "actionPlanning",
            "title": "Action planning"
        },
        {
            "link": "actionCompletion",
            "title": "Action completion"
        }
    ]
    // Find the corresponding page object
    const page = pages.find(item => item.link === pageLink);
    document.getElementById("pageId").value = page.link;

    // Update the page title within the HTML
    const pageTitleElement = document.querySelector('.page-title h1');
    if (pageTitleElement && page) {
        pageTitleElement.textContent = page.title;
    }

    if (typeof window.setCareAiTitleSlotVisible === 'function') {
        window.setCareAiTitleSlotVisible(
            ['intendedConsequences', 'unintendedConsequences', 'stakeholders'].indexOf(pageLink) !== -1
        );
    }

    // Update the HTML <title> attribute
    if (page) {
        document.title = page.title;
    }

}

async function quickNav(page) {
    // Update the URL without reloading the page
    history.pushState({}, '', `/project/${projectId}/${page}`);

    // Update the selected state of sidebar items
    const sidebarLinks = document.querySelectorAll('.project-menu li a');
    sidebarLinks.forEach(link => {
        if (link.getAttribute('id') === `${page}`) {
            link.classList.add('selected');
        } else {
            link.classList.remove('selected');
        }
    });

    // Load form components
    await loadFormComponents(page);

    await updatePageTitle(page);

    await reloadPage();
}

/**
 * HTML date inputs only accept YYYY-MM-DD. Normalise ISO strings and trim
 * legacy values so the picker shows the stored date instead of appearing blank.
 */
function normalizeActionDueDatesForHtmlDateInput(data) {
    if (!data || !Array.isArray(data.unintendedConsequences)) return;
    for (const uc of data.unintendedConsequences) {
        if (!uc.action) continue;
        for (const key of ['date', 'completedAt']) {
            let d = uc.action[key];
            if (d == null || String(d).trim() === '') {
                uc.action[key] = '';
                continue;
            }
            d = String(d).trim();
            const dayPart = d.slice(0, 10);
            if (/^\d{4}-\d{2}-\d{2}$/.test(dayPart)) {
                uc.action[key] = dayPart;
                continue;
            }
            const parsed = new Date(d);
            if (!Number.isNaN(parsed.getTime())) {
                const y = parsed.getUTCFullYear();
                const m = String(parsed.getUTCMonth() + 1).padStart(2, '0');
                const day = String(parsed.getUTCDate()).padStart(2, '0');
                uc.action[key] = `${y}-${m}-${day}`;
            } else {
                uc.action[key] = '';
            }
        }
    }
}

async function renderForm(data, generation) {
    document.getElementById('dataForm').innerHTML = "";
    try {
        normalizeActionDueDatesForHtmlDateInput(data);

        $('#dataForm').jsonForm({
            schema: schema,
            form: form,
            value: populateMissingElements(schema, data),
            onSubmit: function (errors, values) {
                values = populateMissingElements(schema, values);
                if (errors) {
                    console.log(errors);
                    showErrorOverlay('Please correct the errors in your form');
                } else {
                    for (const key in values) {
                        data[key] = values[key];
                    }
                    sendDataToServer(data);
                }
            }
        });

         const formName = window.location.pathname.split('/')[3];
        if (formName === "riskEvaluation" || formName === "actionPlanning" || formName === "actionCompletion") {
            lockUnintendedConsequencesArray();
            const gen = generation;
            setTimeout(function () {
                if (gen !== scanRenderGeneration) return;
                lockUnintendedConsequencesArray();
                hideIrrelevantConsequencesForCurrentStep();
                moveSubmitButton(0, gen);
            }, 200);
        }
    } catch (error) {
        console.error("Error rendering form:", error);
    }
}

async function loadFormComponents(formName) {
    const schemaResponse = await fetch(`/schemas/partials/${formName}.json`);
    const fullSchema = await schemaResponse.json();
    schema = fullSchema.properties;

    // Fetch the form from the corresponding JSON file
    const formResponse = await fetch(`/data/forms/${formName}.json`);
    form = await formResponse.json();
}

function populateMissingElements(schema,data) {
    for (const key in schema) {
        if (!(key in data) && key !== "_id") {
            if (schema[key].type === "array") {
                // Initialize missing array elements as empty arrays
                data[key] = [];
            } else {
                // Initialize missing elements as empty strings
                data[key] = "";
            }
        }
    }
    return data;
}

function moveSubmitButton(retryCount, generation) {
    if (generation != null && generation !== scanRenderGeneration) {
        return;
    }
    var attempt = retryCount != null ? retryCount : 0;
    const formElement = document.getElementById('dataForm');
    const submitButton = formElement ? formElement.querySelector('.submitButton') : null;

    if (!formElement || !submitButton) {
        if (attempt < 12) {
            setTimeout(function () {
                moveSubmitButton(attempt + 1, generation);
            }, 80);
            return;
        }
        console.error("submitButtonContainer or submitButton not found.");
        return;
    }

    // Prevent duplicate proceed containers when re-rendering via quick navigation.
    const existingContainer = document.getElementById('submitButtonContainer');
    if (existingContainer) {
        existingContainer.remove();
    }

    const submitButtonContainer = document.createElement('div');
    submitButtonContainer.setAttribute('id', 'submitButtonContainer');
    submitButtonContainer.classList.add('content-block', 'white', 'proceed');

    // Preserve jsonForm layout styles by moving the wrapper when present.
    const submitButtonWrapper =
        submitButton.closest('.form-actions') ||
        submitButton.closest('li') ||
        submitButton;
    submitButtonContainer.appendChild(submitButtonWrapper);
    formElement.appendChild(submitButtonContainer);
}

function projectPayloadForSave(obj) {
  if (!obj || typeof obj !== 'object') return obj;
  const out = { ...obj };
  delete out.aiInteractionHistory;
  delete out.aiInteractionHistoryCount;
  delete out.aiInteractionHistoryStepCounts;
  return out;
}

function isTextEntryElement(element) {
  if (!element) return false;
  const tag = (element.tagName || '').toUpperCase();
  if (tag === 'TEXTAREA') return true;
  if (tag !== 'INPUT') return false;
  const type = (element.type || '').toLowerCase();
  return ['text', 'search', 'email', 'url', 'tel', 'password', 'number'].includes(type);
}

function isAutosaveTarget(element) {
  if (!element || element.disabled) return false;
  const tag = (element.tagName || '').toUpperCase();
  if (!['INPUT', 'SELECT', 'TEXTAREA'].includes(tag)) return false;
  if (element.classList && element.classList.contains('disabled')) return false;
  if (tag === 'INPUT') {
    const type = (element.type || '').toLowerCase();
    if (['hidden', 'submit', 'button', 'reset', 'file'].includes(type)) return false;
  }
  return true;
}

function clearAutosaveTimer() {
  if (!autosaveTimer) return;
  clearTimeout(autosaveTimer);
  autosaveTimer = null;
}

function scheduleAutosave(delayMs = AUTOSAVE_DEBOUNCE_MS) {
  clearAutosaveTimer();
  autosaveTimer = setTimeout(() => {
    autosaveTimer = null;
    void runAutosave();
  }, delayMs);
}

async function runAutosave() {
  if (autosaveInFlight) {
    autosaveQueued = true;
    return;
  }
  const $ = window.jQuery;
  if (!$ || typeof window.mergeFormValuesIntoProjectData !== 'function' || typeof window.sendDataToServer !== 'function') {
    return;
  }
  const $form = $('#dataForm');
  if (!$form || $form.length === 0) return;
  const tree = $form.data('jsonform-tree');
  if (!tree) return;

  autosaveInFlight = true;
  try {
    const values = $form.jsonFormValue();
    const payload = window.mergeFormValuesIntoProjectData(values);
    await window.sendDataToServer(payload, { autoSave: true });
  } finally {
    autosaveInFlight = false;
    if (autosaveQueued) {
      autosaveQueued = false;
      scheduleAutosave(400);
    }
  }
}

function attachAutosaveBindings() {
  if (autosaveBindingsAttached) return;
  const formEl = document.getElementById('dataForm');
  if (!formEl) return;

  // Text entries save on blur to avoid interrupting typing.
  formEl.addEventListener('focusout', (event) => {
    const target = event.target;
    if (!isAutosaveTarget(target) || !isTextEntryElement(target)) return;
    scheduleAutosave();
  });

  // Non-text controls (select, checkbox, radio, etc.) save on change.
  formEl.addEventListener('change', (event) => {
    const target = event.target;
    if (!isAutosaveTarget(target)) return;
    if (isTextEntryElement(target)) return;
    scheduleAutosave(300);
  });

  // Avoid duplicate save when explicit submit/navigation is triggered.
  formEl.addEventListener('submit', () => {
    clearAutosaveTimer();
  });

  autosaveBindingsAttached = true;
}

function updateSidebarCompletionStates(pages) {
  if (!Array.isArray(pages)) return;
  pages.forEach((page) => {
    if (!page || !page.link || !page.completionState) return;
    const link = document.getElementById(page.link);
    if (!link) return;
    const listItem = link.closest('li');
    if (!listItem) return;
    listItem.classList.remove('todo', 'inProgress', 'done');
    listItem.classList.add(page.completionState);
  });
}

async function refreshSidebarCompletionStates(id) {
  if (!id) return;
  try {
    const response = await fetch(`/project/${id}/progress`, {
      headers: {
        "Accept": "application/json"
      }
    });
    if (!response.ok) {
      return;
    }
    const responseData = await response.json();
    updateSidebarCompletionStates(responseData.pages);
  } catch (error) {
    console.error("Unable to refresh sidebar completion states", error);
  }
}

async function sendDataToServer(inputObject, navigationOverride) {
  inputObject = cleanArrays(inputObject);
  console.log(inputObject);
  const autoSave = !!(navigationOverride && navigationOverride.autoSave);
  let url;
  let method;
  const form = document.getElementById("dataForm");
  let id = form.dataset.projectId || projectId;

  if (id) {
    url = `/project/${id}`;
    method = "PUT";
  } else {
    url = `/project/`;
    method = "POST";
  }

  try {
    const response = await fetch(url, {
      method,
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      body: JSON.stringify(projectPayloadForSave(inputObject)),
    });

    if (response.ok) {
      if (method == "POST") {
        const responseData = await response.json();
        id = responseData._id;
        projectId = id;
        form.dataset.projectId = id;
      }
      await refreshSidebarCompletionStates(id);
      if (autoSave) {
        return;
      }
      if (navigationOverride && navigationOverride.navigateQuickNavTo) {
        try {
          await quickNav(navigationOverride.navigateQuickNavTo);
        } catch (navErr) {
          console.error('Navigation after save failed', navErr);
          showErrorOverlay(
            'Your changes were saved, but the next step could not be loaded. Refresh the page or use the menu to continue.'
          );
        }
        return;
      }
      const nextAttributeValue = $('.submitButton').attr('next');
      const quickNavAttributeValue = $('.submitButton').attr('quickNav');

      if (quickNavAttributeValue === "true" && nextAttributeValue) {
        try {
          await quickNav(nextAttributeValue);
        } catch (navErr) {
          console.error('Navigation after save failed', navErr);
          showErrorOverlay(
            'Your changes were saved, but the next step could not be loaded. Refresh the page or use the menu to continue.'
          );
        }
      } else if (id && nextAttributeValue) {
        window.location.href = `/project/${id}/${nextAttributeValue}`;
      } else {
        window.location.href = `/project/${id}/`;
      }
    } else {
        // Request failed, handle errors
        let errorMessage = 'Could not save your changes. Please try again.';
        try {
            const errorData = await response.json();
            if (errorData && errorData.message) {
                errorMessage = errorData.message;
            }
        } catch (parseErr) {
            console.warn('Save failed with non-JSON response', response.status, parseErr);
        }
        if (autoSave) {
          console.warn("Autosave failed:", errorMessage);
        } else {
          showErrorOverlay(errorMessage);
        }
    }
  } catch (error) {
    console.error('sendDataToServer failed', error);
    const errorMessage = autoSave
      ? null
      : (error && error.message
          ? String(error.message)
          : 'An error occurred. Please try again later.');
    if (autoSave) {
      console.warn("Autosave network error", error);
    } else if (errorMessage) {
      showErrorOverlay(errorMessage);
    }
  }
}


/**
 * Recursively cleans arrays in an object, removing null and undefined values.
 */
 function cleanArrays(obj) {
  if (Array.isArray(obj)) {
    // Remove null and undefined, and re-index the array
    return obj.filter(item => item != null).map(item => cleanArrays(item));
  } else if (obj !== null && typeof obj === "object") {
    // If obj is an object, recursively clean its properties
    for (let key in obj) {
      obj[key] = cleanArrays(obj[key]);
    }
  }
  return obj;
}

function escapeHtml(text) {
  return String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function showErrorOverlay(errorMessage) {
    document.getElementById("error-content-inner").innerHTML =
      '<p>' + escapeHtml(errorMessage) + '</p>';

    // Show the error overlay
    document.getElementById("error-overlay").style.display = 'block';
}

function closeErrorOverlay() {
    // Hide the error overlay
    document.getElementById("error-overlay").style.display = 'none';
}

function extractDisabledFieldValues(formId) {
    const form = document.getElementById(formId);

    if (!form) {
        console.error('Form not found.');
        return;
    }

    const disabledFields = form.querySelectorAll('input.disabled, select.disabled, textarea.disabled');

    if (disabledFields.length === 0) {
        return;
    }

    disabledFields.forEach(field => {
        if (field.dataset.readonlyDisplayed === '1') {
            return;
        }
        const fieldValue = field.value;

        // Hide the original field
        field.style.display = 'none';

        // Create a new paragraph element to display the field value
        const paragraphElement = document.createElement('p');
        paragraphElement.className = 'scan-readonly-value';
        const text = fieldValue == null ? '' : String(fieldValue).trim();
        paragraphElement.textContent = text !== '' ? fieldValue : '—';

        // Insert the new paragraph element after the original field
        field.parentNode.insertBefore(paragraphElement, field.nextSibling);
        field.dataset.readonlyDisplayed = '1';
    });
}
function lockUnintendedConsequencesArray() {
    var formName = window.location.pathname.split('/')[3];
    if (formName !== 'riskEvaluation' && formName !== 'actionPlanning' && formName !== 'actionCompletion') {
        return;
    }
    var form = document.getElementById('dataForm');
    if (!form) return;

    form.querySelectorAll(
        '._jsonform-array-addmore, ._jsonform-array-deletelast, ._jsonform-array-deletecurrent, ._jsonform-array-deleteitem'
    ).forEach(function (btn) {
        btn.style.display = 'none';
        btn.setAttribute('aria-hidden', 'true');
        btn.tabIndex = -1;
    });

    form.querySelectorAll('._jsonform-array-buttons').forEach(function (wrap) {
        wrap.style.display = 'none';
    });

    form.querySelectorAll('span.draggable.line').forEach(function (handle) {
        handle.style.display = 'none';
    });

    if (window.jQuery) {
        window.jQuery('#dataForm ul._jsonform-array-ul').each(function () {
            var $ul = window.jQuery(this);
            if (!$ul.sortable) return;
            try {
                if ($ul.sortable('instance')) {
                    $ul.sortable('destroy');
                }
            } catch (e) {
                /* ignore */
            }
        });
    }
}

function hasPlannedActionForCompletion(uc) {
    if (!uc || !uc.action) return false;
    function hasValue(v) {
        return v != null && String(v).trim() !== '';
    }
    return (
        hasValue(uc.impact) &&
        hasValue(uc.likelihood) &&
        hasValue(uc.role) &&
        hasValue(uc.action.description) &&
        hasValue(uc.action.stakeholder) &&
        hasValue(uc.action.date) &&
        hasValue(uc.action.KPI)
    );
}

function applyActionCompletionUI() {
    if (!Array.isArray(projectData.unintendedConsequences)) return;

    projectData.unintendedConsequences.forEach(function (uc, index) {
        var consequenceField = document.querySelector('[name="unintendedConsequences[' + index + '].consequence"]');
        if (!consequenceField) return;
        var itemContainer = consequenceField.closest('li[data-idx]') || consequenceField.closest('li');
        if (!itemContainer) return;

        var recordBlock = itemContainer.querySelector('fieldset.action-completion-record');
        var existingMsg = itemContainer.querySelector('.action-completion-no-action-msg');
        if (existingMsg) existingMsg.remove();

        if (hasPlannedActionForCompletion(uc)) {
            if (recordBlock) recordBlock.style.display = '';
            return;
        }

        if (recordBlock) recordBlock.style.display = 'none';

        var msg = document.createElement('div');
        msg.className = 'action-completion-no-action-msg infobox small';
        msg.setAttribute('role', 'status');
        msg.innerHTML =
            '<p><strong>No action to complete.</strong> No mitigation action was defined for this consequence during action planning. ' +
            'Return to the action planning step if you still need to add one.</p>';

        if (recordBlock && recordBlock.parentNode) {
            recordBlock.parentNode.insertBefore(msg, recordBlock);
        } else {
            itemContainer.appendChild(msg);
        }
    });
}

function hideIrrelevantConsequencesForCurrentStep() {
    if (!Array.isArray(projectData.unintendedConsequences)) return;
    const formName = window.location.pathname.split('/')[3];

    projectData.unintendedConsequences.forEach((uc, index) => {
        if (uc.outcome === "Positive") {
            const field = document.querySelector(`[name="unintendedConsequences[${index}].consequence"]`);
            if (field) {
                const container = field.closest('li[data-idx]') || field.closest('li');
                if (container) {
                    container.style.display = 'none';
                }
            }
        }
    });

    if (formName === 'actionCompletion') {
        applyActionCompletionUI();
    }
}



</script>