                render: function(data, type, row) {
                    if (data == "done") {
                        return '<span class="eval-status-label">Complete</span>';
                    }
                    if (data == "inProgress") {
                        return '<span class="eval-status-label">In progress</span>';
                    }
                    if (data == "todo") {
                        return '<span class="eval-status-label">To do</span>';
                    }
                    return '<span class="eval-status-label">Unknown</span>';
                }
