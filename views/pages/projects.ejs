<!-- views/sources.ejs -->
<script src="/lib/chart.js"></script>
<script src="/js/dashboard.js"></script>
<link href="/lib/DataTables/datatables.min.css" rel="stylesheet">
<script src="/lib/DataTables/datatables.min.js"></script>

<!-- Share Overlay (Drive-style: org access first, then people, then add row) -->
<div id="shareOverlay" class="overlay"<% if (typeof hasOrganisationMembership !== 'undefined' && hasOrganisationMembership) { %> data-has-org="1"<% } %>>
    <div class="overlay-content share-overlay-panel">
        <span class="close-btn" onclick="closeShareOverlay()" aria-label="Close">&times;</span>
        <h2 class="share-overlay-title">Share evaluation</h2>
        <p class="share-overlay-lead small">Invite people by email or share with your whole organisation. Everyone with access can edit this evaluation.</p>
        <div id="shareOverlayMessage" class="alert share-overlay-message" style="display:none;" role="status"></div>
        <table class="share-access-table">
            <thead>
                <tr>
                    <th scope="col">Who has access</th>
                    <th scope="col" class="share-access-col-action" aria-label="Actions"></th>
                </tr>
            </thead>
            <% if (typeof hasOrganisationMembership !== 'undefined' && hasOrganisationMembership) { %>
            <tbody id="shareAccessOrgTbody">
                <tr class="share-access-row share-access-row--org">
                    <td>
                        <div class="share-access-who">
                            <span class="share-access-avatar share-access-avatar--org" aria-hidden="true">Org</span>
                            <div>
                                <div class="share-access-primary">Everyone in your organisation</div>
                                <p id="shareOrgOrganisationName" class="share-access-hint small share-access-org-name">&nbsp;</p>
                            </div>
                        </div>
                    </td>
                    <td class="share-access-col-action share-access-col-action--toggle">
                        <label class="share-access-toggle" for="orgShareCheckbox">
                            <input type="checkbox" id="orgShareCheckbox" class="visually-hidden" aria-describedby="orgShareHint"/>
                            <span class="share-access-toggle-ui" aria-hidden="true"></span>
                            <span class="share-access-toggle-text" id="orgShareToggleText">Off</span>
                        </label>
                        <span id="orgShareHint" class="visually-hidden">Toggle sharing with all organisation members</span>
                    </td>
                </tr>
            </tbody>
            <% } %>
            <tbody id="shareAccessPeopleTbody">
                <tr class="share-access-subhead-row" id="shareAccessPeopleSubhead">
                    <td colspan="2">People you’ve shared with</td>
                </tr>
            </tbody>
        </table>
        <div class="share-access-add">
            <input type="email" id="shareInviteEmail" class="input inputText" placeholder="Add people by email…" autocomplete="email" aria-label="Email address to invite"/>
            <button type="button" class="btn btn-primary" id="shareAddPersonBtn">Add</button>
        </div>
    </div>
</div>
<% if (typeof hasOrganisationMembership !== 'undefined' && hasOrganisationMembership) { %>
<div id="transferOwnerOverlay" class="overlay">
    <div class="overlay-content share-overlay-panel">
        <span class="close-btn" onclick="closeTransferOwnerOverlay()" aria-label="Close">&times;</span>
        <h2 class="share-overlay-title">Transfer ownership</h2>
        <p class="share-overlay-lead small">The new owner must be listed on your organisation and must already have a CARE account. Evaluations are always owned by a user account in CARE.</p>
        <div id="transferOwnerMessage" class="alert share-overlay-message" style="display:none;" role="alert"></div>
        <input type="hidden" id="transferProjectId" value=""/>
        <div class="transfer-owner-body">
            <label class="transfer-owner-label" for="transferOwnerSelect">New owner</label>
            <select id="transferOwnerSelect" class="input inputText transfer-owner-select" aria-describedby="transferOwnerHelp"></select>
            <p id="transferOwnerHelp" class="small transfer-owner-hint">Members without a CARE account cannot be selected until they have signed in at least once.</p>
        </div>
        <div class="transfer-owner-actions">
            <button type="button" class="btn btn-primary" id="transferOwnerSubmit">Transfer ownership</button>
            <button type="button" class="transparent transfer-owner-cancel" onclick="closeTransferOwnerOverlay()">Cancel</button>
        </div>
    </div>
</div>
<dialog id="orgIntegrationIdDialog" class="org-access-edit-dialog org-integration-id-dialog">
    <div class="content-block white">
        <h2 id="orgIntegrationIdDialogTitle" style="margin-top:0;">Your project ID</h2>
        <p class="small" id="orgIntegrationIdDialogEvalTitle" style="display:none;margin-top:0;"></p>
        <p class="small org-integration-id-dialog__lead">
            Use this field to store your organisation’s own reference for this evaluation—for example the ID from Jira, Asana, Notion, or an internal project register. It is returned by the tenant integrations API as <code>integrationExternalId</code> so Zapier, Make, n8n, or custom scripts can match CARE to your other systems. It does not replace the CARE project ID shown under the evaluation title.
        </p>
        <div id="orgIntegrationIdModalMsg" class="alert" style="display:none;" role="alert"></div>
        <input type="hidden" id="orgIntegrationIdProjectId" value=""/>
        <div class="sub-form__row">
            <label class="sub-form__label" for="orgIntegrationIdInput">Reference</label>
            <div class="sub-form__control">
                <input type="text" id="orgIntegrationIdInput" class="input inputText" maxlength="256" autocomplete="off" placeholder="e.g. PROJ-4421 or internal code"/>
            </div>
        </div>
        <div class="sub-form__actions org-integration-id-dialog__actions">
            <button type="button" class="btn btn-primary" id="orgIntegrationIdSave">Save</button>
            <button type="button" class="transparent" id="orgIntegrationIdClear" style="display:none;">Remove reference</button>
            <button type="button" class="transparent" id="orgIntegrationIdCancel">Cancel</button>
        </div>
    </div>
</dialog>
<% } %>
<div class="main-content">
    <section class="page-title container white">
        <h1 style="text-align: center;"><%= page.title %></h1>
        <input type="hidden" value="<%= page.link %>" id="pageId"/>
    </section>

<div class="content-block white">
    <div style="text-align: center; width: 100%;">
        <button class="transparent" onclick="window.location.href='/new'">Start a new evaluation</button>
        <button class="transparent" onclick="window.location.href='/examples'">Select from example case studies</button>
    </div>
</div>
<div class="content-block white">
    <h2>My evaluations</h2>
    <div id="res" class="alert"></div>
    <section class="dashboard">
        <subsection class="dashboard-box">
            <div class="dashboard-header">
                <h2>Risks</h2>
            </div>
            <div class="dashboard-chart">
                <canvas id="riskChart" width="200" height="100"></canvas> <!-- Add canvas for the donut chart -->
            </div>
        </subsection>
        <subsection class="dashboard-box">
            <div class="dashboard-header">
                <h2>Stats <span class="small">(average)</span></h2>
            </div>
            <div class="dashboard-chart">
                <h3>Likelihood</h3>
                <div class="progress-bar">
                    <div id="likelihood-bar" class="bar"></div>
                </div>
                <h3>Impact</h3>
                <div class="progress-bar">
                    <div id="impact-bar" class="bar"></div>
                </div>
                <h3>Risk</h3>
                <div class="progress-bar">
                    <div id="risk-bar" class="bar"></div>
                </div>
            </div>
        </subsection>
        <subsection class="dashboard-box top-risks">
            <div class="dashboard-header">
                <h2>Priority <span class="small">(top 5)</span></h2>
            </div>
            <div class="dashboard-chart">
                <table id="topRisksTable">
                    <thead>
                        <tr>
                            <th>Risk</th>
                            <th style="width: 60px;">Level</th>
                            <th style="width: 50px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="topRisksTableBody">
                        <!-- Table rows will be dynamically added here -->
                    </tbody>
                </table>
            </div>
        </subsection>
    </section>
    <table id="myProjectsTable" class="display" style="width:100%"></table>
</div>
<% if (typeof hasOrganisationMembership !== 'undefined' && hasOrganisationMembership) { %>
<div class="content-block light-blue">
    <h2>Organisation evaluations</h2>
    <p class="small">The dashboard below includes every evaluation shared with your organisation, including ones you own. The table can list the same evaluations as <strong>My evaluations</strong>; use the checkbox to show or hide yours in this table.</p>
    <section class="dashboard">
        <subsection class="dashboard-box">
            <div class="dashboard-header">
                <h2>Risks</h2>
            </div>
            <div class="dashboard-chart">
                <canvas id="orgRiskChart" width="200" height="100"></canvas>
            </div>
        </subsection>
        <subsection class="dashboard-box">
            <div class="dashboard-header">
                <h2>Stats <span class="small">(average)</span></h2>
            </div>
            <div class="dashboard-chart">
                <h3>Likelihood</h3>
                <div class="progress-bar">
                    <div id="org-likelihood-bar" class="bar"></div>
                </div>
                <h3>Impact</h3>
                <div class="progress-bar">
                    <div id="org-impact-bar" class="bar"></div>
                </div>
                <h3>Risk</h3>
                <div class="progress-bar">
                    <div id="org-risk-bar" class="bar"></div>
                </div>
            </div>
        </subsection>
        <subsection class="dashboard-box top-risks">
            <div class="dashboard-header">
                <h2>Priority <span class="small">(top 5)</span></h2>
            </div>
            <div class="dashboard-chart">
                <table id="orgTopRisksTable">
                    <thead>
                        <tr>
                            <th>Risk</th>
                            <th style="width: 60px;">Level</th>
                            <th style="width: 50px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="org-topRisksTableBody">
                    </tbody>
                </table>
            </div>
        </subsection>
    </section>
    <div class="org-eval-table-controls" style="margin: 1rem 0;">
        <label class="org-eval-include-mine-label">
            <input type="checkbox" id="includeMyOrgSharedEvaluations" value="1"/>
            Show evaluations I own (also listed under My evaluations)
        </label>
    </div>
    <table id="organisationProjectsTable" class="display" style="width:100%"></table>
</div>
<% } %>
<div class="content-block <%= (typeof hasOrganisationMembership !== 'undefined' && hasOrganisationMembership) ? 'white' : 'light-blue' %>">
    <h2>Evaluations shared with me</h2>
    <table id="sharedProjectsTable" class="display" style="width:100%"></table>
</div>
</div>

<script>

var organisationMetaGlobal = {};
/** Full organisation payload from last GET /projects (for table filter toggle). */
var organisationProjectsCachedPayload = null;

function escapeHtml(s) {
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}

function truncateIntegrationIdDisplay(str, maxLen) {
    var t = String(str || '');
    var n = maxLen != null ? maxLen : 48;
    if (t.length <= n) return t;
    return t.slice(0, n) + '…';
}

function organisationProjectsRows(payload) {
    if (!payload) return [];
    if (Array.isArray(payload)) return payload;
    return payload.projects || [];
}

function organisationTableRowsForDisplay(allRows, includeMine) {
    if (includeMine) return allRows.slice();
    return allRows.filter(function (r) {
        return !r.ownedByCurrentUser;
    });
}

function refreshOrganisationDashboard(orgPayload) {
    if (!document.getElementById('orgRiskChart')) return;
    var p = orgPayload || {};
    var counts = p.riskCounts || { unclassified: 0, high: 0, medium: 0, low: 0 };
    var averages = p.averages || { likelihood: '0.00', impact: '0.00', riskScore: '0.00' };
    var topRisks = p.topRisks || [];
    addRiskDonut(counts, { chartId: 'orgRiskChart' });
    addAverages(averages, {
        likelihoodBarId: 'org-likelihood-bar',
        impactBarId: 'org-impact-bar',
        riskBarId: 'org-risk-bar'
    });
    addTopRisks(topRisks, { tableBodyId: 'org-topRisksTableBody' });
}

/** Open completed output vs project details for in-progress / todo. */
function evalProjectAssessmentHref(row) {
    var id = String(row.id != null ? row.id : '');
    if (!id) return '#';
    if (row.status === 'done') {
        return '/project/' + id + '/';
    }
    return '/project/' + id + '/projectDetails';
}

function renderEvalTitleCell(data, type, row) {
    if (type === 'sort' || type === 'filter' || type === 'type') {
        return data == null ? '' : String(data);
    }
    var label = data == null || String(data).trim() === '' ? 'Untitled evaluation' : String(data);
    var href = evalProjectAssessmentHref(row);
    var pid = String(row.id != null ? row.id : '');
    var copySvg =
        '<svg class="eval-copy-project-id__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    var idRow = '';
    if (pid) {
        idRow =
            '<div class="eval-project-id-row">' +
            '<span class="eval-project-id-label">Project ID</span> ' +
            '<code class="eval-project-id-code">' +
            escapeHtml(pid) +
            '</code> ' +
            '<button type="button" class="transparent eval-copy-project-id" data-id="' +
            escapeHtml(pid) +
            '" title="Copy project ID" aria-label="Copy project ID">' +
            copySvg +
            '</button></div>';
    }
    return (
        '<div class="eval-title-stack">' +
        '<a class="eval-title-link" href="' +
        href +
        '">' +
        escapeHtml(label) +
        '</a>' +
        idRow +
        '</div>'
    );
}

function shareOverlayProjectId() {
    return $('#shareOverlay').attr('data-projectid');
}

function showShareOverlayMessage(text, isError) {
    var el = document.getElementById('shareOverlayMessage');
    if (!el) return;
    el.style.display = 'block';
    el.textContent = text;
    el.style.color = isError ? '#b00020' : '';
}

function clearShareOverlayMessage() {
    var el = document.getElementById('shareOverlayMessage');
    if (!el) return;
    el.style.display = 'none';
    el.textContent = '';
}

function updateOrgShareToggleLabel() {
    var cb = document.getElementById('orgShareCheckbox');
    var label = document.getElementById('orgShareToggleText');
    if (!cb || !label) return;
    label.textContent = cb.checked ? 'On' : 'Off';
}

function getSharedUsers(projectId) {
    return fetch('/project/' + projectId + '/sharedUsers', { headers: { Accept: 'application/json' } })
        .then(function (response) {
            return response.json();
        })
        .catch(function (error) {
            console.error('Error fetching shared users:', error);
        });
}

function renderSharedUsers(sharedUsers) {
    var $tb = $('#shareAccessPeopleTbody');
    if (!$tb.length) return;
    $tb.find('.share-access-person-row, .share-access-empty-row').remove();
    var list = sharedUsers && sharedUsers.sharedUsers ? sharedUsers.sharedUsers : [];
    if (list.length === 0) {
        $tb.append(
            $(
                '<tr class="share-access-empty-row"><td colspan="2"><span class="small share-access-muted">No individual invites yet. Add an email below.</span></td></tr>'
            )
        );
        return;
    }
    list.forEach(function (email) {
        var initials = String(email)
            .trim()
            .charAt(0)
            .toUpperCase();
        if (!initials) initials = '?';
        var $tr = $('<tr class="share-access-person-row"></tr>');
        var $whoTd = $('<td></td>');
        var $who = $('<div class="share-access-who"></div>');
        $who.append(
            $('<span class="share-access-avatar" aria-hidden="true"></span>').text(initials)
        );
        var $inner = $('<div></div>');
        $inner.append($('<div class="share-access-primary"></div>').text(email));
        $who.append($inner);
        $whoTd.append($who);
        var $btn = $('<button type="button" class="btn btn-primary share-access-remove"></button>')
            .text('Remove')
            .data('email', email);
        var $actTd = $('<td class="share-access-col-action"></td>').append($btn);
        $tr.append($whoTd, $actTd);
        $tb.append($tr);
    });
}

$(document).ready(function () {
    $(document).on('click', '.eval-copy-project-id', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var id = String($(this).data('id') || '');
        if (!id || !navigator.clipboard || !navigator.clipboard.writeText) return;
        var btn = this;
        navigator.clipboard.writeText(id).then(function () {
            var t = btn.getAttribute('title');
            btn.setAttribute('title', 'Copied');
            setTimeout(function () {
                btn.setAttribute('title', t || 'Copy project ID');
            }, 2000);
        });
    });

    function patchOrganisationProjectIntegrationId(projectId, value) {
        return fetch('/project/' + encodeURIComponent(projectId) + '/integration-external-id', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ integrationExternalId: value })
        }).then(function (res) {
            return res.json().then(function (d) {
                if (!res.ok) throw new Error(d.message || res.statusText);
                return d;
            });
        }).then(function (d) {
            var committed = d.integrationExternalId != null ? String(d.integrationExternalId) : '';
            var list =
                organisationProjectsCachedPayload && organisationProjectsCachedPayload.projects;
            if (Array.isArray(list)) {
                list.forEach(function (p) {
                    if (String(p.id) === String(projectId)) {
                        p.integrationExternalId = committed;
                    }
                });
            }
            if (typeof renderOrganisationProjects === 'function') {
                renderOrganisationProjects(
                    organisationProjectsCachedPayload,
                    organisationMetaGlobal
                );
            }
            return committed;
        });
    }

    function showOrgIntegrationIdModalMsg(text, isErr) {
        var el = document.getElementById('orgIntegrationIdModalMsg');
        if (!el) return;
        el.style.display = text ? 'block' : 'none';
        el.textContent = text || '';
        el.style.color = isErr ? '#c00' : '';
    }

    function openOrgIntegrationIdDialog(projectId, evalTitle, currentValue) {
        var dlg = document.getElementById('orgIntegrationIdDialog');
        if (!dlg) return;
        var pidEl = document.getElementById('orgIntegrationIdProjectId');
        var inp = document.getElementById('orgIntegrationIdInput');
        var titleEl = document.getElementById('orgIntegrationIdDialogTitle');
        var evalEl = document.getElementById('orgIntegrationIdDialogEvalTitle');
        var clearBtn = document.getElementById('orgIntegrationIdClear');
        if (pidEl) pidEl.value = projectId || '';
        if (inp) {
            inp.value = currentValue != null ? String(currentValue) : '';
        }
        var hasVal = !!(currentValue != null && String(currentValue).trim() !== '');
        if (titleEl) {
            titleEl.textContent = hasVal ? 'Edit your project ID' : 'Add your project ID';
        }
        if (evalEl) {
            var t = evalTitle != null ? String(evalTitle).trim() : '';
            if (t) {
                evalEl.style.display = 'block';
                evalEl.textContent = 'Evaluation: ' + t;
            } else {
                evalEl.style.display = 'none';
                evalEl.textContent = '';
            }
        }
        if (clearBtn) clearBtn.style.display = hasVal ? '' : 'none';
        showOrgIntegrationIdModalMsg('', false);
        if (typeof dlg.showModal === 'function') dlg.showModal();
        if (inp) {
            inp.focus();
            inp.select();
        }
    }

    function closeOrgIntegrationIdDialog() {
        var dlg = document.getElementById('orgIntegrationIdDialog');
        if (dlg && typeof dlg.close === 'function') dlg.close();
    }

    $(document).on('click', '.org-eval-integration-add', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var $t = $(this);
        openOrgIntegrationIdDialog(
            String($t.attr('data-project-id') || ''),
            $t.attr('data-eval-title'),
            ''
        );
    });

    $(document).on('click', '.org-eval-integration-edit', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var $t = $(this);
        openOrgIntegrationIdDialog(
            String($t.attr('data-project-id') || ''),
            $t.attr('data-eval-title'),
            $t.attr('data-committed') || ''
        );
    });

    (function bindOrgIntegrationIdDialog() {
        var dlg = document.getElementById('orgIntegrationIdDialog');
        if (!dlg) return;
        dlg.addEventListener('click', function (ev) {
            if (ev.target === dlg) closeOrgIntegrationIdDialog();
        });
        var cancel = document.getElementById('orgIntegrationIdCancel');
        if (cancel) cancel.addEventListener('click', closeOrgIntegrationIdDialog);
        var clearBtn = document.getElementById('orgIntegrationIdClear');
        if (clearBtn) {
            clearBtn.addEventListener('click', function () {
                var pidEl = document.getElementById('orgIntegrationIdProjectId');
                var pid = pidEl ? pidEl.value.trim() : '';
                if (!pid) return;
                if (
                    !confirm(
                        'Remove this project reference? It will no longer appear in the integrations API for this evaluation.'
                    )
                ) {
                    return;
                }
                showOrgIntegrationIdModalMsg('', false);
                clearBtn.disabled = true;
                patchOrganisationProjectIntegrationId(pid, '')
                    .then(function () {
                        closeOrgIntegrationIdDialog();
                    })
                    .catch(function (err) {
                        showOrgIntegrationIdModalMsg(err.message || String(err), true);
                    })
                    .then(function () {
                        clearBtn.disabled = false;
                    });
            });
        }
        var save = document.getElementById('orgIntegrationIdSave');
        if (save) {
            save.addEventListener('click', function () {
                var pidEl = document.getElementById('orgIntegrationIdProjectId');
                var inp = document.getElementById('orgIntegrationIdInput');
                var pid = pidEl ? pidEl.value.trim() : '';
                if (!pid) return;
                var v = inp ? inp.value.trim() : '';
                showOrgIntegrationIdModalMsg('', false);
                save.disabled = true;
                patchOrganisationProjectIntegrationId(pid, v)
                    .then(function () {
                        closeOrgIntegrationIdDialog();
                    })
                    .catch(function (err) {
                        showOrgIntegrationIdModalMsg(err.message || String(err), true);
                    })
                    .then(function () {
                        save.disabled = false;
                    });
            });
        }
        var inpEl = document.getElementById('orgIntegrationIdInput');
        if (inpEl) {
            inpEl.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    document.getElementById('orgIntegrationIdSave').click();
                }
            });
        }
    })();

    // Fetch projects data from server
    fetch('/projects', {
        headers: {
            'Accept': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        organisationMetaGlobal = data.organisationMeta || {};
        var orgNameEl = document.getElementById('shareOrgOrganisationName');
        if (orgNameEl) {
            orgNameEl.textContent =
                organisationMetaGlobal.organisationName ||
                'Your organisation';
        }
        renderMyProjects(data.ownedProjects.projects);
        renderSharedProjects(data.sharedProjects);
        organisationProjectsCachedPayload = data.organisationProjects || {};
        if (typeof renderOrganisationProjects === 'function') {
            renderOrganisationProjects(organisationProjectsCachedPayload, organisationMetaGlobal);
        }
        refreshOrganisationDashboard(data.organisationProjects);
        addRiskDonut(data.ownedProjects.riskCounts);
        addAverages(data.ownedProjects.averages);
        addTopRisks(data.ownedProjects.topRisks);
    });
});

function renderMyProjects(data) {
    const myProjectsTable = $('#myProjectsTable').DataTable({
        ajax: {
            url: '/projects',
            dataSrc: 'ownedProjects.projects',
            headers: {
                Accept: 'application/json' // Set the Accept header to indicate JSON format
            }
        },
        columns: [
            {
                data: 'title',
                title: 'Title',
                defaultContent: '',
                className: 'eval-title-col',
                render: function (data, type, row) {
                    return renderEvalTitleCell(data, type, row);
                }
            },
            {
                data: 'riskCounts',
                title: 'Risk counts',
                width: '11rem',
                className: 'eval-risk-col',
                render: function(data, type, row) {
                    return "High: " + data["high"] + "<br/>" + "Medium: " + data["medium"] + "<br/>" + "Low: " + data["low"] + "<br/>" + "Unclassified: " + data["unclassified"] + "<br/>"
                }
            },
            {
                data: 'lastModified',
                title: 'Last modified',
                width: '9.5rem',
                className: 'eval-modified-col',
                render: function(data, type, row) {
                    // Parse the date string into a Date object
                    var date = new Date(data);
                    // Format the date nicely (e.g., "April 18, 2024 14:36:41")
                    return date.toLocaleString();
                }
            },
            {
                data: 'status',
                title: 'Status',
                width: '6.5rem',
                className: 'eval-status-col',
                render: function(data, type, row) {
                    if (data == "done") {
                        return '<span class="eval-status-label">Complete</span>';
                    }
                    if (data == "inProgress") {
                        return '<span class="eval-status-label">In progress</span>';
                    }
                    if (data == "todo") {
                        return '<span class="eval-status-label">To do</span>';
                    }
                    return '<span class="eval-status-label">Unknown</span>';
                }
            },
            {
                data: null,
                title: 'Sharing',
                orderable: false,
                searchable: false,
                width: '6.75rem',
                className: 'eval-shares-col',
                render: function (data, type, row) {
                    if (type === 'sort' || type === 'filter' || type === 'type') {
                        return '';
                    }
                    var pid = String(row.id != null ? row.id : '');
                    var n = parseInt(row.sharedWithCount, 10) || 0;
                    var hasPeople = n > 0;
                    var hasOrg = !!row.sharedWithOrganisation;
                    var hasAny = hasOrg || hasPeople;
                    var buildingSvg =
                        '<svg class="eval-share-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12h12"/><path d="M6 16h12"/><path d="M10 6h4"/><path d="M10 22v-4h4v4"/></svg>';
                    var personSvg =
                        '<svg class="eval-share-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';
                    if (!hasAny) {
                        return (
                            '<button type="button" class="btn btn-primary eval-share-open" data-id="' +
                            pid +
                            '">Share</button>'
                        );
                    }
                    var parts = [];
                    if (hasOrg) {
                        parts.push(
                            '<span class="eval-share-stack">' +
                                '<span class="eval-share-icon-wrap">' +
                                buildingSvg +
                                '</span>' +
                                '<span class="eval-share-below" aria-hidden="true">&#10003;</span>' +
                                '</span>'
                        );
                    }
                    if (hasPeople) {
                        parts.push(
                            '<span class="eval-share-stack">' +
                                '<span class="eval-share-icon-wrap">' +
                                personSvg +
                                '</span>' +
                                '<span class="eval-share-below" aria-hidden="true">' +
                                n +
                                '</span>' +
                                '</span>'
                        );
                    }
                    return (
                        '<button type="button" class="eval-share-open eval-share-open--icons" data-id="' +
                        pid +
                        '" title="Edit sharing" aria-label="Edit sharing">' +
                        '<span class="eval-share-icons">' +
                        parts.join('') +
                        '</span></button>'
                    );
                }
            },
            {
                title: 'Actions',
                width: '10rem',
                className: 'eval-actions-col',
                orderable: false,
                searchable: false,
                render: function (data, type, row) {
                    return '<button type="button" class="deleteBtn" data-id="' + row.id + '">Delete</button>';
                }
            }
        ],
        order: [[0, 'asc']], // Title
        dom: 'Bfrtip', // Show buttons for export
        buttons: [
            //'copy', 'csv', 'excel', 'pdf', 'print'
        ]
    });

    $('#myProjectsTable').on('click', '.deleteBtn', function () {
        var id = $(this).data('id');
        if (confirm('Are you sure you want to delete this project?')) {
            $('#res').html('<p>Deleting, please wait.</p>');
            $.ajax({
                url: '/project/' + id,
                type: 'DELETE',
                success: function (result) {
                    $('#res').html('<p>Project deleted successfully.</p>');
                    myProjectsTable.ajax.reload();
                    // Clear message after 5 seconds
                    setTimeout(function () {
                        $('#res').html('');
                    }, 5000);
                },
                error: function (xhr, status, error) {
                    // Show error message
                    $('#res').html('<p>Error deleting project: ' + error + '</p>');
                    // Clear message after 5 seconds
                    setTimeout(function () {
                        $('#res').html('');
                    }, 5000);
                }
            });
        }
    });
    $('#myProjectsTable').on('click', '.eval-share-open', function () {
        var id = $(this).data('id');
        openShareOverlay();
        $('#shareOverlay').attr('data-projectid', id);
        $('#shareInviteEmail').val('');
        clearShareOverlayMessage();

        getSharedUsers(id).then(function (sharedUsers) {
            renderSharedUsers(sharedUsers);
        });
        var cb = document.getElementById('orgShareCheckbox');
        if (cb) {
            fetch('/project/' + id, { headers: { Accept: 'application/json' } })
                .then(function (r) {
                    return r.json();
                })
                .then(function (proj) {
                    cb.checked = !!(proj && proj.sharedWithOrganisation);
                    updateOrgShareToggleLabel();
                })
                .catch(function () {
                    cb.checked = false;
                    updateOrgShareToggleLabel();
                });
        }
    });

    $('#shareAddPersonBtn').on('click', function () {
        var email = ($('#shareInviteEmail').val() || '').trim();
        var projectId = shareOverlayProjectId();
        clearShareOverlayMessage();
        if (!projectId) return;
        if (!email) {
            showShareOverlayMessage('Enter an email address.', true);
            return;
        }
        fetch('/project/' + projectId + '/sharedUsers', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ email })
        })
            .then(function (response) {
                if (response.ok) return response.json();
                return response.json().then(function (d) {
                    throw new Error(d.message || 'Could not add this person');
                });
            })
            .then(function () {
                $('#shareInviteEmail').val('');
                return getSharedUsers(projectId);
            })
            .then(function (sharedUsers) {
                renderSharedUsers(sharedUsers);
                if ($.fn.DataTable.isDataTable('#myProjectsTable')) {
                    $('#myProjectsTable').DataTable().ajax.reload(null, false);
                }
            })
            .catch(function (e) {
                showShareOverlayMessage(e.message || String(e), true);
            });
    });

    $('#shareOverlay').on('click', '.share-access-remove', function () {
        var email = $(this).data('email');
        var projectId = shareOverlayProjectId();
        clearShareOverlayMessage();
        if (!projectId || !email) return;
        fetch('/project/' + projectId + '/sharedUsers/' + encodeURIComponent(email), { method: 'DELETE' })
            .then(function (response) {
                if (response.ok) return response.json();
                return response.json().then(function (d) {
                    throw new Error(d.message || 'Could not remove access');
                });
            })
            .then(function () {
                return getSharedUsers(projectId);
            })
            .then(function (sharedUsers) {
                renderSharedUsers(sharedUsers);
                if ($.fn.DataTable.isDataTable('#myProjectsTable')) {
                    $('#myProjectsTable').DataTable().ajax.reload(null, false);
                }
            })
            .catch(function (e) {
                showShareOverlayMessage(e.message || String(e), true);
            });
    });

    $('#shareInviteEmail').on('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            $('#shareAddPersonBtn').trigger('click');
        }
    });
}

function renderOrganisationProjects(payload, organisationMeta) {
    var orgTable = $('#organisationProjectsTable');
    if (!orgTable.length) return;
    var allRows = organisationProjectsRows(payload);
    var includeMineEl = document.getElementById('includeMyOrgSharedEvaluations');
    var includeMine = includeMineEl ? includeMineEl.checked : false;
    var data = organisationTableRowsForDisplay(allRows, includeMine);
    if ($.fn.DataTable.isDataTable('#organisationProjectsTable')) {
        orgTable.DataTable().destroy();
    }
    var cols = [
        {
            data: 'title',
            title: 'Title',
            defaultContent: '',
            render: function (data, type, row) {
                return renderEvalTitleCell(data, type, row);
            }
        },
        {
            data: 'status',
            title: 'Status',
            width: '12%',
            className: 'eval-status-col',
            render: function(data, type, row) {
                if (data == "done") return '<span class="eval-status-label">Complete</span>';
                if (data == "inProgress") return '<span class="eval-status-label">In progress</span>';
                if (data == "todo") return '<span class="eval-status-label">To do</span>';
                return '<span class="eval-status-label">Unknown</span>';
            }
        },
        { data: 'owner', title: 'Owner', defaultContent: '' ,width: '12%' },
        {
            data: 'integrationExternalId',
            title: 'Your project ID',
            width: '11rem',
            className: 'eval-org-integration-id-col',
            orderable: true,
            defaultContent: '',
            render: function (data, type, row) {
                var v = data == null || data === undefined ? '' : String(data);
                if (type === 'sort' || type === 'filter' || type === 'type') {
                    return v;
                }
                var id = String(row.id != null ? row.id : '');
                var evalTitle = row.title == null ? '' : String(row.title);
                var canEdit =
                    organisationMeta && organisationMeta.canManageOrganisationProjectIntegrations;
                var etAttr = escapeHtml(evalTitle);
                if (canEdit && id) {
                    if (v.trim() !== '') {
                        var shown = escapeHtml(truncateIntegrationIdDisplay(v, 44));
                        return (
                            '<button type="button" class="transparent org-eval-integration-edit" ' +
                            'data-project-id="' +
                            escapeHtml(id) +
                            '" data-eval-title="' +
                            etAttr +
                            '" data-committed="' +
                            escapeHtml(v) +
                            '" title="Edit your project ID" aria-label="Edit your project ID">' +
                            shown +
                            '</button>'
                        );
                    }
                    return (
                        '<button type="button" class="btn btn-primary org-eval-integration-add" ' +
                        'data-project-id="' +
                        escapeHtml(id) +
                        '" data-eval-title="' +
                        etAttr +
                        '" aria-label="Add your project ID">Add</button>'
                    );
                }
                return v.trim() !== ''
                    ? escapeHtml(truncateIntegrationIdDisplay(v, 56))
                    : '<span class="small share-access-muted">—</span>';
            }
        },
        {
            data: 'lastModified',
            title: 'Last modified',
            width: '12%',
            render: function(data, type, row) {
                return new Date(data).toLocaleString();
            }
        }
    ];
    if (organisationMeta && organisationMeta.isAdmin) {
        cols.push({
            title: 'Actions',
            width: '11rem',
            className: 'eval-actions-col',
            render: function (data, type, row) {
                return '<button type="button" class="transferOwnerOpenBtn" data-id="' + row.id + '">Transfer ownership</button>';
            }
        });
    }
    orgTable.DataTable({
        data: data,
        columns: cols,
        order: [[0, 'asc']],
        dom: 'Bfrtip',
        buttons: []
    });
    orgTable.off('click', 'tbody .transferOwnerOpenBtn');
    orgTable.on('click', 'tbody .transferOwnerOpenBtn', function () {
        var pid = $(this).data('id');
        var pidEl = document.getElementById('transferProjectId');
        var overlayEl = document.getElementById('transferOwnerOverlay');
        if (!pidEl || !overlayEl) return;
        pidEl.value = pid;
        var tmsg = document.getElementById('transferOwnerMessage');
        if (tmsg) tmsg.style.display = 'none';
        fetch('/organisation', { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (ctx) {
                var sel = document.getElementById('transferOwnerSelect');
                if (!sel) return;
                sel.innerHTML = '';
                var ph = document.createElement('option');
                ph.value = '';
                ph.textContent = 'Choose new owner…';
                ph.disabled = true;
                ph.selected = true;
                sel.appendChild(ph);
                (ctx.members || []).forEach(function (m) {
                    var opt = document.createElement('option');
                    opt.value = m.email;
                    opt.textContent = (m.name || m.email) + ' <' + m.email + '>' +
                        (m.hasAccount ? '' : ' (needs CARE account to own)');
                    opt.disabled = !m.hasAccount;
                    sel.appendChild(opt);
                });
                overlayEl.style.display = 'block';
            })
            .catch(function (e) { alert(e.message || String(e)); });
    });
}

$(document).on('change', '#includeMyOrgSharedEvaluations', function () {
    if (!organisationProjectsCachedPayload) return;
    renderOrganisationProjects(organisationProjectsCachedPayload, organisationMetaGlobal);
});

$(document).on('click', '#transferOwnerSubmit', function () {
    var pidEl = document.getElementById('transferProjectId');
    if (!pidEl) return;
    var pid = pidEl.value;
    var sel = document.getElementById('transferOwnerSelect');
    var email = sel ? sel.value : '';
    var msg = document.getElementById('transferOwnerMessage');
    if (msg) msg.style.display = 'none';
    if (!email) {
        if (msg) {
            msg.style.display = 'block';
            msg.textContent = 'Choose a member who already has a CARE account.';
            msg.style.color = '#c00';
        }
        return;
    }
    fetch('/project/' + pid + '/owner', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ ownerEmail: email })
    }).then(function (res) {
        return res.json().then(function (d) {
            if (!res.ok) throw new Error(d.message || 'Transfer failed');
            closeTransferOwnerOverlay();
            return fetch('/projects', { headers: { 'Accept': 'application/json' } });
        });
    }).then(function (r) {
        if (!r || !r.ok) return;
        return r.json();
    }).then(function (data) {
        if (!data) return;
        if ($.fn.DataTable.isDataTable('#organisationProjectsTable')) {
            $('#organisationProjectsTable').DataTable().destroy();
        }
        organisationProjectsCachedPayload = data.organisationProjects || {};
        refreshOrganisationDashboard(data.organisationProjects);
        renderOrganisationProjects(organisationProjectsCachedPayload, data.organisationMeta || {});
        if ($.fn.DataTable.isDataTable('#myProjectsTable')) {
            $('#myProjectsTable').DataTable().ajax.reload(null, false);
        }
    }).catch(function (e) {
        if (msg) {
            msg.style.display = 'block';
            msg.textContent = e.message;
            msg.style.color = '#c00';
        } else {
            alert(e.message || String(e));
        }
    });
});

