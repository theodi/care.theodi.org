function updateDashboardFilterHeaderStates() {
    var defaultScopes = ['Mine', 'Organisation', 'Shared with me'];
    var scopeIsDefault =
        selectedScopeFilters.size === defaultScopes.length &&
        defaultScopes.every(function (s) { return selectedScopeFilters.has(s); });
    setResetButtonState('clearScopeFilters', !scopeIsDefault);
    setResetButtonState('clearMatrixFilters', selectedMatrixCells.size > 0);
    setResetButtonState('clearRiskBandFilters', selectedRiskBands.size > 0);
    setResetButtonState('clearOwnerFilters', selectedOwnerStates.size > 0);
    setResetButtonState('clearTargetDateFilters', selectedTargetDateStates.size > 0);
    setResetButtonState('clearOverdueFilters', selectedOverdueStates.size > 0);
