<!-- views/sources.ejs -->
<script src="/lib/chart.js"></script>
<script src="/js/dashboard.js"></script>
<link href="/lib/DataTables/datatables.min.css" rel="stylesheet">
<script src="/lib/DataTables/datatables.min.js"></script>

<!-- Share Overlay (Drive-style: org access first, then people, then add row) -->
<div id="shareOverlay" class="overlay"<% if (typeof hasOrganisationMembership !== 'undefined' && hasOrganisationMembership) { %> data-has-org="1"<% } %>>
    <div class="overlay-content share-overlay-panel">
        <span class="close-btn" onclick="closeShareOverlay()" aria-label="Close">&times;</span>
        <h2 class="share-overlay-title">Share evaluation</h2>
        <p class="share-overlay-lead small">Invite people by email or share with your whole organisation. Everyone with access can edit this evaluation.</p>
        <div id="shareOverlayMessage" class="alert share-overlay-message" style="display:none;" role="status"></div>
        <table class="share-access-table">
            <thead>
                <tr>
                    <th scope="col">Who has access</th>
                    <th scope="col" class="share-access-col-action" aria-label="Actions"></th>
                </tr>
            </thead>
            <% if (typeof hasOrganisationMembership !== 'undefined' && hasOrganisationMembership) { %>
            <tbody id="shareAccessOrgTbody">
                <tr class="share-access-row share-access-row--org">
                    <td>
                        <div class="share-access-who">
                            <span class="share-access-avatar share-access-avatar--org" aria-hidden="true">Org</span>
                            <div>
                                <div class="share-access-primary">Everyone in your organisation</div>
                                <p id="shareOrgOrganisationName" class="share-access-hint small share-access-org-name">&nbsp;</p>
                            </div>
                        </div>
                    </td>
                    <td class="share-access-col-action share-access-col-action--toggle">
                        <label class="share-access-toggle" for="orgShareCheckbox">
                            <input type="checkbox" id="orgShareCheckbox" class="visually-hidden" aria-describedby="orgShareHint"/>
                            <span class="share-access-toggle-ui" aria-hidden="true"></span>
                            <span class="share-access-toggle-text" id="orgShareToggleText">Off</span>
                        </label>
                        <span id="orgShareHint" class="visually-hidden">Toggle sharing with all organisation members</span>
                    </td>
                </tr>
            </tbody>
            <% } %>
            <tbody id="shareAccessPeopleTbody">
                <tr class="share-access-subhead-row" id="shareAccessPeopleSubhead">
                    <td colspan="2">People you’ve shared with</td>
                </tr>
            </tbody>
        </table>
        <div class="share-access-add">
            <input type="email" id="shareInviteEmail" class="input inputText" placeholder="Add people by email…" autocomplete="email" aria-label="Email address to invite"/>
            <button type="button" class="btn btn-primary" id="shareAddPersonBtn">Add</button>
        </div>
    </div>
</div>
<% if (typeof hasOrganisationMembership !== 'undefined' && hasOrganisationMembership) { %>
<div id="transferOwnerOverlay" class="overlay">
    <div class="overlay-content share-overlay-panel">
        <span class="close-btn" onclick="closeTransferOwnerOverlay()" aria-label="Close">&times;</span>
        <h2 class="share-overlay-title">Transfer ownership</h2>
        <p class="share-overlay-lead small">The new owner must be listed on your organisation and must already have a CARE account. Evaluations are always owned by a user account in CARE.</p>
        <div id="transferOwnerMessage" class="alert share-overlay-message" style="display:none;" role="alert"></div>
        <input type="hidden" id="transferProjectId" value=""/>
        <div class="transfer-owner-body">
            <label class="transfer-owner-label" for="transferOwnerSelect">New owner</label>
            <select id="transferOwnerSelect" class="input inputText transfer-owner-select" aria-describedby="transferOwnerHelp"></select>
            <p id="transferOwnerHelp" class="small transfer-owner-hint">Members without a CARE account cannot be selected until they have signed in at least once.</p>
        </div>
        <div class="transfer-owner-actions">
            <button type="button" class="btn btn-primary" id="transferOwnerSubmit">Transfer ownership</button>
            <button type="button" class="transparent transfer-owner-cancel" onclick="closeTransferOwnerOverlay()">Cancel</button>
        </div>
    </div>
</div>
<dialog id="orgIntegrationIdDialog" class="org-access-edit-dialog org-integration-id-dialog">
    <div class="content-block white">
        <h2 id="orgIntegrationIdDialogTitle" style="margin-top:0;">Your project ID</h2>
        <p class="small" id="orgIntegrationIdDialogEvalTitle" style="display:none;margin-top:0;"></p>
        <p class="small org-integration-id-dialog__lead">
            Use this field to store your organisation’s own reference for this evaluation—for example the ID from Jira, Asana, Notion, or an internal project register. It is returned by the tenant integrations API as <code>integrationExternalId</code> so Zapier, Make, n8n, or custom scripts can match CARE to your other systems. It does not replace the CARE project ID shown under the evaluation title.
        </p>
        <div id="orgIntegrationIdModalMsg" class="alert" style="display:none;" role="alert"></div>
        <input type="hidden" id="orgIntegrationIdProjectId" value=""/>
        <div class="sub-form__row">
            <label class="sub-form__label" for="orgIntegrationIdInput">Reference</label>
            <div class="sub-form__control">
                <input type="text" id="orgIntegrationIdInput" class="input inputText" maxlength="256" autocomplete="off" placeholder="e.g. PROJ-4421 or internal code"/>
            </div>
        </div>
        <div class="sub-form__actions org-integration-id-dialog__actions">
            <button type="button" class="btn btn-primary" id="orgIntegrationIdSave">Save</button>
            <button type="button" class="transparent" id="orgIntegrationIdClear" style="display:none;">Remove reference</button>
            <button type="button" class="transparent" id="orgIntegrationIdCancel">Cancel</button>
        </div>
    </div>
</dialog>
<% } %>
<dialog id="dashboardStatsHelpDialog" class="org-access-edit-dialog dashboard-stats-help-dialog" aria-labelledby="dashboardStatsHelpDialogTitle">
    <div class="content-block white">
        <h2 id="dashboardStatsHelpDialogTitle" style="margin-top:0;">How the risk matrix and colours work</h2>
        <p class="small">
            The dashboard only includes <strong>negative</strong> unintended consequences. Positive outcomes are excluded from these calculations.
        </p>
        <h3 style="margin-bottom:0.25rem;">How each risk score is calculated</h3>
        <p class="small" style="margin-top:0;">
            Likelihood and impact are converted to numbers:
            <strong>Low = 1</strong>,
            <strong>Medium = 2</strong>,
            <strong>High = 3</strong>.
            The risk score for a consequence is <strong>likelihood × impact</strong> (range <strong>1 to 9</strong>).
        </p>
        <h3 style="margin-bottom:0.25rem;">How the 3x3 matrix works</h3>
        <p class="small" style="margin-top:0;">
            Each negative risk is placed into one matrix cell using its likelihood and impact (Low, Medium, High).
            Click one or more cells to cross-filter both the assessments table and the all-risks table.
        </p>
        <h3 style="margin-bottom:0.25rem;">How colours are categorised</h3>
        <p class="small" style="margin-top:0;">
            Colours use three bands:
            <strong>Green = Low</strong>,
            <strong>Yellow = Medium</strong>,
            <strong>Red = High</strong>.
            For numeric scores (used internally for sorting), this maps to:
            <strong>Low 1-2</strong>,
            <strong>Medium 3-6</strong>,
            <strong>High 7-9</strong>.
        </p>
        <p class="small" style="margin-top:0;">
            In the risk distribution chart, <strong>Unclassified</strong> means likelihood or impact is missing, so no risk score can be calculated yet.
        </p>
        <div class="sub-form__actions org-integration-id-dialog__actions">
            <button type="button" class="btn btn-primary" id="dashboardStatsHelpClose">Close</button>
        </div>
    </div>
</dialog>
<div class="main-content">
    <section class="page-title container white">
        <h1 style="text-align: center;"><%= page.title %></h1>
        <input type="hidden" value="<%= page.link %>" id="pageId"/>
    </section>

<div class="content-block white">
    <div class="dashboard-global-actions">
        <button type="button" class="transparent" id="clearAllDashboardFilters">Clear all filters</button>
    </div>
    <div id="res" class="alert"></div>
    <p id="activeFilterSummary" class="small" style="display: none;"></p>
    <section class="dashboard">
        <subsection class="dashboard-box dashboard-box--heatmap">
            <div class="dashboard-header">
                <h2 class="dashboard-card-title">
                    <span>Risk heat map <span class="small">(Likelihood × Impact)</span></span>
                    <button type="button" class="transparent filter-reset-btn" id="clearMatrixFilters" hidden>Reset</button>
                </h2>
            </div>
            <div class="dashboard-chart">
                <table id="riskMatrixTable" class="riskHeatmap riskHeatmap--compact">
                    <thead>
                        <tr>
                            <th>Impact \ Likelihood</th>
                            <th>High</th>
                            <th>Medium</th>
                            <th>Low</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </subsection>
        <subsection class="dashboard-box dashboard-box--distribution">
            <div class="dashboard-header">
                <h2 class="dashboard-card-title">
                    <span>
                        Risk distribution
                        <a href="#" class="dashboard-stats-help-open dashboard-stats-help-open--sup" aria-haspopup="dialog" aria-controls="dashboardStatsHelpDialog" aria-label="How risk distribution is calculated" title="How calculated">
                            <sup>?</sup>
                        </a>
                    </span>
                    <button type="button" class="transparent filter-reset-btn" id="clearRiskBandFilters" hidden>Reset</button>
                </h2>
            </div>
            <div class="dashboard-chart">
                <canvas id="riskChart" width="200" height="100"></canvas>
            </div>
        </subsection>
        <subsection class="dashboard-box dashboard-box--total">
            <div class="dashboard-header">
                <h2>Total risks</h2>
            </div>
            <div class="dashboard-chart">
                <div id="totalRisksPanel" class="dashboard-kpi"></div>
            </div>
        </subsection>
        <subsection class="dashboard-box dashboard-box--scope">
            <div class="dashboard-header">
                <h2 class="dashboard-card-title">
                    <span>Scope filters</span>
                    <button type="button" class="transparent filter-reset-btn" id="clearScopeFilters" hidden>Reset</button>
                </h2>
            </div>
            <div class="dashboard-chart">
                <div class="dashboard-filters-row dashboard-filters-row--scope">
                    <label class="scope-filter-option">
                        <input type="checkbox" class="scope-filter" value="Mine" checked/>
                        <svg class="eval-share-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <span>Mine</span>
                    </label>
                    <label class="scope-filter-option">
                        <input type="checkbox" class="scope-filter" value="Organisation" checked/>
                        <svg class="eval-share-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12h12"/><path d="M6 16h12"/><path d="M10 6h4"/><path d="M10 22v-4h4v4"/></svg>
                        <span>Organisation</span>
                    </label>
                    <label class="scope-filter-option">
                        <input type="checkbox" class="scope-filter" value="Shared with me" checked/>
                        <svg class="eval-share-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <span>Shared with me</span>
                    </label>
                </div>
            </div>
        </subsection>
        <subsection class="dashboard-box top-risks dashboard-box--trend">
            <div class="dashboard-header">
                <h2>Trend</h2>
            </div>
            <div class="dashboard-chart">
                <div id="trendPanel" class="small"></div>
            </div>
        </subsection>
        <subsection class="dashboard-box dashboard-box--owner">
            <div class="dashboard-header">
                <h2 class="dashboard-card-title">
                    <span>Owner assignment</span>
                    <button type="button" class="transparent filter-reset-btn" id="clearOwnerFilters" hidden>Reset</button>
                </h2>
            </div>
            <div class="dashboard-chart">
                <canvas id="ownerChart" width="200" height="100"></canvas>
            </div>
        </subsection>
        <subsection class="dashboard-box dashboard-box--target-date">
            <div class="dashboard-header">
                <h2 class="dashboard-card-title">
                    <span>Target date</span>
                    <button type="button" class="transparent filter-reset-btn" id="clearTargetDateFilters" hidden>Reset</button>
                </h2>
            </div>
            <div class="dashboard-chart">
                <canvas id="targetDateChart" width="200" height="100"></canvas>
            </div>
        </subsection>
        <subsection class="dashboard-box dashboard-box--overdue">
            <div class="dashboard-header">
                <h2 class="dashboard-card-title">
                    <span>Overdue status</span>
                    <button type="button" class="transparent filter-reset-btn" id="clearOverdueFilters" hidden>Reset</button>
                </h2>
            </div>
            <div class="dashboard-chart">
                <canvas id="overdueChart" width="200" height="100"></canvas>
            </div>
        </subsection>
    </section>
</div>
<div class="content-block light-blue">
    <h2>All risks</h2>
    <table id="allRisksTable" class="display" style="width:100%"></table>
</div>
<div class="content-block white">
    <h2>Assessments table</h2>
    <table id="assessmentsTable" class="display" style="width:100%"></table>
</div>
</div>

<script>

var organisationMetaGlobal = {};
var unifiedDashboardPayload = null;
var organisationProjectsCachedPayload = null;
var selectedScopeFilters = new Set(['Mine', 'Organisation', 'Shared with me']);
var selectedMatrixCells = new Set();
var selectedRiskBands = new Set();
var selectedOwnerStates = new Set();
var selectedTargetDateStates = new Set();
var selectedOverdueStates = new Set();
var assessmentsTableApi = null;
var allRisksTableApi = null;

function escapeHtml(s) {
    return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}

function truncateIntegrationIdDisplay(str, maxLen) {
    var t = String(str || '');
    var n = maxLen != null ? maxLen : 48;
    if (t.length <= n) return t;
    return t.slice(0, n) + '…';
}

function openDashboardStatsHelpDialog() {
    var dlg = document.getElementById('dashboardStatsHelpDialog');
    if (!dlg) return;
    if (typeof dlg.showModal === 'function') {
        dlg.showModal();
    } else {
        dlg.setAttribute('open', 'open');
    }
}

function closeDashboardStatsHelpDialog() {
    var dlg = document.getElementById('dashboardStatsHelpDialog');
    if (!dlg) return;
    if (typeof dlg.close === 'function') {
        dlg.close();
    } else {
        dlg.removeAttribute('open');
    }
}

function organisationProjectsRows(payload) {
    if (!payload) return [];
    if (Array.isArray(payload)) return payload;
    return payload.projects || [];
}

function organisationTableRowsForDisplay(allRows, includeMine) {
    if (includeMine) return allRows.slice();
    return allRows.filter(function (r) {
        return !r.ownedByCurrentUser;
    });
}

function refreshOrganisationDashboard(orgPayload) {
    if (!document.getElementById('orgRiskChart')) return;
    var p = orgPayload || {};
    var counts = p.riskCounts || { unclassified: 0, high: 0, medium: 0, low: 0 };
    var averages = p.averages || { likelihood: '0.00', impact: '0.00', riskScore: '0.00' };
    var topRisks = p.topRisks || [];
    addRiskDonut(counts, { chartId: 'orgRiskChart' });
    addAverages(averages, {
        likelihoodBarId: 'org-likelihood-bar',
        impactBarId: 'org-impact-bar',
        riskBarId: 'org-risk-bar'
    });
    addTopRisks(topRisks, { tableBodyId: 'org-topRisksTableBody' });
}

/** Open completed output vs project details for in-progress / todo. */
function evalProjectAssessmentHref(row) {
    var id = String(row.id != null ? row.id : '');
    if (!id) return '#';
    if (row.status === 'done') {
        return '/project/' + id + '/';
    }
    return '/project/' + id + '/projectDetails';
}

function renderEvalTitleCell(data, type, row) {
    if (type === 'sort' || type === 'filter' || type === 'type') {
        return data == null ? '' : String(data);
    }
    var label = data == null || String(data).trim() === '' ? 'Untitled evaluation' : String(data);
    var href = evalProjectAssessmentHref(row);
    var pid = String(row.id != null ? row.id : '');
    var copySvg =
        '<svg class="eval-copy-project-id__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    var idRow = '';
    if (pid) {
        idRow =
            '<div class="eval-project-id-row">' +
            '<span class="eval-project-id-label">Project ID</span> ' +
            '<code class="eval-project-id-code">' +
            escapeHtml(pid) +
            '</code> ' +
            '<button type="button" class="transparent eval-copy-project-id" data-id="' +
            escapeHtml(pid) +
            '" title="Copy project ID" aria-label="Copy project ID">' +
            copySvg +
            '</button></div>';
    }
    return (
        '<div class="eval-title-stack">' +
        '<a class="eval-title-link" href="' +
        href +
        '">' +
        escapeHtml(label) +
        '</a>' +
        idRow +
        '</div>'
    );
}

function shareOverlayProjectId() {
    return $('#shareOverlay').attr('data-projectid');
}

function showShareOverlayMessage(text, isError) {
    var el = document.getElementById('shareOverlayMessage');
    if (!el) return;
    el.style.display = 'block';
    el.textContent = text;
    el.style.color = isError ? '#b00020' : '';
}

function clearShareOverlayMessage() {
    var el = document.getElementById('shareOverlayMessage');
    if (!el) return;
    el.style.display = 'none';
    el.textContent = '';
}

function updateOrgShareToggleLabel() {
    var cb = document.getElementById('orgShareCheckbox');
    var label = document.getElementById('orgShareToggleText');
    if (!cb || !label) return;
    label.textContent = cb.checked ? 'On' : 'Off';
}

function getSharedUsers(projectId) {
    return fetch('/project/' + projectId + '/sharedUsers', { headers: { Accept: 'application/json' } })
        .then(function (response) {
            return response.json();
        })
        .catch(function (error) {
            console.error('Error fetching shared users:', error);
        });
}

function renderSharedUsers(sharedUsers) {
    var $tb = $('#shareAccessPeopleTbody');
    if (!$tb.length) return;
    $tb.find('.share-access-person-row, .share-access-empty-row').remove();
    var list = sharedUsers && sharedUsers.sharedUsers ? sharedUsers.sharedUsers : [];
    if (list.length === 0) {
        $tb.append(
            $(
                '<tr class="share-access-empty-row"><td colspan="2"><span class="small share-access-muted">No individual invites yet. Add an email below.</span></td></tr>'
            )
        );
        return;
    }
    list.forEach(function (email) {
        var initials = String(email)
            .trim()
            .charAt(0)
            .toUpperCase();
        if (!initials) initials = '?';
        var $tr = $('<tr class="share-access-person-row"></tr>');
        var $whoTd = $('<td></td>');
        var $who = $('<div class="share-access-who"></div>');
        $who.append(
            $('<span class="share-access-avatar" aria-hidden="true"></span>').text(initials)
        );
        var $inner = $('<div></div>');
        $inner.append($('<div class="share-access-primary"></div>').text(email));
        $who.append($inner);
        $whoTd.append($who);
        var $btn = $('<button type="button" class="btn btn-primary share-access-remove"></button>')
            .text('Remove')
            .data('email', email);
        var $actTd = $('<td class="share-access-col-action"></td>').append($btn);
        $tr.append($whoTd, $actTd);
        $tb.append($tr);
    });
}

function toArrayScopeTags(tags) {
    return Array.isArray(tags) ? tags : [];
}

function normalizeScopeTag(tag) {
    var t = String(tag || '').trim();
    if (t === 'My') return 'Mine';
    return t;
}

function projectMatchesScopeFilters(project) {
    var tags = toArrayScopeTags(project && project.scopeTags).map(normalizeScopeTag);
    if (!selectedScopeFilters.size) return false;
    return tags.some(function (t) {
        return selectedScopeFilters.has(String(t));
    });
}

function riskMatchesScopeFilters(risk) {
    var tags = toArrayScopeTags(risk && risk.scopeTags).map(normalizeScopeTag);
    if (!selectedScopeFilters.size) return false;
    return tags.some(function (t) {
        return selectedScopeFilters.has(String(t));
    });
}

function riskMatchesMatrixFilters(risk) {
    if (!selectedMatrixCells.size) return true;
    var impact = risk && risk.impact ? String(risk.impact) : '';
    var likelihood = risk && risk.likelihood ? String(risk.likelihood) : '';
    if (!impact || !likelihood) return false;
    return selectedMatrixCells.has(impact + '|' + likelihood);
}

function riskMatchesBandFilters(risk) {
    if (!selectedRiskBands.size) return true;
    var band = String((risk && risk.residualBand) || 'Unclassified');
    return selectedRiskBands.has(band);
}

function riskMatchesOwnerFilters(risk) {
    if (!selectedOwnerStates.size) return true;
    var state = risk && risk.actionRole ? 'withOwner' : 'withoutOwner';
    return selectedOwnerStates.has(state);
}

function riskMatchesTargetDateFilters(risk) {
    if (!selectedTargetDateStates.size) return true;
    var state = risk && risk.actionDueDate ? 'withTargetDate' : 'withoutTargetDate';
    return selectedTargetDateStates.has(state);
}

function riskMatchesOverdueFilter(risk) {
    if (!selectedOverdueStates.size) return true;
    var state = risk && risk.actionOverdue ? 'overdue' : 'notOverdue';
    return selectedOverdueStates.has(state);
}

function renderScopeTagPills(tags) {
    var list = toArrayScopeTags(tags).map(normalizeScopeTag);
    if (!list.length) return '<span class="small share-access-muted">—</span>';
    return list
        .map(function (t) {
            return '<span class="scope-pill">' + escapeHtml(String(t)) + '</span>';
        })
        .join(' ');
}

function renderRiskCountsCell(counts) {
    var c = counts || {};
    return (
        'High: ' + Number(c.high || 0) + '<br/>' +
        'Medium: ' + Number(c.medium || 0) + '<br/>' +
        'Low: ' + Number(c.low || 0) + '<br/>' +
        'Unclassified: ' + Number(c.unclassified || 0)
    );
}

function renderBandBadge(band) {
    var b = String(band || 'Unclassified');
    var cls =
        b === 'High' ? 'risk-band-badge risk-band-badge--high'
            : b === 'Medium' ? 'risk-band-badge risk-band-badge--medium'
                : b === 'Low' ? 'risk-band-badge risk-band-badge--low'
                    : 'risk-band-badge risk-band-badge--unclassified';
    return '<span class="' + cls + '">' + escapeHtml(b) + '</span>';
}

function applyRiskFilters(list, options) {
    var opts = options || {};
    return (list || []).filter(function (r) {
        if (!riskMatchesScopeFilters(r)) return false;
        if (!opts.skipMatrix && !riskMatchesMatrixFilters(r)) return false;
        if (!opts.skipBands && !riskMatchesBandFilters(r)) return false;
        if (!opts.skipOwner && !riskMatchesOwnerFilters(r)) return false;
        if (!opts.skipTargetDate && !riskMatchesTargetDateFilters(r)) return false;
        if (!opts.skipOverdue && !riskMatchesOverdueFilter(r)) return false;
        return true;
    });
}

function filteredRisksForScopeSelection() {
    var list = (unifiedDashboardPayload && unifiedDashboardPayload.allRisks) || [];
    return applyRiskFilters(list, {
        skipMatrix: true,
        skipBands: true,
        skipOwner: true,
        skipTargetDate: true,
        skipOverdue: true,
    });
}

function filteredRisksForCurrentSelection() {
    var list = (unifiedDashboardPayload && unifiedDashboardPayload.allRisks) || [];
    return applyRiskFilters(list, {});
}

function filteredAssessmentsForCurrentSelection() {
    var assessments = (unifiedDashboardPayload && unifiedDashboardPayload.assessments) || [];
    var risks = filteredRisksForCurrentSelection();
    var matchingProjectIds = new Set(risks.map(function (r) { return String(r.projectId || ''); }));
    return assessments.filter(function (a) {
        if (!projectMatchesScopeFilters(a)) return false;
        if (!selectedMatrixCells.size) return true;
        return matchingProjectIds.has(String(a.id || ''));
    });
}

function riskCountsFromRisks(risks) {
    var out = { unclassified: 0, high: 0, medium: 0, low: 0 };
    (risks || []).forEach(function (r) {
        var band = String(r && r.residualBand ? r.residualBand : '');
        if (band === 'High') out.high++;
        else if (band === 'Medium') out.medium++;
        else if (band === 'Low') out.low++;
        else out.unclassified++;
    });
    return out;
}

function buildMatrixCountsFromRisks(risks) {
    var counts = {
        High: { High: 0, Medium: 0, Low: 0 },
        Medium: { High: 0, Medium: 0, Low: 0 },
        Low: { High: 0, Medium: 0, Low: 0 },
    };
    (risks || []).forEach(function (r) {
        var i = r && r.impact ? String(r.impact) : '';
        var l = r && r.likelihood ? String(r.likelihood) : '';
        if (!counts[i] || typeof counts[i][l] === 'undefined') return;
        counts[i][l] += 1;
    });
    return counts;
}

function computeTreatmentProgressFromRisks(risks) {
    var total = (risks || []).length;
    var withOwner = 0;
    var withTargetDate = 0;
    var overdueActions = 0;
    (risks || []).forEach(function (r) {
        if (r && r.actionRole) withOwner++;
        if (r && r.actionDueDate) withTargetDate++;
        if (r && r.actionOverdue) overdueActions++;
    });
    return {
        totalRisks: total,
        withOwner: withOwner,
        withOwnerPct: total ? ((withOwner / total) * 100).toFixed(1) : '0.0',
        withTargetDate: withTargetDate,
        withTargetDatePct: total ? ((withTargetDate / total) * 100).toFixed(1) : '0.0',
        overdueActions: overdueActions,
        overdueActionsPct: total ? ((overdueActions / total) * 100).toFixed(1) : '0.0',
    };
}

function renderDashboardPanelsFromFilteredData(scopeOnlyRisks, fullyFilteredRisks) {
    var matrix = buildMatrixCountsFromRisks(fullyFilteredRisks);
    renderRiskMatrix(matrix, { tableId: 'riskMatrixTable' });
    updateSelectedMatrixCells(selectedMatrixCells, { tableId: 'riskMatrixTable' });
    addRiskDonut(riskCountsFromRisks(fullyFilteredRisks), {
        chartId: 'riskChart',
        onBarClick: function (label) {
            var key = String(label || 'Unclassified');
            if (selectedRiskBands.has(key)) selectedRiskBands.delete(key);
            else selectedRiskBands.add(key);
            applyUnifiedFiltersAndRefresh();
        },
        activeLabels: Array.from(selectedRiskBands),
    });

    var ownerWith = fullyFilteredRisks.filter(function (r) { return !!(r && r.actionRole); }).length;
    var ownerWithout = fullyFilteredRisks.length - ownerWith;
    addBinaryBarChart({
        chartId: 'ownerChart',
        labels: ['With owner', 'Without owner'],
        values: [ownerWith, ownerWithout],
        activeLabels: Array.from(selectedOwnerStates).map(function (s) {
            return s === 'withOwner' ? 'With owner' : 'Without owner';
        }),
        onBarClick: function (label) {
            var key = label === 'With owner' ? 'withOwner' : 'withoutOwner';
            if (selectedOwnerStates.has(key)) selectedOwnerStates.delete(key);
            else selectedOwnerStates.add(key);
            applyUnifiedFiltersAndRefresh();
        },
    });

    var dateWith = fullyFilteredRisks.filter(function (r) { return !!(r && r.actionDueDate); }).length;
    var dateWithout = fullyFilteredRisks.length - dateWith;
    addBinaryBarChart({
        chartId: 'targetDateChart',
        labels: ['With target date', 'Without target date'],
        values: [dateWith, dateWithout],
        activeLabels: Array.from(selectedTargetDateStates).map(function (s) {
            return s === 'withTargetDate' ? 'With target date' : 'Without target date';
        }),
        onBarClick: function (label) {
            var key = label === 'With target date' ? 'withTargetDate' : 'withoutTargetDate';
            if (selectedTargetDateStates.has(key)) selectedTargetDateStates.delete(key);
            else selectedTargetDateStates.add(key);
            applyUnifiedFiltersAndRefresh();
        },
    });

    var totalEl = document.getElementById('totalRisksPanel');
    if (totalEl) {
        totalEl.textContent = String((fullyFilteredRisks || []).length);
    }
    var overdueCount = fullyFilteredRisks.filter(function (r) { return !!(r && r.actionOverdue); }).length;
    var notOverdueCount = fullyFilteredRisks.length - overdueCount;
    addBinaryBarChart({
        chartId: 'overdueChart',
        labels: ['Overdue', 'Not overdue'],
        values: [overdueCount, notOverdueCount],
        activeLabels: Array.from(selectedOverdueStates).map(function (s) {
            return s === 'overdue' ? 'Overdue' : 'Not overdue';
        }),
        onBarClick: function (label) {
            var key = label === 'Overdue' ? 'overdue' : 'notOverdue';
            if (selectedOverdueStates.has(key)) selectedOverdueStates.delete(key);
            else selectedOverdueStates.add(key);
            applyUnifiedFiltersAndRefresh();
        },
    });

    var trendEl = document.getElementById('trendPanel');
    if (trendEl) {
        var t = unifiedDashboardPayload && unifiedDashboardPayload.dashboard && unifiedDashboardPayload.dashboard.trend
            ? unifiedDashboardPayload.dashboard.trend
            : { days30: {}, days90: {} };
        trendEl.innerHTML =
            '<p><strong>30-day high-risk delta:</strong> ' + (t.days30 && t.days30.highResidualDelta != null ? t.days30.highResidualDelta : '0') + '</p>' +
            '<p><strong>30-day avg risk delta:</strong> ' + (t.days30 && t.days30.averageResidualDelta != null ? t.days30.averageResidualDelta : '0.00') + '</p>' +
            '<p><strong>90-day high-risk delta:</strong> ' + (t.days90 && t.days90.highResidualDelta != null ? t.days90.highResidualDelta : '0') + '</p>' +
            '<p><strong>90-day avg risk delta:</strong> ' + (t.days90 && t.days90.averageResidualDelta != null ? t.days90.averageResidualDelta : '0.00') + '</p>';
    }
}

function renderActiveFilterSummary(filteredAssessments, filteredRisks) {
    var scopeText = selectedScopeFilters.size
        ? Array.from(selectedScopeFilters).join(', ')
        : 'None';
    var matrixText = selectedMatrixCells.size
        ? Array.from(selectedMatrixCells).join(' | ')
        : 'All matrix cells';
    var bandText = selectedRiskBands.size ? Array.from(selectedRiskBands).join(', ') : 'All bands';
    var ownerText = selectedOwnerStates.size ? Array.from(selectedOwnerStates).join(', ') : 'Any owner state';
    var targetDateText = selectedTargetDateStates.size ? Array.from(selectedTargetDateStates).join(', ') : 'Any target-date state';
    var overdueText = selectedOverdueStates.size ? Array.from(selectedOverdueStates).join(', ') : 'Any overdue state';
    var el = document.getElementById('activeFilterSummary');
    if (!el) return;
    el.textContent =
        'Scopes: ' + scopeText +
        ' | Matrix: ' + matrixText +
        ' | Bands: ' + bandText +
        ' | Owner: ' + ownerText +
        ' | Target date: ' + targetDateText +
        ' | Overdue: ' + overdueText +
        ' | Assessments: ' + filteredAssessments.length +
