}
// Function to open share overlay
function openShareOverlay() {
    document.getElementById("shareOverlay").style.display = "block";
}

// Function to close share overlay
function closeShareOverlay() {
    document.getElementById("shareOverlay").style.display = "none";
}

function closeTransferOwnerOverlay() {
    var o = document.getElementById('transferOwnerOverlay');
    if (o) o.style.display = 'none';
}

$(document).on('change', '#orgShareCheckbox', function () {
    var checkboxEl = this;
    updateOrgShareToggleLabel();
    var overlay = document.getElementById('shareOverlay');
    if (!overlay) return;
    var projectId = overlay.getAttribute('data-projectid');
    if (!projectId) return;
    var checked = checkboxEl.checked;
    fetch('/project/' + projectId + '/organisation-share', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ sharedWithOrganisation: checked })
    })
        .then(function (res) {
            if (!res.ok) {
                return res.json().then(function (d) {
                    throw new Error(d.message || 'Update failed');
                });
            }
            return res.json();
        })
        .then(function () {
            if ($.fn.DataTable.isDataTable('#myProjectsTable')) {
                $('#myProjectsTable').DataTable().ajax.reload(null, false);
            }
            clearShareOverlayMessage();
        })
        .catch(function (e) {
            showShareOverlayMessage(e.message || String(e), true);
            checkboxEl.checked = !checked;
            updateOrgShareToggleLabel();
        });
});
</script>