<script src="/js/dashboard.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<form id="dataForm" data-project-id="<%= project ? project._id : '' %>">
</form>
<section class="content-block white result">
    <h1 id="title"></h1>
    <div id="aiProvenanceBanner" class="care-report-ai-notice" role="status" hidden>
        <p class="care-report-ai-notice__title">Artificial intelligence was used to help with this assessment</p>
        <p class="care-report-ai-notice__body">This project has a stored transparency record (prompts, models, reasoning where captured, and what you chose to apply). Each Word export includes a short notice in the <strong>About</strong> section that states whether the detailed record was appended for that download. Use the download dialog to tick or untick “Include AI provenance appendix” as needed.</p>
    </div>
    <h2>Objectives</h2>
    <p id="objectives"></p>
    <h2>Data used</h2>
    <p id="dataUsed"></p>
    <h2>Stakeholders</h2>
    <ul id="stakeholdersList">
    </ul>
    <h2>Intended consequences</h2>
    <ul id="intendedConsequencesList">
    </ul>
    <h2>Positive unintended consequences</h2>
    <ul id="positiveUnintendedConsequencesList">
    </ul>
    <h2>Risk matrix entries (static)</h2>
    <section class="riskGrid">
        <div class="table-scroll">
            <table id="riskEntryMatrixTable" class="riskHeatmap">
                <thead>
                    <tr>
                        <th>Likelihood →<br>Impact ↓</th>
                        <th>High</th>
                        <th>Medium</th>
                        <th>Low</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>
    <h2>Risk dashboard</h2>
    <div class="dashboard-global-actions">
        <button type="button" class="transparent" id="clearAllDashboardFilters">Clear all filters</button>
    </div>
    <p id="activeFilterSummary" class="small" style="margin:0 0 0.75rem 0;" style="display: none;"></p>
    <section class="dashboard">
        <subsection class="dashboard-box">
            <div class="dashboard-header dashboard-card-title">
                <h2>Project risk matrix</h2>
                <button type="button" class="transparent filter-reset-btn" id="clearMatrixFilters" hidden>Reset</button>
            </div>
            <div class="dashboard-chart">
                <div class="table-scroll">
                    <table id="riskMatrixTable" class="riskHeatmap riskHeatmap--compact">
                        <thead>
                            <tr>
                                <th>Likelihood →<br>Impact ↓</th>
                                <th>High</th>
                                <th>Medium</th>
                                <th>Low</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </subsection>
        <subsection class="dashboard-box">
            <div class="dashboard-header dashboard-card-title">
                <h2>Risk bands</h2>
                <button type="button" class="transparent filter-reset-btn" id="clearRiskBandFilters" hidden>Reset</button>
            </div>
            <div class="dashboard-chart report-risk-summary-chart">
                <div class="report-risk-chart-canvas-wrap">
                    <canvas id="riskChart" width="200" height="100"></canvas>
                </div>
            </div>
        </subsection>
        <subsection class="dashboard-box dashboard-box--total">
            <div class="dashboard-header">
                <h2>Total risks</h2>
            </div>
            <div class="dashboard-chart report-total-risks-chart">
                <div id="totalRisksPanel" class="dashboard-kpi">0</div>
            </div>
        </subsection>
        <subsection class="dashboard-box">
            <div class="dashboard-header dashboard-card-title">
                <h2>Action ownership</h2>
                <button type="button" class="transparent filter-reset-btn" id="clearOwnerFilters" hidden>Reset</button>
            </div>
            <div class="dashboard-chart report-risk-summary-chart">
                <div class="report-risk-chart-canvas-wrap">
                    <canvas id="ownerChart" width="200" height="100"></canvas>
                </div>
            </div>
        </subsection>
        <subsection class="dashboard-box">
            <div class="dashboard-header dashboard-card-title">
                <h2>Target dates</h2>
                <button type="button" class="transparent filter-reset-btn" id="clearTargetDateFilters" hidden>Reset</button>
            </div>
            <div class="dashboard-chart report-risk-summary-chart">
                <div class="report-risk-chart-canvas-wrap">
                    <canvas id="targetDateChart" width="200" height="100"></canvas>
                </div>
            </div>
        </subsection>
        <subsection class="dashboard-box">
            <div class="dashboard-header dashboard-card-title">
                <h2>Overdue status</h2>
                <button type="button" class="transparent filter-reset-btn" id="clearOverdueFilters" hidden>Reset</button>
            </div>
            <div class="dashboard-chart report-risk-summary-chart">
                <div class="report-risk-chart-canvas-wrap">
                    <canvas id="overdueChart" width="200" height="100"></canvas>
                </div>
            </div>
        </subsection>
        <subsection class="dashboard-box">
            <div class="dashboard-header dashboard-card-title">
                <h2>Completion status</h2>
                <button type="button" class="transparent filter-reset-btn" id="clearCompletionFilters" hidden>Reset</button>
            </div>
            <div class="dashboard-chart report-risk-summary-chart">
                <div class="report-risk-chart-canvas-wrap">
                    <canvas id="completionChart" width="200" height="100"></canvas>
                </div>
            </div>
        </subsection>
    </section>
    <h2>Risk management table</h2>
    <div class="table-scroll">
    <table id="unintendedConsequences">
        <thead>
            <th width="21%">Consequence</th>
            <th width="6%">Risk category</th>
            <th width="6%">Likelihood</th>
            <th width="6%">Impact</th>
            <th width="6%">Role</th>
            <th width="21%">Action</th>
            <th width="6%">Timescale</th>
            <th width="6%">Assignee</th>
            <th width="21%">KPI</th>
            <th width="10%">Completion</th>
        </thead>
        <tbody id="unintendedConsequencesBody">
        </tbody>
    </table>
    </div>
</section>
<div id="submitButtonContainer" class="content-block white proceed">
    <button id="downloadButton" class="btn btn-primary submitButton">Download project data</button>
    <button id="downloadCSVButton" class="btn btn-primary submitButton">Download risk assessment (CSV)</button>
    <button id="downloadDOCXButton" class="btn btn-primary submitButton" type="button">Download project report (DOCX)</button>
</div>
<dialog id="reportDownloadDialog" class="org-access-edit-dialog" aria-labelledby="reportDownloadDialogTitle">
    <div class="content-block white">
        <h2 id="reportDownloadDialogTitle" style="margin-top:0;">Download project report</h2>
        <p class="small">After the document downloads, update the table of contents in Word so page numbers and titles are correct.</p>
        <div class="sub-form" style="margin-top:1rem;">
            <p id="reportAiProvenanceHint" class="small care-report-download-ai-hint" hidden>This project has AI assistance history — consider including the provenance appendix for transparency.</p>
            <label class="org-add-delegated-perms__chk" style="margin-bottom:1rem;">
                <input type="checkbox" id="reportIncludeGlossaryAppendix"/>
                Include glossary as an appendix (definitions of CARE terms)
            </label>
            <label class="org-add-delegated-perms__chk" style="margin-bottom:1rem;">
                <input type="checkbox" id="reportIncludeAiProvenance"/>
                Include AI provenance appendix (prompts, model, reasoning, responses and what was selected)
            </label>
            <div class="sub-form__actions">
                <button type="button" class="btn btn-primary" id="reportDownloadConfirm">Download</button>
                <button type="button" class="transparent" id="reportDownloadCancel">Cancel</button>
            </div>
        </div>
    </div>
</dialog>
<%- include('../partials/scan-footer') %>
<script>

    let projectData = {};
    let projectId = "";
    let allNegativeRisks = [];
    const selectedMatrixCells = new Set();
    const selectedRiskBands = new Set();
    const selectedOwnerStates = new Set();
    const selectedTargetDateStates = new Set();
    const selectedOverdueStates = new Set();
    const selectedCompletionStates = new Set();

    document.addEventListener("DOMContentLoaded", function () {

        // Get the project ID
        const form = document.getElementById("dataForm");
        projectId = form.dataset.projectId;

        loadPage(projectId);
        addButtonListeners(projectId);
        addDashboardFilterListeners();
    });

    function getDownloadButtons() {
        return [
            document.getElementById("downloadButton"),
            document.getElementById("downloadCSVButton"),
            document.getElementById("downloadDOCXButton")
        ].filter(Boolean);
    }

    function setDownloadButtonsDisabled(disabled) {
        getDownloadButtons().forEach((btn) => {
            btn.disabled = disabled;
        });
    }

    let projectDownloadInProgress = false;

    async function downloadProjectDocx(appendGlossary, includeAiProvenance) {
        if (projectDownloadInProgress) {
            return;
        }
        projectDownloadInProgress = true;
        setDownloadButtonsDisabled(true);
        try {
            const params = new URLSearchParams();
            if (appendGlossary) {
                params.set("appendGlossary", "true");
            }
            if (includeAiProvenance) {
                params.set("includeAiProvenance", "true");
            }
            const qs = params.toString();
            const response = await fetch(`/project/${projectId}${qs ? "?" + qs : ""}`, {
                headers: {
                    "Accept": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                }
            });
            if (!response.ok) {
                throw new Error(`Download failed (${response.status})`);
            }

            const blob = await response.blob();
            const url = URL.createObjectURL(blob);

            const link = document.createElement("a");
            link.href = url;
            link.download = projectData.title.replace(/\s+/g, "_").trim() + ".docx";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            URL.revokeObjectURL(url);
        } catch (error) {
            console.error("Error downloading DOCX data:", error);
        } finally {
            projectDownloadInProgress = false;
            setDownloadButtonsDisabled(false);
        }
    }

    function addButtonListeners(projectId) {
        const reportDownloadDialog = document.getElementById("reportDownloadDialog");
        const reportIncludeGlossaryAppendix = document.getElementById("reportIncludeGlossaryAppendix");
        const reportIncludeAiProvenance = document.getElementById("reportIncludeAiProvenance");
        const reportDownloadConfirm = document.getElementById("reportDownloadConfirm");
        const reportDownloadCancel = document.getElementById("reportDownloadCancel");

        if (reportDownloadDialog && reportDownloadConfirm && reportDownloadCancel) {
            document.getElementById("downloadDOCXButton").addEventListener("click", () => {
                const hint = document.getElementById("reportAiProvenanceHint");
                if (hint) {
                    const hasAi =
                        (typeof projectData.aiInteractionHistoryCount === 'number' &&
                            projectData.aiInteractionHistoryCount > 0) ||
                        (Array.isArray(projectData.aiInteractionHistory) &&
                            projectData.aiInteractionHistory.length > 0);
                    hint.hidden = !hasAi;
                }
                if (typeof reportDownloadDialog.showModal === "function") {
                    reportDownloadDialog.showModal();
                } else {
                    downloadProjectDocx(false, false);
                }
            });
            reportDownloadCancel.addEventListener("click", () => reportDownloadDialog.close());
            reportDownloadConfirm.addEventListener("click", () => {
                const appendGlossary = reportIncludeGlossaryAppendix && reportIncludeGlossaryAppendix.checked;
                const includeAiProv = reportIncludeAiProvenance && reportIncludeAiProvenance.checked;
                reportDownloadDialog.close();
                downloadProjectDocx(appendGlossary, includeAiProv);
            });
            reportDownloadDialog.addEventListener("click", function (ev) {
                if (ev.target === reportDownloadDialog) {
                    reportDownloadDialog.close();
                }
            });
        } else {
            document.getElementById("downloadDOCXButton").addEventListener("click", () => downloadProjectDocx(false, false));
        }

        document.getElementById("downloadButton").addEventListener("click", async () => {
            if (projectDownloadInProgress) {
                return;
            }
            projectDownloadInProgress = true;
            setDownloadButtonsDisabled(true);
            try {
                const response = await fetch(
                    `/project/${projectId}?includeAiInteractionHistory=true`,
                    {
                        headers: {
                            "Accept": "application/json"
                        }
                    }
                );
                if (!response.ok) {
                    throw new Error(`Download failed (${response.status})`);
                }
                const jsonData = await response.json();
                const jsonBlob = new Blob([JSON.stringify(jsonData,null,2)], { type: "application/json" });
                const url = URL.createObjectURL(jsonBlob);

                const link = document.createElement("a");
                link.href = url;
                link.download = projectData.title.replace(/\s+/g, "_").trim() + ".json";
                link.click();

                URL.revokeObjectURL(url);
            } catch (error) {
                console.error("Error downloading project data:", error);
            } finally {
                projectDownloadInProgress = false;
                setDownloadButtonsDisabled(false);
            }
        });
        document.getElementById("downloadCSVButton").addEventListener("click", async () => {
            if (projectDownloadInProgress) {
                return;
            }
            projectDownloadInProgress = true;
            setDownloadButtonsDisabled(true);
            try {
                const response = await fetch(`/project/${projectId}`, {
                    headers: {
                        "Accept": "text/csv"
                    }
                });
                if (!response.ok) {
                    throw new Error(`Download failed (${response.status})`);
                }

                const csvData = await response.text();
                const csvBlob = new Blob([csvData], { type: "text/csv" });
                const url = URL.createObjectURL(csvBlob);

                const link = document.createElement("a");
                link.href = url;
                link.download = projectData.title.replace(/\s+/g, "_").trim() + ".csv";
                link.click();

                URL.revokeObjectURL(url);
            } catch (error) {
                console.error("Error downloading CSV data:", error);
            } finally {
                projectDownloadInProgress = false;
                setDownloadButtonsDisabled(false);
            }
        });
    }

    function escapeHtml(value) {
        return String(value == null ? "" : value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    function renderBandBadge(band) {
        const label = String(band || "Unclassified");
        const cls =
            label === "High" ? "risk-band-badge risk-band-badge--high"
                : label === "Medium" ? "risk-band-badge risk-band-badge--medium"
                    : label === "Low" ? "risk-band-badge risk-band-badge--low"
                        : "risk-band-badge risk-band-badge--unclassified";
        return `<span class="${cls}">${escapeHtml(label)}</span>`;
    }

    function buildMatrixCountsFromRisks(risks) {
        const counts = {
            High: { High: 0, Medium: 0, Low: 0 },
            Medium: { High: 0, Medium: 0, Low: 0 },
            Low: { High: 0, Medium: 0, Low: 0 }
        };
        (risks || []).forEach((risk) => {
            const impact = risk && risk.impact ? String(risk.impact) : "";
            const likelihood = risk && risk.likelihood ? String(risk.likelihood) : "";
            if (!counts[impact] || typeof counts[impact][likelihood] === "undefined") {
                return;
            }
            counts[impact][likelihood] += 1;
        });
        return counts;
    }

    function buildMatrixEntryMapFromRisks(risks) {
        const entries = {
            High: { High: [], Medium: [], Low: [] },
            Medium: { High: [], Medium: [], Low: [] },
            Low: { High: [], Medium: [], Low: [] }
        };
        (risks || []).forEach((risk) => {
            const impact = risk && risk.impact ? String(risk.impact) : "";
            const likelihood = risk && risk.likelihood ? String(risk.likelihood) : "";
            if (!entries[impact] || !entries[impact][likelihood]) {
                return;
            }
            const consequence = String((risk && risk.consequence) || "").trim();
            if (consequence) {
                entries[impact][likelihood].push(consequence);
            }
        });
        return entries;
    }

    function getMatrixCellBackground(impact, likelihood) {
        const i = String(impact || "");
        const l = String(likelihood || "");
        if (i === "High" && l === "High") return "#f8d7da";
        if ((i === "High" && l === "Medium") || (i === "Medium" && l === "High")) return "#fad8cb";
        if (
            (i === "Medium" && l === "Medium") ||
            (i === "High" && l === "Low") ||
            (i === "Low" && l === "High")
        ) {
            return "#fff3cd";
        }
        if (i === "Low" && l === "Low") return "#d4edda";
        if ((i === "Medium" && l === "Low") || (i === "Low" && l === "Medium")) return "#faffdc";
        return "#ffffff";
    }

    function renderStaticRiskEntryMatrix(risks) {
        const table = document.getElementById("riskEntryMatrixTable");
        if (!table) return;
        const body = table.querySelector("tbody");
        if (!body) return;

        const levels = ["High", "Medium", "Low"];
        const entries = buildMatrixEntryMapFromRisks(risks);
        body.innerHTML = "";

        levels.forEach((impact) => {
            const row = document.createElement("tr");
            const head = document.createElement("th");
            head.scope = "row";
            head.textContent = impact;
            row.appendChild(head);

            levels.forEach((likelihood) => {
                const cell = document.createElement("td");
                cell.style.backgroundColor = getMatrixCellBackground(impact, likelihood);
                const items = entries[impact][likelihood] || [];
                if (!items.length) {
                    const empty = document.createElement("span");
                    empty.className = "small";
                    empty.textContent = "—";
                    cell.appendChild(empty);
                } else {
                    items.forEach((name) => {
                        const item = document.createElement("div");
                        item.className = "risk-entry";
                        item.textContent = name;
                        cell.appendChild(item);
                    });
                }
                row.appendChild(cell);
            });
            body.appendChild(row);
        });
    }

    function riskCountsFromRisks(risks) {
        const out = { unclassified: 0, high: 0, medium: 0, low: 0 };
        (risks || []).forEach((risk) => {
            const band = getBandFromScore(risk && risk.riskScore != null ? Number(risk.riskScore) : NaN);
            if (band === "High") out.high += 1;
            else if (band === "Medium") out.medium += 1;
            else if (band === "Low") out.low += 1;
            else out.unclassified += 1;
        });
        return out;
    }

    function riskMatchesMatrixFilters(risk) {
        if (!selectedMatrixCells.size) return true;
        const cellId = buildMatrixCellId(risk && risk.impact, risk && risk.likelihood);
        return !!cellId && selectedMatrixCells.has(cellId);
    }

    function riskMatchesBandFilters(risk) {
        if (!selectedRiskBands.size) return true;
        const band = getBandFromScore(risk && risk.riskScore != null ? Number(risk.riskScore) : NaN);
        return selectedRiskBands.has(band);
    }

    function hasRiskOwner(risk) {
        const role = String(risk && risk.role ? risk.role : "").trim();
        const assignee = String(risk && risk.action && risk.action.stakeholder ? risk.action.stakeholder : "").trim();
        return role.length > 0 || assignee.length > 0;
    }

    function parseRiskDateValue(rawDate) {
        const raw = String(rawDate || "").trim();
        if (!raw) return null;
        const direct = new Date(raw);
        if (!Number.isNaN(direct.getTime())) return direct;
        const ukMatch = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(raw);
        if (ukMatch) {
            const day = Number(ukMatch[1]);
            const month = Number(ukMatch[2]);
            const year = Number(ukMatch[3]);
            const asIso = new Date(`${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}T00:00:00`);
            if (!Number.isNaN(asIso.getTime())) return asIso;
        }
        return null;
    }

    function hasRiskTargetDate(risk) {
        const parsed = parseRiskDateValue(risk && risk.action && risk.action.date);
        return !!parsed;
    }

    function isRiskOverdue(risk) {
        const date = parseRiskDateValue(risk && risk.action && risk.action.date);
        if (!date) return false;
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        return date.getTime() < today.getTime();
    }

    function riskMatchesOwnerFilters(risk) {
        if (!selectedOwnerStates.size) return true;
        const state = hasRiskOwner(risk) ? "withOwner" : "withoutOwner";
        return selectedOwnerStates.has(state);
    }

    function riskMatchesTargetDateFilters(risk) {
        if (!selectedTargetDateStates.size) return true;
        const state = hasRiskTargetDate(risk) ? "withTargetDate" : "withoutTargetDate";
        return selectedTargetDateStates.has(state);
    }

    function riskMatchesOverdueFilters(risk) {
        if (!selectedOverdueStates.size) return true;
        const state = isRiskOverdue(risk) ? "overdue" : "notOverdue";
        return selectedOverdueStates.has(state);
    }

    function getCompletionStateFromRisk(risk) {
        const raw = String(risk && risk.action && risk.action.completed ? risk.action.completed : "").trim();
        return raw === "Completed" ? "completed" : "notCompleted";
    }

    function riskMatchesCompletionFilters(risk) {
        if (!selectedCompletionStates.size) return true;
        const state = getCompletionStateFromRisk(risk);
        return selectedCompletionStates.has(state);
    }

    function applyRiskFilters(list) {
        return (list || []).filter((risk) => {
            if (!riskMatchesMatrixFilters(risk)) return false;
            if (!riskMatchesBandFilters(risk)) return false;
            if (!riskMatchesOwnerFilters(risk)) return false;
            if (!riskMatchesTargetDateFilters(risk)) return false;
            if (!riskMatchesOverdueFilters(risk)) return false;
            if (!riskMatchesCompletionFilters(risk)) return false;
            return true;
        });
    }

    function renderRiskTableRows(risks) {
        const unintendedConsequencesBody = document.getElementById("unintendedConsequencesBody");
        if (!unintendedConsequencesBody) {
            return;
        }
        unintendedConsequencesBody.innerHTML = "";
        if (!risks || risks.length === 0) {
            unintendedConsequencesBody.innerHTML = "<tr><td colspan='10'>No risks match the current filter.</td></tr>";
            return;
        }
        risks.forEach((risk) => {
            const riskBand = getBandFromScore(risk && risk.riskScore != null ? Number(risk.riskScore) : NaN);
            const completionStatus = risk && risk.action && risk.action.completed ? String(risk.action.completed) : "";
            const completionComment = risk && risk.action && risk.action.completionComment ? String(risk.action.completionComment) : "";
            const completionDate = risk && risk.action && risk.action.completedAt ? String(risk.action.completedAt) : "";
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>${escapeHtml(risk.consequence || "")}</td>
                <td>${renderBandBadge(riskBand)}</td>
                <td>${escapeHtml(risk.likelihood || "")}</td>
                <td>${escapeHtml(risk.impact || "")}</td>
                <td>${escapeHtml(risk.role || "")}</td>
                <td>${escapeHtml((risk.action && risk.action.description) || "")}</td>
                <td>${escapeHtml((risk.action && risk.action.date) || "")}</td>
                <td>${escapeHtml((risk.action && risk.action.stakeholder) || "")}</td>
                <td>${escapeHtml((risk.action && risk.action.KPI) || "")}</td>
                <td>${escapeHtml(completionStatus || "Not recorded")}${completionDate ? `<br><span class="small">${escapeHtml(completionDate)}</span>` : ""}${completionComment ? `<br><span class="small">${escapeHtml(completionComment)}</span>` : ""}</td>
            `;
            unintendedConsequencesBody.appendChild(row);
        });
    }

    function updateFilterSummary(filteredRisks) {
        const summaryEl = document.getElementById("activeFilterSummary");
        if (!summaryEl) {
            return;
        }
        const matrixText = selectedMatrixCells.size
            ? Array.from(selectedMatrixCells).join(" | ")
            : "All matrix cells";
        const bandText = selectedRiskBands.size ? Array.from(selectedRiskBands).join(", ") : "All bands";
        const ownerText = selectedOwnerStates.size
            ? Array.from(selectedOwnerStates).map((state) => state === "withOwner" ? "With owner" : "Without owner").join(", ")
            : "Any owner state";
        const targetDateText = selectedTargetDateStates.size
            ? Array.from(selectedTargetDateStates).map((state) => state === "withTargetDate" ? "With target date" : "Without target date").join(", ")
            : "Any target-date state";
        const overdueText = selectedOverdueStates.size
            ? Array.from(selectedOverdueStates).map((state) => state === "overdue" ? "Overdue" : "Not overdue").join(", ")
            : "Any overdue state";
        const completionText = selectedCompletionStates.size
            ? Array.from(selectedCompletionStates).map((state) => state === "completed" ? "Completed" : "Not completed").join(", ")
            : "Any completion state";
        summaryEl.textContent =
            `Matrix: ${matrixText} | Bands: ${bandText} | Owner: ${ownerText} | Target date: ${targetDateText} | Overdue: ${overdueText} | Completion: ${completionText} | Risks shown: ${filteredRisks.length}`;
    }

    function setResetButtonState(id, applied) {
        const resetBtn = document.getElementById(id);
        if (resetBtn) resetBtn.hidden = !applied;
    }

    function updateDashboardFilterHeaderStates() {
        setResetButtonState("clearMatrixFilters", selectedMatrixCells.size > 0);
        setResetButtonState("clearRiskBandFilters", selectedRiskBands.size > 0);
        setResetButtonState("clearOwnerFilters", selectedOwnerStates.size > 0);
        setResetButtonState("clearTargetDateFilters", selectedTargetDateStates.size > 0);
        setResetButtonState("clearOverdueFilters", selectedOverdueStates.size > 0);
        setResetButtonState("clearCompletionFilters", selectedCompletionStates.size > 0);
    }

    function applyDashboardFiltersAndRefresh() {
        const filteredRisks = applyRiskFilters(allNegativeRisks);
        const matrixCounts = buildMatrixCountsFromRisks(filteredRisks);
        renderRiskMatrix(matrixCounts, { tableId: "riskMatrixTable" });
        updateSelectedMatrixCells(selectedMatrixCells, { tableId: "riskMatrixTable" });
        addRiskDonut(riskCountsFromRisks(filteredRisks), {
            chartId: "riskChart",
            activeLabels: Array.from(selectedRiskBands),
            onBarClick: function (label) {
                const key = String(label || "Unclassified");
                if (selectedRiskBands.has(key)) selectedRiskBands.delete(key);
                else selectedRiskBands.add(key);
                applyDashboardFiltersAndRefresh();
            }
        });
        const withOwner = filteredRisks.filter((risk) => hasRiskOwner(risk)).length;
        const withoutOwner = filteredRisks.length - withOwner;
        addBinaryBarChart({
            chartId: "ownerChart",
            labels: ["With owner", "Without owner"],
            values: [withOwner, withoutOwner],
            activeLabels: Array.from(selectedOwnerStates).map((state) =>
                state === "withOwner" ? "With owner" : "Without owner"
            ),
            onBarClick: function (label) {
                const key = label === "With owner" ? "withOwner" : "withoutOwner";
                if (selectedOwnerStates.has(key)) selectedOwnerStates.delete(key);
                else selectedOwnerStates.add(key);
                applyDashboardFiltersAndRefresh();
            }
        });
        const withTargetDate = filteredRisks.filter((risk) => hasRiskTargetDate(risk)).length;
        const withoutTargetDate = filteredRisks.length - withTargetDate;
        addBinaryBarChart({
            chartId: "targetDateChart",
            labels: ["With target date", "Without target date"],
            values: [withTargetDate, withoutTargetDate],
            activeLabels: Array.from(selectedTargetDateStates).map((state) =>
                state === "withTargetDate" ? "With target date" : "Without target date"
            ),
            onBarClick: function (label) {
                const key = label === "With target date" ? "withTargetDate" : "withoutTargetDate";
                if (selectedTargetDateStates.has(key)) selectedTargetDateStates.delete(key);
                else selectedTargetDateStates.add(key);
                applyDashboardFiltersAndRefresh();
            }
        });
        const overdueCount = filteredRisks.filter((risk) => isRiskOverdue(risk)).length;
        const notOverdueCount = filteredRisks.length - overdueCount;
        addBinaryBarChart({
            chartId: "overdueChart",
            labels: ["Overdue", "Not overdue"],
            values: [overdueCount, notOverdueCount],
            activeLabels: Array.from(selectedOverdueStates).map((state) =>
                state === "overdue" ? "Overdue" : "Not overdue"
            ),
            onBarClick: function (label) {
                const key = label === "Overdue" ? "overdue" : "notOverdue";
                if (selectedOverdueStates.has(key)) selectedOverdueStates.delete(key);
                else selectedOverdueStates.add(key);
                applyDashboardFiltersAndRefresh();
            }
        });

        const completedCount = filteredRisks.filter((risk) => getCompletionStateFromRisk(risk) === "completed").length;
        const notCompletedCount = filteredRisks.length - completedCount;
        addBinaryBarChart({
            chartId: "completionChart",
            labels: ["Completed", "Not completed"],
            values: [completedCount, notCompletedCount],
            activeLabels: Array.from(selectedCompletionStates).map((state) =>
                state === "completed" ? "Completed" : "Not completed"
            ),
            onBarClick: function (label) {
                const key = label === "Completed" ? "completed" : "notCompleted";
                if (selectedCompletionStates.has(key)) selectedCompletionStates.delete(key);
                else selectedCompletionStates.add(key);
                applyDashboardFiltersAndRefresh();
            }
        });

        const totalRisksPanel = document.getElementById("totalRisksPanel");
        if (totalRisksPanel) {
            totalRisksPanel.textContent = String(filteredRisks.length);
        }
        updateFilterSummary(filteredRisks);
        updateDashboardFilterHeaderStates();
        renderRiskTableRows(filteredRisks);
    }

    function addDashboardFilterListeners() {
        document.addEventListener("click", (event) => {
            const matrixCellButton = event.target.closest(".matrix-cell-btn");
            if (!matrixCellButton) {
                return;
            }
            const cellId = String(matrixCellButton.getAttribute("data-cell-id") || "");
            if (!cellId) {
                return;
            }
            if (selectedMatrixCells.has(cellId)) {
                selectedMatrixCells.delete(cellId);
            } else {
                selectedMatrixCells.add(cellId);
            }
            applyDashboardFiltersAndRefresh();
        });

        const clearMatrixFilters = document.getElementById("clearMatrixFilters");
        if (clearMatrixFilters) {
            clearMatrixFilters.addEventListener("click", () => {
                selectedMatrixCells.clear();
                applyDashboardFiltersAndRefresh();
            });
        }
        const clearRiskBandFilters = document.getElementById("clearRiskBandFilters");
        if (clearRiskBandFilters) {
            clearRiskBandFilters.addEventListener("click", () => {
                selectedRiskBands.clear();
                applyDashboardFiltersAndRefresh();
            });
        }
        const clearOwnerFilters = document.getElementById("clearOwnerFilters");
        if (clearOwnerFilters) {
            clearOwnerFilters.addEventListener("click", () => {
                selectedOwnerStates.clear();
                applyDashboardFiltersAndRefresh();
            });
        }
        const clearTargetDateFilters = document.getElementById("clearTargetDateFilters");
        if (clearTargetDateFilters) {
            clearTargetDateFilters.addEventListener("click", () => {
                selectedTargetDateStates.clear();
                applyDashboardFiltersAndRefresh();
            });
        }
        const clearOverdueFilters = document.getElementById("clearOverdueFilters");
        if (clearOverdueFilters) {
            clearOverdueFilters.addEventListener("click", () => {
                selectedOverdueStates.clear();
                applyDashboardFiltersAndRefresh();
            });
        }
        const clearCompletionFilters = document.getElementById("clearCompletionFilters");
        if (clearCompletionFilters) {
            clearCompletionFilters.addEventListener("click", () => {
                selectedCompletionStates.clear();
                applyDashboardFiltersAndRefresh();
            });
        }
        const clearAllDashboardFilters = document.getElementById("clearAllDashboardFilters");
        if (clearAllDashboardFilters) {
            clearAllDashboardFilters.addEventListener("click", () => {
                selectedMatrixCells.clear();
                selectedRiskBands.clear();
                selectedOwnerStates.clear();
                selectedTargetDateStates.clear();
                selectedOverdueStates.clear();
                 selectedCompletionStates.clear();
                applyDashboardFiltersAndRefresh();
            });
        }
    }

    async function loadPage(projectId) {
        projectData = await loadProject(projectId);
        projectData = await addRiskScoreToProject(projectData);
        selectedMatrixCells.clear();
        selectedRiskBands.clear();
        selectedOwnerStates.clear();
        selectedTargetDateStates.clear();
        selectedOverdueStates.clear();
        selectedCompletionStates.clear();

        document.getElementById("title").textContent = projectData.title;
        const aiBanner = document.getElementById("aiProvenanceBanner");
        if (aiBanner) {
            const hasAi =
                (typeof projectData.aiInteractionHistoryCount === 'number' &&
                    projectData.aiInteractionHistoryCount > 0) ||
                (Array.isArray(projectData.aiInteractionHistory) &&
                    projectData.aiInteractionHistory.length > 0);
            aiBanner.hidden = !hasAi;
        }
        document.getElementById("objectives").textContent = projectData.objectives || "No objectives provided.";
        document.getElementById("dataUsed").textContent = projectData.dataUsed || "No data used provided.";

        const stakeholdersList = document.getElementById("stakeholdersList");
        stakeholdersList.innerHTML = "";
        if (projectData.stakeholders && projectData.stakeholders.length > 0) {
            projectData.stakeholders.forEach(stakeholder => {
                const listItem = document.createElement("li");
                listItem.textContent = stakeholder.stakeholder;
                stakeholdersList.appendChild(listItem);
            });
        } else {
            stakeholdersList.innerHTML = "<li>No stakeholders provided.</li>";
        }

        const intendedConsequencesList = document.getElementById("intendedConsequencesList");
        intendedConsequencesList.innerHTML = "";
        if (projectData.intendedConsequences && projectData.intendedConsequences.length > 0) {
            projectData.intendedConsequences.forEach(consequence => {
                const listItem = document.createElement("li");
                listItem.textContent = consequence.consequence;
                intendedConsequencesList.appendChild(listItem);
            });
        } else {
            intendedConsequencesList.innerHTML = "<li>No intended consequences provided.</li>";
        }

        const positiveUnintendedConsequencesList = document.getElementById("positiveUnintendedConsequencesList");
        if (positiveUnintendedConsequencesList) {
            positiveUnintendedConsequencesList.innerHTML = "";
        }

        allNegativeRisks = [];
        if (projectData.unintendedConsequences && projectData.unintendedConsequences.length > 0) {
            const unintended = projectData.unintendedConsequences || [];
            unintended.forEach(consequence => {
                if (consequence.outcome === "Positive") {
                    if (positiveUnintendedConsequencesList) {
                        const item = document.createElement("li");
                        item.textContent = consequence.consequence;
                        positiveUnintendedConsequencesList.appendChild(item);
                    }
                } else {
                    allNegativeRisks.push(consequence);
                }
            });
        } else {
            allNegativeRisks = [];
        }
        if (positiveUnintendedConsequencesList && positiveUnintendedConsequencesList.children.length === 0) {
            positiveUnintendedConsequencesList.innerHTML = "<li>No positive unintended consequences provided.</li>";
        }
        renderStaticRiskEntryMatrix(allNegativeRisks);
        applyDashboardFiltersAndRefresh();
    }
</script>
