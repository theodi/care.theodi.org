<link href="/lib/DataTables/datatables.min.css" rel="stylesheet">
<div class="main-content organisation-page">
  <section class="page-title container white">
    <h1><%= page.title %></h1>
    <input type="hidden" value="<%= page.link %>" id="pageId"/>
  </section>

  <% if (!organisation) { %>
  <div class="content-block white">
    <p>You are not part of an organisation subscription, or your subscription is not active. Contact your organisation admin or ODI if you believe this is wrong.</p>
    <p><a href="/projects">Back to evaluations</a></p>
  </div>
  <% } else { %>
  <% var orgAdminCount = organisation.members.filter(function(m) { return m.role === 'admin'; }).length; %>
  <% var orgMainStripe = 0; %>
  <div class="content-block <%= (orgMainStripe++ % 2 === 0) ? 'white' : 'light-blue' %>">
    <div class="organisation-page__summary">
      <p>
        Domain: <strong>@<%= organisation.subscription.emailDomain %></strong><br/>
        Plan: <strong><%= organisation.subscription.planTier %></strong><br/>
        Licensed users: <strong><%= organisation.subscription.seatUsed %> / <%= organisation.subscription.seatLimit %></strong> <span class="small">(seat limit)</span><br/>
        Subscription: <strong><%= organisation.subscription.subscriptionActive ? 'Active' : 'Expired' %></strong>
        (until <%= new Date(organisation.subscription.endDate).toLocaleDateString() %>)
      </p>
    </div>
    <div id="orgMessage" class="alert" style="display:none;"></div>
  </div>

  <div class="content-block <%= (orgMainStripe++ % 2 === 0) ? 'white' : 'light-blue' %>">
    <h2>Licensed users</h2>
    <div class="org-dt-wrap org-licensed-users-dt">
    <table class="display org-dt-table" style="width:100%" id="licensedUsersTable">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>CARE account</th>
          <th>Additional permissions</th>
          <% if (organisation.myMembership.isOrganisationAdmin || (organisation.subscription.subscriptionActive && organisation.myMembership.canManageLicenses)) { %><th></th><% } %>
        </tr>
      </thead>
      <tbody>
        <% organisation.members.forEach(function(m) {
          var canRemoveThis = false;
          if (organisation.subscription.subscriptionActive && organisation.myMembership.canManageLicenses) {
            if (m.role !== 'admin') canRemoveThis = true;
            else if (organisation.myMembership.isOrganisationAdmin && orgAdminCount > 1) canRemoveThis = true;
          }
        %>
        <tr data-membership-id="<%= m.membershipId %>">
          <td><%= m.name || '—' %></td>
          <td><%= m.email %></td>
          <td><%= m.hasAccount ? 'Yes' : 'Not yet' %></td>
          <td>
            <% var accessParts = [];
            if (m.role === 'admin') {
              accessParts.push('Organisation admin (full access)');
            } else {
              if (m.licenseAdmin) accessParts.push('License manager');
              if (m.aiModelAdmin) accessParts.push('AI model admin');
              if (m.promptAdmin) accessParts.push('Prompt manager');
              if (m.reportAdmin) accessParts.push('Report manager');
              if (m.projectManager) accessParts.push('Project manager');
              if (accessParts.length === 0) accessParts.push('—');
            }
            var accessSummary = accessParts.join(' · ');
            %>
            <%= accessSummary %>
          </td>
          <% if (organisation.myMembership.isOrganisationAdmin || (organisation.subscription.subscriptionActive && organisation.myMembership.canManageLicenses)) { %>
          <td class="org-licensed-users__actions">
            <% if (organisation.myMembership.isOrganisationAdmin) { %>
            <button type="button" class="transparent orgEditAccessBtn"
              data-membership-id="<%= m.membershipId %>"
              data-email="<%= m.email %>"
              data-role="<%= m.role %>"
              data-license-admin="<%= m.licenseAdmin ? 'true' : 'false' %>"
              data-ai-model-admin="<%= m.aiModelAdmin ? 'true' : 'false' %>"
              data-prompt-admin="<%= m.promptAdmin ? 'true' : 'false' %>"
              data-report-admin="<%= m.reportAdmin ? 'true' : 'false' %>"
              data-project-manager="<%= m.projectManager ? 'true' : 'false' %>"
            >Edit</button>
            <% } %>
            <% if (canRemoveThis) { %>
            <button type="button" class="transparent removeMemberBtn" data-membership-id="<%= m.membershipId %>">Remove</button>
            <% } %>
            <% if (!organisation.myMembership.isOrganisationAdmin && !canRemoveThis) { %>—<% } %>
          </td>
          <% } %>
        </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
    <% if (organisation.subscription.subscriptionActive && organisation.myMembership.canManageLicenses) { %>
    <p class="org-licensed-users__add-bar">
      <button type="button" class="transparent" id="orgAddLicensedUserBtn">Add licensed user</button>
    </p>
    <% } %>
  </div>

  <% if (organisation.subscription.subscriptionActive && organisation.myMembership.canManageLicenses) { %>
  <dialog id="orgAccessEditDialog" class="org-access-edit-dialog" data-is-org-admin="<%= organisation.myMembership.isOrganisationAdmin ? 'true' : 'false' %>">
    <div class="content-block white">
      <h2 id="orgAccessDialogTitle" style="margin-top:0;">Add licensed user</h2>
      <p class="small" id="orgAccessEditForEmail" style="display:none;"></p>
      <div id="orgAccessEditModalMsg" class="alert" style="display:none;"></div>
      <form id="orgAccessEditForm" class="sub-form" data-mode="add" novalidate>
        <input type="hidden" id="orgAccessEditMembershipId" value=""/>
        <div id="orgAccessEmailRow" class="sub-form__row">
          <label class="sub-form__label" for="orgAccessAddEmail">Email</label>
          <div class="sub-form__control">
            <input type="email" id="orgAccessAddEmail" class="input inputText" autocomplete="email" placeholder="name@<%= organisation.subscription.emailDomain %>"/>
            <p class="sub-form__hint">Address must be on <strong>@<%= organisation.subscription.emailDomain %></strong>.</p>
          </div>
        </div>
        <div id="orgAccessRoleRow" class="sub-form__row">
          <label class="sub-form__label" for="orgAccessEditRole">Access level</label>
          <div class="sub-form__control">
            <select id="orgAccessEditRole" class="input inputText" required>
              <option value="member">Licensed user</option>
              <option value="admin">Organisation admin (full access)</option>
            </select>
            <p class="sub-form__hint">Organisation admins have every permission. Licensed users may have one or more delegated roles below.</p>
          </div>
        </div>
        <div id="orgAccessEditDelegatedWrap" class="sub-form__row">
          <span class="sub-form__label">Delegated permissions</span>
          <div class="sub-form__control org-access-edit-delegated">
            <label class="org-add-delegated-perms__chk"><input type="checkbox" id="orgAccessEditLicenseAdmin"/> License manager — manage who is assigned a seat</label>
            <label class="org-add-delegated-perms__chk"><input type="checkbox" id="orgAccessEditReportAdmin"/> Report manager — Word report template for the organisation</label>
            <label class="org-add-delegated-perms__chk"><input type="checkbox" id="orgAccessEditAiModelAdmin"/> AI model admin — organisation AI provider and model settings</label>
            <label class="org-add-delegated-perms__chk"><input type="checkbox" id="orgAccessEditPromptAdmin"/> Prompt manager — extra guidance for scan steps</label>
            <label class="org-add-delegated-perms__chk"><input type="checkbox" id="orgAccessEditProjectManager"/> Project manager — set your organisation’s reference ID on evaluations shared with the organisation (for integrations)</label>
          </div>
        </div>
        <div class="sub-form__actions">
          <button type="submit" class="btn btn-primary" id="orgAccessDialogSubmit">Add</button>
          <button type="button" class="transparent" id="orgAccessEditCancel">Cancel</button>
        </div>
      </form>
    </div>
  </dialog>
  <% } %>
  <% if (organisation.subscription.subscriptionActive && organisation.myMembership.canManageReportTemplate) { %>
    <div class="content-block <%= (orgMainStripe++ % 2 === 0) ? 'white' : 'light-blue' %> org-report-template-section">
      <h2>Report template (Word export)</h2>
      <p class="small">Upload a <code>.docx</code> that includes every <strong>required</strong> CARE placeholder <code>{{…}}</code> (see the <a href="/docs/report-template" target="_blank">report template guide</a> for the full list and optional keys). The key <code>unintendedConsequneces</code> must be spelled exactly. Generated table headers and AI/glossary labels use the accent colour taken from your template (Heading&nbsp;1 colour, or theme accent if Heading&nbsp;1 has no colour). Organisation admins and report managers can change this template.</p>
      <p class="small">
        Need help creating one?
        <a href="/docs/report-template" target="_blank">Report template guide</a>
      </p>
      <div id="orgReportTemplateMessage" class="alert" style="display:none;"></div>
      <p id="orgReportTemplateStatus" class="small"></p>
      <div id="orgReportTemplateVersionsWrap" class="org-dt-wrap" style="margin-top:1rem;">
        <table class="display org-dt-table" style="width:100%" id="orgReportTemplateVersionsTable">
          <thead>
            <tr>
              <th>Template file</th>
              <th>Uploaded</th>
              <th>Detected theme colour</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="orgReportTemplateVersionsBody"></tbody>
        </table>
      </div>
      <p style="margin-top:1rem;">
        <button type="button" class="btn btn-primary" id="orgReportTemplateAddBtn">Add template</button>
      </p>
    </div>
    <dialog id="orgReportTemplateUploadDialog" class="org-access-edit-dialog">
      <div class="content-block white">
        <h2 style="margin-top:0;">Add report template</h2>
        <p class="small">Choose a <code>.docx</code> file or drag it into the drop area.</p>
        <div id="orgReportTemplateUploadModalMsg" class="alert" style="display:none;"></div>
        <div id="orgReportTemplateUploadMissingKeys" class="small" style="display:none;color:#c00;"></div>
        <form id="orgReportTemplateUploadForm" novalidate>
          <input
            type="file"
            id="orgReportTemplateFile"
            accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            style="display:none;"
          />
          <div
            id="orgReportTemplateDropZone"
            style="border:2px dashed #9aa8b6;border-radius:8px;padding:1rem;text-align:center;background:#f8fbff;margin:0.5rem 0 1rem;"
          >
            <p style="margin:0 0 0.4rem;">Drop a <code>.docx</code> file here</p>
            <p class="small" style="margin:0 0 0.75rem;">or</p>
            <button type="button" class="transparent" id="orgReportTemplateBrowseBtn">Select file</button>
            <p id="orgReportTemplateChosenFile" class="small" style="margin:0.65rem 0 0;">No file selected</p>
          </div>
          <div class="sub-form__actions">
            <button type="submit" class="btn btn-primary" id="orgReportTemplateUploadBtn">Upload template</button>
            <button type="button" class="transparent" id="orgReportTemplateUploadCancelBtn">Cancel</button>
          </div>
        </form>
      </div>
    </dialog>
    <script>
    window.__orgReportTemplateData = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(organisation.subscription.reportTemplate || {})) %>'));
    </script>
    <% } %>

  <% if (organisation.subscription.subscriptionActive && organisation.myMembership.canManageAiModel) { %>
  <div class="content-block <%= (orgMainStripe++ % 2 === 0) ? 'white' : 'light-blue' %> org-ai-content-block">
    <h2>Organisation AI</h2>
    <p class="small">Configure a model for all licensed users in the organisation. They use it by default on evaluation steps; each step can switch to CARE built-in. Choose a provider first, then complete the fields shown. Keys are stored on the subscription. Only organisation admins and AI model admins can change these settings.</p>
    <div id="orgAiMessage" class="alert" style="display:none;"></div>
    <form id="orgAiConfigForm" class="org-ai-config-form">
      <label class="org-ai-config-form__check">
        <input type="checkbox" id="orgAiEnabled" name="enabled" value="1"/>
        Enable organisation AI for licensed users (when off, everyone uses server defaults only)
      </label>
      <div id="orgAiFields" class="org-ai-config-form__fields" style="display:none;">
        <label class="org-ai-config-form__row org-ai-config-form__row--provider">
          <span class="org-ai-config-form__label-text">Provider <span class="org-ai-req">(required)</span></span>
          <select id="orgAiProvider" class="input inputText" aria-describedby="orgAiProviderHint">
            <option value="">Choose a provider…</option>
            <option value="openai">OpenAI (official API)</option>
            <option value="openai_compatible">OpenAI-compatible (Groq, LiteLLM, proxy, …)</option>
            <option value="anthropic">Anthropic (Claude)</option>
            <option value="google">Google (Gemini)</option>
            <option value="gemini">Gemini (alias)</option>
            <option value="azure_openai">Azure OpenAI</option>
            <option value="azure">Azure (alias)</option>
          </select>
        </label>
        <p id="orgAiProviderHint" class="small org-ai-provider-hint" role="note" hidden></p>

        <div class="org-ai-field-group" data-org-ai-providers="openai openai_compatible anthropic google gemini azure_openai azure">
          <label class="org-ai-config-form__row">
            <span class="org-ai-config-form__label-text">API key <span class="org-ai-req">(required)</span></span>
            <input type="password" id="orgAiApiKey" class="input inputText" autocomplete="off" placeholder="Leave blank to keep existing key"/>
          </label>
        </div>
        <div class="org-ai-field-group" data-org-ai-providers="openai openai_compatible anthropic google gemini azure_openai azure">
          <label class="org-ai-config-form__row">
            <span class="org-ai-config-form__label-text">Model <span class="org-ai-req">(required)</span></span>
            <input type="text" id="orgAiModel" class="input inputText" placeholder="e.g. gpt-4o-mini, claude-3-5-sonnet-20241022, gemini-1.5-flash"/>
          </label>
        </div>
        <div class="org-ai-field-group" data-org-ai-providers="openai_compatible azure_openai azure">
          <label class="org-ai-config-form__row">
            <span class="org-ai-config-form__label-text">Base URL <span class="org-ai-req">(required)</span></span>
            <input type="url" id="orgAiBaseURL" class="input inputText" placeholder="https://… (deployment or proxy endpoint)"/>
          </label>
        </div>
        <div class="org-ai-field-group" data-org-ai-providers="openai openai_compatible anthropic google gemini azure_openai azure">
          <label class="org-ai-config-form__row">
            <span class="org-ai-config-form__label-text">Max output tokens <span class="org-ai-opt">(optional)</span></span>
            <input type="number" id="orgAiMaxTokens" class="input inputText" min="1" step="1" placeholder="8192"/>
          </label>
        </div>
        <div class="org-ai-field-group" data-org-ai-providers="openai_compatible azure_openai azure">
          <label class="org-ai-config-form__row">
            <span class="org-ai-config-form__label-text">OpenAI API version <span class="org-ai-opt">(optional)</span></span>
            <input type="text" id="orgAiOpenaiApiVersion" class="input inputText" placeholder="Azure: api-version value"/>
          </label>
          <label class="org-ai-config-form__row org-ai-config-form__row--check">
            <input type="checkbox" id="orgAiUseApiKeyHeader" value="1"/>
            <span>Send key as <code>api-key</code> header (typical for Azure)</span>
          </label>
        </div>
        <div class="org-ai-field-group" data-org-ai-providers="anthropic">
          <label class="org-ai-config-form__row">
            <span class="org-ai-config-form__label-text">Anthropic API base URL <span class="org-ai-opt">(optional)</span></span>
            <input type="url" id="orgAiAnthropicBaseUrl" class="input inputText" placeholder="Default: https://api.anthropic.com"/>
          </label>
        </div>
        <div class="org-ai-field-group" data-org-ai-providers="anthropic">
          <label class="org-ai-config-form__row org-ai-config-form__row--check">
            <input type="checkbox" id="orgAiReasoningEnabled" value="1"/>
            <span>Enable extended reasoning (Anthropic only)</span>
          </label>
          <label class="org-ai-config-form__row">
            <span class="org-ai-config-form__label-text">Reasoning depth</span>
            <select id="orgAiReasoningLevel" class="input inputText">
              <option value="minimal">Minimal</option>
              <option value="standard" selected>Standard</option>
              <option value="extensive">Extensive</option>
            </select>
          </label>
          <p class="small">
            Extensive allows Claude to spend more tokens on internal reasoning. It does not guarantee longer or better answers, only more flexibility for complex cases.
          </p>
        </div>
        <div class="org-ai-field-group" data-org-ai-providers="google gemini">
          <label class="org-ai-config-form__row">
            <span class="org-ai-config-form__label-text">Google AI base URL <span class="org-ai-opt">(optional)</span></span>
            <input type="url" id="orgAiGoogleBaseUrl" class="input inputText" placeholder="Default generativelanguage.googleapis.com"/>
          </label>
        </div>
        <div class="org-ai-field-group" data-org-ai-providers="openai openai_compatible anthropic google gemini azure_openai azure">
          <label class="org-ai-config-form__row org-ai-config-form__row--check">
            <input type="checkbox" id="orgAiDisableStructured" value="1"/>
            <span>Disable structured output (plain completion + JSON parse only)</span>
          </label>
        </div>
        <div class="org-ai-field-group" data-org-ai-providers="openai openai_compatible azure_openai azure">
          <label class="org-ai-config-form__row org-ai-config-form__row--check">
            <input type="checkbox" id="orgAiLegacyMaxTokens" value="1"/>
            <span>OpenAI legacy <code>max_tokens</code> parameter</span>
          </label>
        </div>
      </div>
      <div class="org-ai-config-form__actions" id="orgAiActions" style="display:none;">
        <button type="submit" class="btn btn-primary" id="orgAiSaveBtn">Save AI settings</button>
        <button type="button" class="btn btn-primary" id="orgAiTestSaved" style="display:none;">Test saved configuration</button>
        <button type="button" class="transparent" id="orgAiTestForm">Test form values (without saving)</button>
      </div>
    </form>
    <div id="orgAiTestResult" class="org-ai-test-result" hidden>
      <h4>Test result</h4>
      <pre id="orgAiTestResultPre" class="org-ai-test-result__pre"></pre>
    </div>
  </div>
  <% } %>

  <% if (organisation.subscription.subscriptionActive && organisation.myMembership.canManagePromptScanContext) { %>
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
  <div class="content-block <%= (orgMainStripe++ % 2 === 0) ? 'white' : 'light-blue' %> org-scan-context-section">
    <h2>Scan step guidance</h2>
    <p class="small">Define guidance blocks with a <strong>title</strong> and choose whether each block is used for the <strong>AI assistant</strong> (plain text in prompts), <strong>Step guidance</strong> (rich text in the scan help modal), or both. Pick which scan steps each block applies to. Licensed users choose whether to include AI guidance in prompts. Only organisation admins and prompt admins can edit this.</p>
    <div id="orgScanContextMessage" class="alert" style="display:none;"></div>

    <h3 class="org-scan-guidance__subhead">Guidance blocks</h3>
    <div class="org-dt-wrap org-scan-guidance-dt">
    <table class="display org-scan-guidance__table org-dt-table" style="width:100%" id="orgScanGuidanceTable">
      <thead>
        <tr>
          <th>Title</th>
          <th>Audiences</th>
          <th>Applied to steps</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="orgScanGuidanceTableBody"></tbody>
    </table>
    </div>
    <p class="small" id="orgScanGuidanceEmpty" style="display:none;">No guidance blocks yet. Use <strong>Add guidance</strong> to create a block.</p>
    <p class="org-licensed-users__add-bar org-scan-guidance__add-bar">
      <button type="button" class="transparent" id="orgAddScanGuidanceBtn">Add guidance</button>
    </p>

    <h3 class="org-scan-guidance__subhead">Step coverage</h3>
    <p class="small">AI coverage is for assistant prompts. Step guidance coverage is for organisation blocks; when set, org content replaces the CARE default for that step.</p>
    <table class="display org-scan-guidance-coverage" style="width:100%" id="orgScanGuidanceCoverageTable">
      <thead>
        <tr>
          <th>Step</th>
          <th>AI guidance</th>
          <th>Step guidance</th>
        </tr>
      </thead>
      <tbody id="orgScanGuidanceCoverageBody"></tbody>
    </table>
  </div>

  <dialog id="orgScanGuidanceDialog" class="org-access-edit-dialog org-scan-guidance-dialog">
    <div class="content-block white">
      <h2 id="orgScanGuidanceDialogTitle" style="margin-top:0;">Add guidance</h2>
      <div id="orgScanGuidanceModalMsg" class="alert" style="display:none;"></div>
      <form id="orgScanGuidanceModalForm" class="sub-form" novalidate>
        <div class="sub-form__row">
          <label class="sub-form__label" for="orgScanGuidanceTitle">Title</label>
          <div class="sub-form__control">
            <input type="text" id="orgScanGuidanceTitle" class="input inputText" maxlength="200" placeholder="e.g. NHS data handling" autocomplete="off"/>
          </div>
        </div>
        <div class="sub-form__row">
          <span class="sub-form__label">Use for</span>
          <div class="sub-form__control org-scan-guidance-audiences">
            <label class="org-scan-guidance-audiences__chk"><input type="checkbox" id="orgScanGuidanceUseForAi" checked /> AI assistant prompts</label>
            <label class="org-scan-guidance-audiences__chk"><input type="checkbox" id="orgScanGuidanceUseForHuman" /> Step guidance (human)</label>
          </div>
        </div>
        <div class="sub-form__row" id="orgScanGuidanceAiField">
          <label class="sub-form__label" for="orgScanGuidanceContent">AI guidance text</label>
          <div class="sub-form__control">
            <textarea id="orgScanGuidanceContent" class="input inputText org-scan-context-form__textarea" rows="6" maxlength="12000" placeholder="Policies, definitions, or instructions to inject into the prompt…"></textarea>
          </div>
        </div>
        <div class="sub-form__row" id="orgScanGuidanceHumanField" hidden>
          <span class="sub-form__label">Step guidance content</span>
          <div class="sub-form__control">
            <div id="orgScanGuidanceHumanEditor" class="org-scan-guidance-wysiwyg" aria-label="Step guidance content editor"></div>
            <p class="small org-scan-guidance-wysiwyg__hint">Headings, links, and lists are supported. Content is sanitised on save.</p>
            <button type="button" class="transparent" id="orgScanGuidanceLoadTemplate">Load CARE template for first selected step</button>
          </div>
        </div>
        <div class="sub-form__row">
          <span class="sub-form__label">Apply to steps</span>
          <div class="sub-form__control">
            <div id="orgScanGuidanceStageChecks" class="org-scan-guidance-stages__grid org-scan-guidance-stages__grid--modal"></div>
          </div>
        </div>
        <div class="sub-form__actions">
          <button type="submit" class="btn btn-primary" id="orgScanGuidanceDialogSubmit">Add</button>
          <button type="button" class="transparent" id="orgScanGuidanceDialogCancel">Cancel</button>
        </div>
      </form>
    </div>
  </dialog>
  <% } %>

  <dialog id="orgColumnFilterDialog" class="org-access-edit-dialog org-column-filter-dialog">
    <div class="content-block white">
      <h2 id="orgColumnFilterDialogTitle" style="margin-top:0;">Column filter</h2>
      <p class="small" id="orgColumnFilterDialogLead"></p>
      <form id="orgColumnFilterForm" class="sub-form">
        <input type="hidden" id="orgColumnFilterWhich" value=""/>
        <div class="sub-form__row">
          <span class="sub-form__label" id="orgColumnFilterChecksLabel">Match any of</span>
          <div class="sub-form__control">
            <fieldset id="orgColumnFilterFieldset" class="org-column-filter-checks"></fieldset>
          </div>
        </div>
        <div class="sub-form__actions">
          <button type="submit" class="btn btn-primary">Apply</button>
          <button type="button" class="transparent" id="orgColumnFilterClear">Clear filter</button>
          <button type="button" class="transparent" id="orgColumnFilterCancel">Cancel</button>
        </div>
      </form>
    </div>
  </dialog>

  <% if (organisation.subscription.subscriptionActive && organisation.myMembership.isOrganisationAdmin) { %>
  <div class="content-block <%= (orgMainStripe++ % 2 === 0) ? 'white' : 'light-blue' %> org-integration-api-section" id="orgIntegrationApiSection" data-tenant-id="<%= organisation.tenantId %>">
    <h2>Integrations API</h2>
    <p class="small">Read-only JSON for evaluations <strong>shared with your organisation</strong>. Use the <strong>Tenant ID</strong> and a key below; send <code>Accept: application/json</code> on every request.</p>
    <ul class="small org-integration-api-doc-links">
      <li><a href="/docs/tenant-integration">Developer documentation</a> — guide, IDs, cookbook link, and interactive API reference (generated from OpenAPI)</li>
      <li><a href="/docs/tenant-integration-openapi.yaml">OpenAPI specification (YAML)</a> — machine-readable contract for tools and codegen</li>
      <li><a href="/docs/tenant-integration-zapier.md">Zapier / Make / n8n cookbook</a> (Markdown)</li>
    </ul>
    <div id="orgIntegrationApiMsg" class="alert" style="display:none;"></div>
    <p>
      <span class="org-integration-label">Tenant ID</span>
      <code id="orgIntegrationTenantIdDisplay"><%= organisation.tenantId %></code>
      <button type="button" class="transparent org-integration-copy-btn" id="orgIntegrationCopyTenantId">Copy</button>
    </p>
    <p>
      <span class="org-integration-label">Projects list URL</span><br/>
      <input type="text" readonly class="input inputText org-integration-url-field" id="orgIntegrationBaseUrlField" value="" aria-label="Base URL for projects list"/>
    </p>
    <h3 class="org-integration-subhead">Integration keys</h3>
    <p class="org-licensed-users__add-bar org-integration-keys__add-bar">
      <button type="button" class="transparent" id="orgAddIntegrationKeyBtn">Create integration key</button>
    </p>
    <table class="display org-integration-keys-table" style="width:100%">
      <thead>
        <tr>
          <th>Prefix</th>
          <th>Label</th>
          <th>Created</th>
          <th>Last used</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="orgIntegrationKeysBody"></tbody>
    </table>
  </div>

  <dialog id="orgIntegrationKeyDialog" class="org-access-edit-dialog org-integration-key-dialog">
    <div class="content-block white">
      <h2 id="orgIntegrationKeyDialogTitle" style="margin-top:0;">Create integration key</h2>
      <div id="orgIntegrationKeyModalMsg" class="alert" style="display:none;"></div>
      <div id="orgIntegrationKeyStepCreate">
        <form id="orgIntegrationKeyForm" class="sub-form" novalidate>
          <div class="sub-form__row">
            <label class="sub-form__label" for="orgIntegrationKeyModalLabel">Label</label>
            <div class="sub-form__control">
              <input type="text" id="orgIntegrationKeyModalLabel" class="input inputText" maxlength="120" placeholder="e.g. Zapier production" autocomplete="off"/>
              <p class="sub-form__hint">Shown in the keys list so you can tell integrations apart.</p>
            </div>
          </div>
          <div class="sub-form__actions">
            <button type="submit" class="btn btn-primary" id="orgIntegrationKeySubmitBtn">Create key</button>
            <button type="button" class="transparent" id="orgIntegrationKeyCancelBtn">Cancel</button>
          </div>
        </form>
      </div>
      <div id="orgIntegrationKeyStepReveal" hidden>
        <p class="small"><strong>Copy this key now.</strong> You will not be able to see it again after you close this dialog.</p>
        <div class="sub-form__row">
          <label class="sub-form__label" for="orgIntegrationKeyRevealValue">Secret key</label>
          <div class="sub-form__control">
            <input type="text" readonly class="input inputText org-integration-key-reveal-input" id="orgIntegrationKeyRevealValue" value="" aria-label="New integration API key"/>
          </div>
        </div>
        <div class="sub-form__actions">
          <button type="button" class="btn btn-primary" id="orgIntegrationKeyCopyRevealBtn">Copy key</button>
          <button type="button" class="transparent" id="orgIntegrationKeyDoneBtn">Done</button>
        </div>
      </div>
    </div>
  </dialog>

  <script>
  window.__orgIntegrationInitialKeys = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(organisation.subscription.integrationApiKeys || [])) %>'));
  </script>
  <% } %>

  <% } %>
</div>
<% if (organisation) { %>
<script src="/lib/DataTables/datatables.min.js"></script>
<script>
(function () {
  if (!Array.isArray(window.__orgLicensedPermFilters)) {
    window.__orgLicensedPermFilters = [];
  }
  if (!Array.isArray(window.__orgGuidanceStepsFilters)) {
    window.__orgGuidanceStepsFilters = [];
  }

  if (typeof jQuery !== 'undefined' && jQuery.fn.dataTable && !window.__orgColFilterSearchRegistered) {
    window.__orgColFilterSearchRegistered = true;
    jQuery.fn.dataTable.ext.search.push(function (settings, data /*, dataIndex */) {
      var tbl = settings.nTable;
      if (!tbl || !tbl.id) return true;
      if (tbl.id === 'licensedUsersTable') {
        var f = window.__orgLicensedPermFilters;
        if (!f || f.length === 0) return true;
        var cell = data[3] != null ? String(data[3]) : '';
        for (var i = 0; i < f.length; i++) {
          if (f[i] && cell.indexOf(f[i]) !== -1) return true;
        }
        return false;
      }
      if (tbl.id === 'orgScanGuidanceTable') {
        var g = window.__orgGuidanceStepsFilters;
        if (!g || g.length === 0) return true;
        var cellSteps = data[2] != null ? String(data[2]) : '';
        for (var j = 0; j < g.length; j++) {
          if (g[j] && cellSteps.indexOf(g[j]) !== -1) return true;
        }
        return false;
      }
      return true;
    });
  }

  function orgDataTableBaseConfig(extra) {
    var o = {
      layout: {
        topStart: null,
        topEnd: 'search',
        bottomStart: ['pageLength', 'info'],
        bottomEnd: 'paging',
      },
      pageLength: 10,
      lengthMenu: [
        [10, 25, 50, 100, -1],
        [10, 25, 50, 100, 'All'],
      ],
      order: [[0, 'asc']],
      autoWidth: false,
      language: {
        search: 'Search:',
        lengthMenu: 'Show _MENU_ rows',
        info: 'Showing _START_ to _END_ of _TOTAL_',
        infoEmpty: 'No rows',
        zeroRecords: 'No matching rows',
        paginate: { next: 'Next', previous: 'Previous' },
      },
    };
    if (extra && extra.columnDefs) {
      o.columnDefs = extra.columnDefs;
    }
    if (extra && extra.layout) {
      for (var lk in extra.layout) {
        if (Object.prototype.hasOwnProperty.call(extra.layout, lk)) {
          o.layout[lk] = extra.layout[lk];
        }
      }
    }
    if (extra && extra.initComplete) {
      var userInit = extra.initComplete;
      o.initComplete = function () {
        userInit.call(this);
      };
    }
    return o;
  }

  function orgAttachColumnFilterBtn(api, colIdx, which) {
    var $th = jQuery(api.column(colIdx).header());
    $th.addClass('org-dt-th-filterable');
    var $host = $th.find('.dt-column-header');
    if (!$host.length) {
      $host = $th;
    }
    $host.find('.org-dt-col-filter-btn').remove();
    var $btn = jQuery(
      '<button type="button" class="org-dt-col-filter-btn" data-org-filter-which="' +
        which +
        '" aria-label="Filter this column" title="Filter">' +
        '<svg class="org-dt-filter-icon" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="org-dt-filter-icon-shape" d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/></svg>' +
        '</button>'
    );
    $host.append($btn);
  }

  function orgUpdateColFilterBtnActive(which, active) {
    jQuery('.org-dt-col-filter-btn[data-org-filter-which="' + which + '"]').toggleClass(
      'org-dt-col-filter-btn--active',
      !!active
    );
  }

  function populateOrgColumnFilterChecks(which) {
    var fs = document.getElementById('orgColumnFilterFieldset');
    if (!fs) return;
    fs.innerHTML = '';
    var current =
      which === 'licensedUsers'
        ? window.__orgLicensedPermFilters || []
        : window.__orgGuidanceStepsFilters || [];
    var chosen = {};
    current.forEach(function (x) {
      if (x) chosen[x] = true;
    });
    function addRow(value, labelText, rowIdx) {
      var idSafe = String(value).replace(/[^a-zA-Z0-9_-]/g, '_').slice(0, 64);
      var id = 'orgColFilt_' + which + '_' + rowIdx + '_' + idSafe;
      var lab = document.createElement('label');
      lab.className = 'org-column-filter-checks__row';
      var inp = document.createElement('input');
      inp.type = 'checkbox';
      inp.value = value;
      inp.id = id;
      inp.checked = !!chosen[value];
      lab.appendChild(inp);
      lab.appendChild(document.createTextNode(' ' + labelText));
      fs.appendChild(lab);
    }
    if (which === 'licensedUsers') {
      var permOpts = [
        { v: 'Organisation admin (full access)', t: 'Organisation admin (full access)' },
        { v: 'License manager', t: 'License manager' },
        { v: 'Report manager', t: 'Report manager' },
        { v: 'AI model admin', t: 'AI model admin' },
        { v: 'Prompt manager', t: 'Prompt manager' },
        { v: '—', t: 'No extra permissions' },
      ];
      permOpts.forEach(function (row, i) {
        addRow(row.v, row.t, i);
      });
    } else if (which === 'guidance') {
      (window.__orgGuidanceStageOptionsForFilter || []).forEach(function (row, i) {
        addRow(row.value, row.text, i);
      });
    }
  }

  function collectOrgColumnFilterChecks() {
    var fs = document.getElementById('orgColumnFilterFieldset');
    if (!fs) return [];
    var out = [];
    fs.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
      if (cb.checked && cb.value) out.push(cb.value);
    });
    return out;
  }

  function uncheckOrgColumnFilterFieldset() {
    var fs = document.getElementById('orgColumnFilterFieldset');
    if (!fs) return;
    fs.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
      cb.checked = false;
    });
  }

  function openOrgColumnFilterDialog(which) {
    var dlg = document.getElementById('orgColumnFilterDialog');
    if (!dlg) return;
    document.getElementById('orgColumnFilterWhich').value = which;
    var titleEl = document.getElementById('orgColumnFilterDialogTitle');
    var leadEl = document.getElementById('orgColumnFilterDialogLead');
    if (which === 'licensedUsers') {
      titleEl.textContent = 'Filter: Additional permissions';
      leadEl.textContent =
        'Tick any permissions that a row may include. Rows are shown if they match at least one tick (OR). Leave none ticked to show everyone.';
    } else {
      titleEl.textContent = 'Filter: Applied to steps';
      leadEl.textContent =
        'Tick any steps. Rows are shown if they apply to at least one ticked step (OR). Leave none ticked to show all blocks.';
    }
    populateOrgColumnFilterChecks(which);
    if (typeof dlg.showModal === 'function') dlg.showModal();
  }

  window.__orgDtBaseConfig = orgDataTableBaseConfig;
  window.__orgGuidanceStageOptionsForFilter = [];
  window.__orgAttachGuidanceColumnFilter = function (dtApi) {
    orgAttachColumnFilterBtn(dtApi, 2, 'guidance');
    orgUpdateColFilterBtnActive(
      'guidance',
      (window.__orgGuidanceStepsFilters || []).length > 0
    );
  };

  if (typeof jQuery !== 'undefined') {
    jQuery(document).on('click', '.org-dt-col-filter-btn', function (e) {
      e.preventDefault();
      e.stopPropagation();
      var which = jQuery(this).attr('data-org-filter-which');
      if (which) openOrgColumnFilterDialog(which);
    });
  }

  var filterDlg = document.getElementById('orgColumnFilterDialog');
  var filterForm = document.getElementById('orgColumnFilterForm');
  var filterClear = document.getElementById('orgColumnFilterClear');
  var filterCancel = document.getElementById('orgColumnFilterCancel');
  if (filterForm && filterDlg) {
    filterForm.addEventListener('submit', function (ev) {
      ev.preventDefault();
      var which = document.getElementById('orgColumnFilterWhich').value;
      var picked = collectOrgColumnFilterChecks();
      if (which === 'licensedUsers' && window.__orgDtLicensed) {
        window.__orgLicensedPermFilters = picked;
        window.__orgDtLicensed.column(3).search('', false, true);
        window.__orgDtLicensed.draw();
        orgUpdateColFilterBtnActive('licensedUsers', picked.length > 0);
      } else if (which === 'guidance' && window.__orgDtGuidance) {
        window.__orgGuidanceStepsFilters = picked;
        window.__orgDtGuidance.column(2).search('', false, true);
        window.__orgDtGuidance.draw();
        orgUpdateColFilterBtnActive('guidance', picked.length > 0);
      }
      filterDlg.close();
    });
    if (filterClear) {
      filterClear.addEventListener('click', function () {
        var which = document.getElementById('orgColumnFilterWhich').value;
        if (which === 'licensedUsers' && window.__orgDtLicensed) {
          window.__orgLicensedPermFilters = [];
          window.__orgDtLicensed.column(3).search('', false, true);
          window.__orgDtLicensed.draw();
          orgUpdateColFilterBtnActive('licensedUsers', false);
        } else if (which === 'guidance' && window.__orgDtGuidance) {
          window.__orgGuidanceStepsFilters = [];
          window.__orgDtGuidance.column(2).search('', false, true);
          window.__orgDtGuidance.draw();
          orgUpdateColFilterBtnActive('guidance', false);
        }
        uncheckOrgColumnFilterFieldset();
        filterDlg.close();
      });
    }
    if (filterCancel) {
      filterCancel.addEventListener('click', function () {
        filterDlg.close();
      });
    }
    filterDlg.addEventListener('click', function (ev) {
      if (ev.target === filterDlg) filterDlg.close();
    });
  }

  var $lu = typeof jQuery !== 'undefined' ? jQuery('#licensedUsersTable') : null;
  if ($lu && $lu.length && jQuery.fn.DataTable) {
    var thCount = $lu.find('thead th').length;
    var defs = [];
    if (thCount >= 5) {
      defs.push({ targets: thCount - 1, orderable: false, searchable: false });
    }
    var dtLu = $lu.DataTable(
      orgDataTableBaseConfig({
        columnDefs: defs,
        initComplete: function () {
          this.api().column(3).search('', false, true);
          orgAttachColumnFilterBtn(this.api(), 3, 'licensedUsers');
          orgUpdateColFilterBtnActive(
            'licensedUsers',
            (window.__orgLicensedPermFilters || []).length > 0
          );
        },
      })
    );
    window.__orgDtLicensed = dtLu;
  }
})();

(function () {
  var aiForm = document.getElementById('orgAiConfigForm');
  if (!aiForm) return;
  function showOrgAiMsg(text, isError) {
    var el = document.getElementById('orgAiMessage');
    if (!el) return;
    el.style.display = 'block';
    el.textContent = text;
    el.style.color = isError ? '#c00' : '';
  }
  var PROVIDER_HINTS = {
    openai: 'Official OpenAI API: API key and model id (e.g. gpt-4o-mini). Base URL is not used.',
    openai_compatible: 'Groq, LiteLLM, local proxies, etc. Base URL, API key, and model are required.',
    anthropic: 'Anthropic Claude: API key and model id. Optional: custom API base URL.',
    google: 'Google Gemini (Google AI): API key and model id. Optional: custom API base URL.',
    gemini: 'Same wire format as Google Gemini.',
    azure_openai: 'Azure OpenAI: resource endpoint as Base URL, API key, deployment name as model, and usually API version.',
    azure: 'Same as Azure OpenAI.'
  };

  function providerShowsGroup(el, p) {
    var list = (el.getAttribute('data-org-ai-providers') || '').trim().split(/\s+/).filter(Boolean);
    return p && list.indexOf(p) !== -1;
  }

  function syncOrgAiProviderUI() {
    var p = document.getElementById('orgAiProvider').value;
    document.querySelectorAll('#orgAiFields .org-ai-field-group').forEach(function (el) {
      el.style.display = providerShowsGroup(el, p) ? 'block' : 'none';
    });
    var hint = document.getElementById('orgAiProviderHint');
    if (hint) {
      if (!p) {
        hint.textContent = 'Select a provider to see the fields required for that service.';
      } else {
        hint.textContent = PROVIDER_HINTS[p] || '';
      }
      hint.hidden = !hint.textContent;
    }
  }

  /** Last masked config from GET / PUT — drives “Test saved” visibility (persisted state only). */
  var lastServerOrgAiCfg = null;

  function orgAiHasTestSavedEligible(cfg) {
    if (!cfg || !cfg.enabled || !cfg.apiKeySet || !cfg.provider || !cfg.model) return false;
    var p = String(cfg.provider);
    if (p === 'openai_compatible' || p === 'azure_openai' || p === 'azure') {
      return !!(cfg.baseURL && String(cfg.baseURL).trim());
    }
    return true;
  }

  function syncOrgAiActionButtons() {
    var enabledChk = document.getElementById('orgAiEnabled');
    var wrap = document.getElementById('orgAiActions');
    var saveBtn = document.getElementById('orgAiSaveBtn');
    var testFormBtn = document.getElementById('orgAiTestForm');
    var testSavedBtn = document.getElementById('orgAiTestSaved');
    if (!enabledChk || !wrap) return;
    var on = enabledChk.checked;
    var canSaveDisable = !!(lastServerOrgAiCfg && lastServerOrgAiCfg.enabled);
    var showActions = on || canSaveDisable;

    wrap.style.display = showActions ? '' : 'none';
    if (!showActions) return;

    if (saveBtn) saveBtn.style.display = '';

    // Testing options only make sense when the checkbox is enabled.
    if (testFormBtn) testFormBtn.style.display = on ? '' : 'none';
    if (testSavedBtn) {
      testSavedBtn.style.display = on && orgAiHasTestSavedEligible(lastServerOrgAiCfg) ? '' : 'none';
    }
  }

  function toggleOrgAiFields() {
    var on = document.getElementById('orgAiEnabled') && document.getElementById('orgAiEnabled').checked;
    var box = document.getElementById('orgAiFields');
    if (box) {
      box.style.display = on ? 'block' : 'none';
      if (on) syncOrgAiProviderUI();
    }
    syncOrgAiActionButtons();
  }

  function fillOrgAiForm(cfg) {
    if (!cfg) return;
    lastServerOrgAiCfg = cfg;
    document.getElementById('orgAiEnabled').checked = !!cfg.enabled;
    document.getElementById('orgAiProvider').value = cfg.provider ? String(cfg.provider) : '';
    document.getElementById('orgAiModel').value = cfg.model || '';
    document.getElementById('orgAiBaseURL').value = cfg.baseURL || '';
    document.getElementById('orgAiMaxTokens').value = cfg.maxTokens != null ? cfg.maxTokens : '';
    document.getElementById('orgAiOpenaiApiVersion').value = cfg.openaiApiVersion || '';
    document.getElementById('orgAiUseApiKeyHeader').checked = !!cfg.useApiKeyHeader;
    document.getElementById('orgAiAnthropicBaseUrl').value = cfg.anthropicBaseUrl || '';
    document.getElementById('orgAiGoogleBaseUrl').value = cfg.googleBaseUrl || '';
    document.getElementById('orgAiDisableStructured').checked = !!cfg.disableStructuredOutput;
    document.getElementById('orgAiLegacyMaxTokens').checked = !!cfg.openaiUseLegacyMaxTokens;
    var rEn = document.getElementById('orgAiReasoningEnabled');
    var rLev = document.getElementById('orgAiReasoningLevel');
    if (rEn) rEn.checked = !!cfg.reasoningEnabled;
    if (rLev) {
      var v = cfg.reasoningLevel || 'standard';
      if (['minimal', 'standard', 'extensive'].indexOf(v) === -1) v = 'standard';
      rLev.value = v;
    }
    document.getElementById('orgAiApiKey').value = '';
    document.getElementById('orgAiApiKey').placeholder = cfg.apiKeySet
      ? 'Leave blank to keep existing key'
      : 'Required when enabling';
    toggleOrgAiFields();
    if (document.getElementById('orgAiEnabled').checked) {
      syncOrgAiProviderUI();
    }
  }
  function collectOrgAiPayload(forTestUnsaved) {
    var enabled = document.getElementById('orgAiEnabled').checked;
    var body = { enabled: enabled };
    if (!enabled && !forTestUnsaved) return body;
    if (!enabled && forTestUnsaved) {
      body.useSaved = false;
      return body;
    }
    var p = document.getElementById('orgAiProvider').value;
    body.provider = p;
    body.model = document.getElementById('orgAiModel').value.trim();
    var key = document.getElementById('orgAiApiKey').value.trim();
    if (key) body.apiKey = key;
    if (needsBaseUrlProvider(p)) {
      var b = document.getElementById('orgAiBaseURL').value.trim();
      if (b) body.baseURL = b;
    }
    var mt = document.getElementById('orgAiMaxTokens').value.trim();
    if (mt) body.maxTokens = parseInt(mt, 10);
    if (p === 'openai_compatible' || p === 'azure_openai' || p === 'azure') {
      var v = document.getElementById('orgAiOpenaiApiVersion').value.trim();
      if (v) body.openaiApiVersion = v;
      body.useApiKeyHeader = document.getElementById('orgAiUseApiKeyHeader').checked;
    }
    if (p === 'anthropic') {
      var ab = document.getElementById('orgAiAnthropicBaseUrl').value.trim();
      if (ab) body.anthropicBaseUrl = ab;
      var rEn = document.getElementById('orgAiReasoningEnabled');
      var rLev = document.getElementById('orgAiReasoningLevel');
      body.reasoningEnabled = !!(rEn && rEn.checked);
      if (rLev && rLev.value) {
        body.reasoningLevel = rLev.value;
      }
    }
    if (p === 'google' || p === 'gemini') {
      var gb = document.getElementById('orgAiGoogleBaseUrl').value.trim();
      if (gb) body.googleBaseUrl = gb;
    }
    body.disableStructuredOutput = document.getElementById('orgAiDisableStructured').checked;
    if (['openai', 'openai_compatible', 'azure_openai', 'azure'].indexOf(p) !== -1) {
      body.openaiUseLegacyMaxTokens = document.getElementById('orgAiLegacyMaxTokens').checked;
    } else {
      body.openaiUseLegacyMaxTokens = false;
    }
    return body;
  }

  function needsBaseUrlProvider(provider) {
    return (
      provider === 'openai_compatible' ||
      provider === 'azure_openai' ||
      provider === 'azure'
    );
  }

  fetch('/organisation/ai-config', { headers: { Accept: 'application/json' } })
    .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
    .then(function (x) {
      if (!x.ok) throw new Error(x.d.message || 'Could not load AI config');
      fillOrgAiForm(x.d);
    })
    .catch(function (e) {
      showOrgAiMsg(e.message || String(e), true);
      syncOrgAiActionButtons();
    });
  document.getElementById('orgAiEnabled').addEventListener('change', toggleOrgAiFields);
  document.getElementById('orgAiProvider').addEventListener('change', syncOrgAiProviderUI);
  document.getElementById('orgAiConfigForm').addEventListener('submit', function (ev) {
    ev.preventDefault();
    showOrgAiMsg('', false);
    document.getElementById('orgAiMessage').style.display = 'none';
    var body = collectOrgAiPayload(false);
    if (body.enabled) {
      if (!body.provider) {
        showOrgAiMsg('Choose a provider before saving.', true);
        return;
      }
      if (!body.model) {
        showOrgAiMsg('Model is required.', true);
        return;
      }
      if (needsBaseUrlProvider(body.provider) && !body.baseURL) {
        showOrgAiMsg('Base URL is required for this provider.', true);
        return;
      }
    }
    fetch('/organisation/ai-config', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body),
    })
      .then(function (res) {
        return res.json().then(function (data) {
          if (!res.ok) throw new Error(data.message || res.statusText);
          fillOrgAiForm(data.config);
          showOrgAiMsg(data.message || 'Saved', false);
        });
      })
      .catch(function (e) {
        showOrgAiMsg(e.message || String(e), true);
      });
  });
  function runOrgAiTest(payload) {
    var pre = document.getElementById('orgAiTestResultPre');
    var wrap = document.getElementById('orgAiTestResult');
    pre.textContent = 'Running…';
    wrap.hidden = false;
    fetch('/organisation/ai-config/test', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(function (res) {
        return res.json().then(function (data) {
          if (!res.ok) throw new Error(data.message || res.statusText);
          pre.textContent = JSON.stringify(data, null, 2);
        });
      })
      .catch(function (e) {
        pre.textContent = e.message || String(e);
      });
  }
  document.getElementById('orgAiTestSaved').addEventListener('click', function () {
    runOrgAiTest({ useSaved: true });
  });
  document.getElementById('orgAiTestForm').addEventListener('click', function () {
    var body = collectOrgAiPayload(true);
    body.useSaved = false;
    if (!body.enabled) {
      showOrgAiMsg('Enable organisation AI or use Test saved configuration', true);
      return;
    }
    if (!body.provider) {
      showOrgAiMsg('Choose a provider first.', true);
      return;
    }
    if (!body.model) {
      showOrgAiMsg('Model is required for a test run.', true);
      return;
    }
    if (needsBaseUrlProvider(body.provider) && !body.baseURL) {
      showOrgAiMsg('Base URL is required for this provider.', true);
      return;
    }
    if (!body.apiKey) {
      showOrgAiMsg('Enter an API key to test without saving, or use Test saved configuration', true);
      return;
    }
    runOrgAiTest(body);
  });
})();

(function () {
  var uploadForm = document.getElementById('orgReportTemplateUploadForm');
  if (!uploadForm) return;
  var listBody = document.getElementById('orgReportTemplateVersionsBody');
  var tableWrap = document.getElementById('orgReportTemplateVersionsWrap');
  var uploadDialog = document.getElementById('orgReportTemplateUploadDialog');
  var addBtn = document.getElementById('orgReportTemplateAddBtn');
  var cancelUploadBtn = document.getElementById('orgReportTemplateUploadCancelBtn');
  var browseBtn = document.getElementById('orgReportTemplateBrowseBtn');
  var fileInput = document.getElementById('orgReportTemplateFile');
  var chosenFileEl = document.getElementById('orgReportTemplateChosenFile');
  var dropZone = document.getElementById('orgReportTemplateDropZone');
  var dtRt = null;
  var rtState = { versions: [] };
  var selectedFile = null;

  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function normHex(hex) {
    var h = String(hex || '').trim().replace(/^#/, '');
    return /^[0-9a-fA-F]{6}$/.test(h) ? h.toUpperCase() : '';
  }

  function textColorForHex(hex) {
    var h = normHex(hex);
    if (!h) return '#1a1f2e';
    var r = parseInt(h.slice(0, 2), 16);
    var g = parseInt(h.slice(2, 4), 16);
    var b = parseInt(h.slice(4, 6), 16);
    var yiq = (r * 299 + g * 587 + b * 114) / 1000;
    return yiq >= 140 ? '#1a1f2e' : '#fff';
  }

  function destroyRtTable() {
    if (dtRt && typeof dtRt.destroy === 'function') {
      dtRt.destroy();
      dtRt = null;
    }
  }

  function rebuildRtTable() {
    if (typeof jQuery === 'undefined' || !jQuery.fn.DataTable) return;
    var $t = jQuery('#orgReportTemplateVersionsTable');
    if (!$t.length) return;
    if (jQuery.fn.DataTable.isDataTable($t)) {
      $t.DataTable().destroy();
    }
    if ($t.find('tbody tr').length === 0) return;
    var base = typeof window.__orgDtBaseConfig === 'function' ? window.__orgDtBaseConfig : null;
    if (!base) return;
    dtRt = $t.DataTable(
      base({
        order: [[1, 'desc']],
        columnDefs: [{ targets: 3, orderable: false, searchable: false }],
      })
    );
  }

  function showRtMsg(text, isError) {
    var el = document.getElementById('orgReportTemplateMessage');
    if (!el) return;
    el.style.display = 'block';
    el.textContent = text;
    el.style.color = isError ? '#c00' : '';
  }
  function showUploadModalMsg(text, isError) {
    var el = document.getElementById('orgReportTemplateUploadModalMsg');
    if (!el) return;
    if (!text) {
      el.style.display = 'none';
      el.textContent = '';
      el.style.color = '';
      return;
    }
    el.style.display = 'block';
    el.textContent = text;
    el.style.color = isError ? '#c00' : '';
  }
  function hideUploadModalMsg() {
    showUploadModalMsg('', false);
  }
  function showUploadMissingKeys(keys) {
    var missEl = document.getElementById('orgReportTemplateUploadMissingKeys');
    if (!missEl) return;
    if (Array.isArray(keys) && keys.length) {
      missEl.style.display = 'block';
      missEl.textContent = 'Missing: {{' + keys.join('}}, {{') + '}}';
    } else {
      missEl.style.display = 'none';
      missEl.textContent = '';
    }
  }
  function hideUploadMissingKeys() {
    showUploadMissingKeys([]);
  }
  function clearUploadModalFeedback() {
    hideUploadModalMsg();
    hideUploadMissingKeys();
  }
  function setDropZoneActive(on) {
    if (!dropZone) return;
    dropZone.style.borderColor = on ? '#003057' : '#9aa8b6';
    dropZone.style.background = on ? '#e8f2ff' : '#f8fbff';
  }
  function setSelectedFile(file) {
    selectedFile = file || null;
    if (chosenFileEl) {
      chosenFileEl.textContent = selectedFile
        ? 'Selected: ' + selectedFile.name
        : 'No file selected';
    }
  }
  function openUploadDialog() {
    setSelectedFile(null);
    if (fileInput) fileInput.value = '';
    setDropZoneActive(false);
    clearUploadModalFeedback();
    if (uploadDialog && typeof uploadDialog.showModal === 'function') uploadDialog.showModal();
  }
  function closeUploadDialog() {
    if (uploadDialog && typeof uploadDialog.close === 'function') uploadDialog.close();
  }
  function renderRtStatus() {
    var el = document.getElementById('orgReportTemplateStatus');
    var versions = rtState.versions || [];
    if (!el) return;
    if (versions.length) {
      el.textContent =
        'Custom templates: showing up to the 5 most recent versions. Exports use the most recent version.';
      if (tableWrap) tableWrap.style.display = '';
    } else {
      el.textContent =
        'Exports use the default CARE Word template. Upload a custom .docx above to use your branding.';
      if (tableWrap) tableWrap.style.display = 'none';
    }
  }

  function renderRtVersionsTable() {
    if (!listBody) return;
    destroyRtTable();
    listBody.innerHTML = '';
    var versions = rtState.versions || [];
    if (!versions.length) {
      return;
    }
    versions.forEach(function (v, idx) {
      var uploadedLabel = v.uploadedAt ? new Date(v.uploadedAt).toLocaleString() : '—';
      var currentBadge =
        idx === 0
          ? ' <span style="display:inline-block;margin-left:0.45rem;padding:0.08rem 0.4rem;border-radius:999px;background:#e8f2ff;border:1px solid #b9d3f7;color:#003057;font-size:0.78em;font-weight:600;vertical-align:middle;">Current export template</span>'
          : '';
      var rawHex = normHex(v.accentDetectedHex);
      var hexLabel = rawHex ? '#' + rawHex : '—';
      var swatch = rawHex
        ? '<span style="display:inline-block;min-width:5.4rem;padding:0.14rem 0.5rem;border-radius:4px;border:1px solid rgba(0,0,0,0.2);background:#' +
          rawHex +
          ';color:' +
          textColorForHex(rawHex) +
          ';font-family:monospace;font-size:0.9em;">#' +
          rawHex +
          '</span>'
        : '<span>—</span>';
      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td><a href="/organisation/report-template/' +
        encodeURIComponent(v.id) +
        '">' +
        esc(v.originalName || 'template.docx') +
        '</a>' +
        currentBadge +
        '</td>' +
        '<td data-order="' +
        (v.uploadedAt ? new Date(v.uploadedAt).getTime() : 0) +
        '">' +
        esc(uploadedLabel) +
        '</td>' +
        '<td>' +
        swatch +
        (rawHex ? '' : ' ' + esc(hexLabel)) +
        '</td>' +
        '<td><button type="button" class="transparent orgRtDeleteVersionBtn" data-version-id="' +
        esc(v.id) +
        '">Delete</button></td>';
      listBody.appendChild(tr);
    });
    rebuildRtTable();
  }

  function refreshRtState() {
    return fetch('/organisation/report-template', { headers: { Accept: 'application/json' } })
      .then(function (res) {
        return res.json().then(function (data) {
          if (!res.ok) throw new Error(data.message || res.statusText);
          return data || {};
        });
      })
      .then(function (data) {
        rtState.versions = Array.isArray(data.versions) ? data.versions.slice(0, 5) : [];
        renderRtStatus();
        renderRtVersionsTable();
      });
  }
  var seeded = window.__orgReportTemplateData || {};
  rtState.versions = Array.isArray(seeded.versions) ? seeded.versions.slice(0, 5) : [];
  renderRtStatus();
  renderRtVersionsTable();
  refreshRtState().catch(function (e) {
    showRtMsg(e.message || String(e), true);
  });

  if (addBtn) {
    addBtn.addEventListener('click', openUploadDialog);
  }
  if (cancelUploadBtn) {
    cancelUploadBtn.addEventListener('click', closeUploadDialog);
  }
  if (uploadDialog) {
    uploadDialog.addEventListener('click', function (ev) {
      if (ev.target === uploadDialog) closeUploadDialog();
    });
    uploadDialog.addEventListener('close', function () {
      setDropZoneActive(false);
      setSelectedFile(null);
      if (fileInput) fileInput.value = '';
    });
  }
  if (browseBtn && fileInput) {
    browseBtn.addEventListener('click', function () {
      fileInput.click();
    });
  }
  if (fileInput) {
    fileInput.addEventListener('change', function () {
      var file = fileInput.files && fileInput.files[0];
      setSelectedFile(file || null);
    });
  }
  if (dropZone) {
    dropZone.addEventListener('dragenter', function (ev) {
      ev.preventDefault();
      setDropZoneActive(true);
    });
    dropZone.addEventListener('dragover', function (ev) {
      ev.preventDefault();
      setDropZoneActive(true);
    });
    dropZone.addEventListener('dragleave', function (ev) {
      ev.preventDefault();
      if (ev.target === dropZone) setDropZoneActive(false);
    });
    dropZone.addEventListener('drop', function (ev) {
      ev.preventDefault();
      setDropZoneActive(false);
      var files = ev.dataTransfer && ev.dataTransfer.files;
      var file = files && files[0];
      if (!file) return;
      setSelectedFile(file);
    });
  }

  uploadForm.addEventListener('submit', function (ev) {
    ev.preventDefault();
    clearUploadModalFeedback();
    var file = selectedFile || (fileInput && fileInput.files && fileInput.files[0]);
    if (!file) {
      showUploadModalMsg('Choose a .docx file first.', true);
      return;
    }
    if (!/\.docx$/i.test(file.name || '')) {
      showUploadModalMsg('Only .docx files are allowed.', true);
      return;
    }
    var fd = new FormData();
    fd.append('reportTemplate', file);
    var btn = document.getElementById('orgReportTemplateUploadBtn');
    if (btn) btn.disabled = true;
    showUploadModalMsg('Uploading…', false);
    fetch('/organisation/report-template', { method: 'POST', body: fd })
      .then(function (res) {
        return res.json().then(function (data) {
          if (!res.ok) {
            showUploadMissingKeys(data.missingKeys);
            throw new Error(data.message || res.statusText);
          }
          if (data.warnings && data.warnings.length) {
            console.warn('Template warnings', data.warnings);
          }
          if (fileInput) fileInput.value = '';
          setSelectedFile(null);
          clearUploadModalFeedback();
          closeUploadDialog();
          return refreshRtState();
        })
        .then(function () {
          showRtMsg('Template uploaded.', false);
        });
      })
      .catch(function (e) {
        showUploadModalMsg(e.message || String(e), true);
      })
      .finally(function () {
        if (btn) btn.disabled = false;
      });
  });

  document.addEventListener('click', function (ev) {
    var btn = ev.target && ev.target.closest ? ev.target.closest('.orgRtDeleteVersionBtn') : null;
    if (!btn) return;
    var versionId = btn.getAttribute('data-version-id') || '';
    if (!versionId) return;
    if (!confirm('Delete this template version?')) return;
    fetch('/organisation/report-template/' + encodeURIComponent(versionId), {
      method: 'DELETE',
      headers: { Accept: 'application/json' },
    })
      .then(function (res) {
        return res.json().then(function (data) {
          if (!res.ok) throw new Error(data.message || res.statusText);
          return refreshRtState();
        });
      })
      .then(function () {
        showRtMsg('Template version deleted.', false);
      })
      .catch(function (e) {
        showRtMsg(e.message || String(e), true);
      });
  });
})();

(function () {
  var dialog = document.getElementById('orgScanGuidanceDialog');
  var modalForm = document.getElementById('orgScanGuidanceModalForm');
  if (!dialog || !modalForm) return;

  var labels = {};
  var stageKeys = [];
  var aiStageKeys = [];
  var humanStageKeys = [];
  var careHumanTemplates = {};
  var items = [];
  var editIndex = null;
  var quillEditor = null;

  function showScanCtxMsg(text, isError) {
    var el = document.getElementById('orgScanContextMessage');
    if (!el) return;
    el.style.display = 'block';
    el.textContent = text;
    el.style.color = isError ? '#c00' : '';
  }

  function showModalMsg(text, isError) {
    var el = document.getElementById('orgScanGuidanceModalMsg');
    if (!el) return;
    el.style.display = 'block';
    el.textContent = text;
    el.style.color = isError ? '#c00' : '';
  }

  function hideModalMsg() {
    var el = document.getElementById('orgScanGuidanceModalMsg');
    if (!el) return;
    el.style.display = 'none';
    el.textContent = '';
    el.style.color = '';
  }

  function labelFor(key) {
    return (labels && labels[key]) || key;
  }

  function syncGuidanceStepsFilterOptions() {
    window.__orgGuidanceStageOptionsForFilter = stageKeys.map(function (k) {
      var lab = labelFor(k);
      return { value: lab, text: lab };
    });
  }

  function rebuildGuidanceDataTable() {
    if (typeof jQuery === 'undefined' || !jQuery.fn.DataTable) return;
    var $t = jQuery('#orgScanGuidanceTable');
    if (!$t.length) return;
    if (jQuery.fn.DataTable.isDataTable($t)) {
      $t.DataTable().destroy();
    }
    if ($t.find('tbody tr').length === 0) {
      window.__orgDtGuidance = null;
      return;
    }
    var base = typeof window.__orgDtBaseConfig === 'function' ? window.__orgDtBaseConfig : null;
    if (!base) return;
    var dt = $t.DataTable(
      base({
        columnDefs: [{ targets: 3, orderable: false, searchable: false }],
        initComplete: function () {
          if (typeof window.__orgAttachGuidanceColumnFilter === 'function') {
            window.__orgAttachGuidanceColumnFilter(this.api());
          }
        },
      })
    );
    window.__orgDtGuidance = dt;
    dt.column(2).search('', false, true);
    dt.draw();
  }

  function renderStageCheckboxes() {
    var host = document.getElementById('orgScanGuidanceStageChecks');
    if (!host) return;
    host.innerHTML = '';
    stageKeys.forEach(function (key) {
      var id = 'orgScanGuidanceStage_' + key;
      var wrap = document.createElement('label');
      wrap.className = 'org-scan-guidance-stages__chk';
      var inp = document.createElement('input');
      inp.type = 'checkbox';
      inp.value = key;
      inp.id = id;
      wrap.appendChild(inp);
      wrap.appendChild(document.createTextNode(' ' + labelFor(key)));
      host.appendChild(wrap);
    });
  }

  function selectedStagesFromEditor() {
    var out = [];
    document.querySelectorAll('#orgScanGuidanceStageChecks input[type="checkbox"]').forEach(function (cb) {
      if (cb.checked) out.push(cb.value);
    });
    return out;
  }

  function setEditorStages(stages) {
    var set = {};
    (stages || []).forEach(function (s) {
      set[s] = true;
    });
    document.querySelectorAll('#orgScanGuidanceStageChecks input[type="checkbox"]').forEach(function (cb) {
      cb.checked = !!set[cb.value];
    });
  }

  function ensureQuillEditor() {
    if (quillEditor) return quillEditor;
    var host = document.getElementById('orgScanGuidanceHumanEditor');
    if (!host || typeof Quill === 'undefined') return null;
    quillEditor = new Quill(host, {
      theme: 'snow',
      modules: {
        toolbar: [
          [{ header: [2, 3, false] }],
          ['bold', 'italic'],
          [{ list: 'ordered' }, { list: 'bullet' }],
          ['link'],
          ['clean'],
        ],
      },
    });
    return quillEditor;
  }

  function setQuillHtml(html) {
    var q = ensureQuillEditor();
    if (!q) return;
    if (!html) {
      q.setText('');
      return;
    }
    q.clipboard.dangerouslyPasteHTML(html);
  }

  function getQuillHtml() {
    var q = ensureQuillEditor();
    if (!q) return '';
    var html = q.root.innerHTML;
    if (html === '<p><br></p>') return '';
    return html;
  }

  function syncAudienceFields() {
    var useAi = document.getElementById('orgScanGuidanceUseForAi');
    var useHuman = document.getElementById('orgScanGuidanceUseForHuman');
    var aiField = document.getElementById('orgScanGuidanceAiField');
    var humanField = document.getElementById('orgScanGuidanceHumanField');
    var aiOn = !!(useAi && useAi.checked);
    var humanOn = !!(useHuman && useHuman.checked);
    if (aiField) aiField.hidden = !aiOn;
    if (humanField) {
      humanField.hidden = !humanOn;
      if (humanOn) ensureQuillEditor();
    }
  }

  function audienceLabel(it) {
    var parts = [];
    if (it.useForAi !== false) parts.push('AI');
    if (it.useForHuman) parts.push('Step guidance');
    return parts.length ? parts.join(', ') : '—';
  }

  function stageCoverageMapsFor(list) {
    var ai = {};
    var human = {};
    aiStageKeys.forEach(function (k) {
      ai[k] = false;
    });
    humanStageKeys.forEach(function (k) {
      human[k] = false;
    });
    (list || []).forEach(function (it) {
      var aiContent = it.useForAi !== false && (it.content || '').trim();
      var humanContent = it.useForHuman && (it.humanContent || '').trim();
      (it.stages || []).forEach(function (s) {
        if (aiContent && ai.hasOwnProperty(s)) ai[s] = true;
        if (humanContent && human.hasOwnProperty(s)) human[s] = true;
      });
    });
    return { ai: ai, human: human };
  }

  function stageCoverageMaps() {
    return stageCoverageMapsFor(items);
  }

  function cloneItems() {
    return items.map(function (it) {
      return {
        title: it.title,
        content: it.content,
        humanContent: it.humanContent || '',
        useForAi: it.useForAi !== false,
        useForHuman: !!it.useForHuman,
        stages: (it.stages || []).slice(),
      };
    });
  }

  function applyRowToClone(baseList, row, editIdx) {
    var next = cloneItems();
    if (editIdx !== null && editIdx >= 0) next[editIdx] = row;
    else next.push(row);
    return next;
  }

  function loadCareTemplateIntoEditor() {
    var stages = selectedStagesFromEditor();
    if (stages.length === 0) {
      showModalMsg('Select at least one step first.', true);
      return;
    }
    var tpl = careHumanTemplates[stages[0]] || '';
    if (!tpl) {
      showModalMsg('No CARE template for the selected step.', true);
      return;
    }
    var useHuman = document.getElementById('orgScanGuidanceUseForHuman');
    if (useHuman) useHuman.checked = true;
    syncAudienceFields();
    setQuillHtml(tpl);
  }

  function mergeServerGuidanceResponse(data) {
    labels = (data && data.labels) || labels;
    stageKeys = Array.isArray(data && data.stageKeys) ? data.stageKeys.slice() : stageKeys;
    aiStageKeys = Array.isArray(data && data.aiStageKeys) ? data.aiStageKeys.slice() : aiStageKeys;
    humanStageKeys = Array.isArray(data && data.humanStageKeys) ? data.humanStageKeys.slice() : humanStageKeys;
    careHumanTemplates =
      data && data.careHumanTemplates && typeof data.careHumanTemplates === 'object'
        ? Object.assign({}, data.careHumanTemplates)
        : careHumanTemplates;
    items = Array.isArray(data && data.items) ? JSON.parse(JSON.stringify(data.items)) : [];
    renderStageCheckboxes();
    syncGuidanceStepsFilterOptions();
    renderTable();
  }

  function renderCoverage() {
    var body = document.getElementById('orgScanGuidanceCoverageBody');
    if (!body) return;
    body.innerHTML = '';
    var cov = stageCoverageMaps();
    var rows = humanStageKeys.slice();
    aiStageKeys.forEach(function (k) {
      if (rows.indexOf(k) === -1) rows.push(k);
    });
    stageKeys.forEach(function (k) {
      if (rows.indexOf(k) === -1) rows.push(k);
    });
    rows.forEach(function (key) {
      var tr = document.createElement('tr');
      var aiOk = cov.ai[key];
      var humanOk = cov.human[key];
      var aiCell = aiStageKeys.indexOf(key) === -1 ? '—' : aiOk ? 'Has guidance' : '<span class="org-scan-guidance-coverage--gap">No guidance yet</span>';
      var humanCell =
        humanStageKeys.indexOf(key) === -1
          ? '—'
          : humanOk
            ? 'Has org guidance'
            : '<span class="org-scan-guidance-coverage--gap">CARE default only</span>';
      tr.innerHTML =
        '<td>' +
        labelFor(key).replace(/</g, '&lt;') +
        '</td><td>' +
        aiCell +
        '</td><td>' +
        humanCell +
        '</td>';
      body.appendChild(tr);
    });
  }

  function renderTable() {
    if (typeof jQuery !== 'undefined' && jQuery.fn.DataTable) {
      var $gt = jQuery('#orgScanGuidanceTable');
      if ($gt.length && jQuery.fn.DataTable.isDataTable($gt)) {
        $gt.DataTable().destroy();
      }
    }
    var body = document.getElementById('orgScanGuidanceTableBody');
    var emptyEl = document.getElementById('orgScanGuidanceEmpty');
    var table = document.getElementById('orgScanGuidanceTable');
    if (!body) return;
    body.innerHTML = '';
    if (items.length === 0) {
      if (emptyEl) emptyEl.style.display = '';
      if (table) table.style.display = 'none';
    } else {
      if (emptyEl) emptyEl.style.display = 'none';
      if (table) table.style.display = '';
      items.forEach(function (it, idx) {
        var title = (it.title || '').trim() || '—';
        var stageLabels = (it.stages || []).map(labelFor).join(', ');
        var audiences = audienceLabel(it);
        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td>' +
          title.replace(/</g, '&lt;') +
          '</td><td>' +
          audiences.replace(/</g, '&lt;') +
          '</td><td>' +
          stageLabels.replace(/</g, '&lt;') +
          '</td><td class="org-scan-guidance__row-actions"></td>';
        var actions = tr.querySelector('.org-scan-guidance__row-actions');
        var editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'transparent';
        editBtn.textContent = 'Edit';
        editBtn.addEventListener('click', function () {
          openEditModal(idx);
        });
        var rmBtn = document.createElement('button');
        rmBtn.type = 'button';
        rmBtn.className = 'transparent';
        rmBtn.textContent = 'Remove';
        rmBtn.addEventListener('click', function () {
          var nextItems = cloneItems();
          nextItems.splice(idx, 1);
          showScanCtxMsg('Saving…', false);
          fetch('/organisation/scan-context', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: nextItems }),
          })
            .then(function (res) {
              return res.json().then(function (data) {
                if (!res.ok) throw new Error(data.message || res.statusText);
                if (editIndex === idx) {
                  editIndex = null;
                  if (dialog.open) dialog.close();
                } else if (editIndex !== null && editIndex > idx) {
                  editIndex -= 1;
                }
                mergeServerGuidanceResponse(data);
                showScanCtxMsg(data.message || 'Saved', false);
              });
            })
            .catch(function (e) {
              showScanCtxMsg(e.message || String(e), true);
              fetch('/organisation/scan-context', { headers: { Accept: 'application/json' } })
                .then(function (r) {
                  return r.json().then(function (d) {
                    return { ok: r.ok, d: d };
                  });
                })
                .then(function (x) {
                  if (x.ok) mergeServerGuidanceResponse(x.d);
                })
                .catch(function () {});
            });
        });
        actions.appendChild(editBtn);
        actions.appendChild(document.createTextNode(' '));
        actions.appendChild(rmBtn);
        body.appendChild(tr);
      });
    }
    renderCoverage();
    rebuildGuidanceDataTable();
  }

  function resetEditor() {
    document.getElementById('orgScanGuidanceTitle').value = '';
    document.getElementById('orgScanGuidanceContent').value = '';
    var useAi = document.getElementById('orgScanGuidanceUseForAi');
    var useHuman = document.getElementById('orgScanGuidanceUseForHuman');
    if (useAi) useAi.checked = true;
    if (useHuman) useHuman.checked = false;
    setQuillHtml('');
    syncAudienceFields();
    setEditorStages([]);
    editIndex = null;
    var titleEl = document.getElementById('orgScanGuidanceDialogTitle');
    var submitBtn = document.getElementById('orgScanGuidanceDialogSubmit');
    if (titleEl) titleEl.textContent = 'Add guidance';
    if (submitBtn) submitBtn.textContent = 'Add';
  }

  function openAddModal() {
    hideModalMsg();
    resetEditor();
    if (typeof dialog.showModal === 'function') dialog.showModal();
  }

  function openEditModal(idx) {
    var it = items[idx];
    if (!it) return;
    hideModalMsg();
    editIndex = idx;
    document.getElementById('orgScanGuidanceTitle').value = it.title || '';
    document.getElementById('orgScanGuidanceContent').value = it.content || '';
    var useAi = document.getElementById('orgScanGuidanceUseForAi');
    var useHuman = document.getElementById('orgScanGuidanceUseForHuman');
    if (useAi) useAi.checked = it.useForAi !== false;
    if (useHuman) useHuman.checked = !!it.useForHuman;
    syncAudienceFields();
    setQuillHtml(it.humanContent || '');
    setEditorStages(it.stages || []);
    var titleEl = document.getElementById('orgScanGuidanceDialogTitle');
    var submitBtn = document.getElementById('orgScanGuidanceDialogSubmit');
    if (titleEl) titleEl.textContent = 'Edit guidance';
    if (submitBtn) submitBtn.textContent = 'Save';
    if (typeof dialog.showModal === 'function') dialog.showModal();
  }

  function closeGuidanceModal() {
    dialog.close();
  }

  function commitGuidanceModal(ev) {
    ev.preventDefault();
    var title = document.getElementById('orgScanGuidanceTitle').value.trim();
    var useAi = document.getElementById('orgScanGuidanceUseForAi');
    var useHuman = document.getElementById('orgScanGuidanceUseForHuman');
    var useForAi = !!(useAi && useAi.checked);
    var useForHuman = !!(useHuman && useHuman.checked);
    var content = useForAi ? document.getElementById('orgScanGuidanceContent').value.trim() : '';
    var humanContent = useForHuman ? getQuillHtml().trim() : '';
    var stages = selectedStagesFromEditor();
    if (!useForAi && !useForHuman) {
      showModalMsg('Select at least one audience (AI assistant or Step guidance).', true);
      return;
    }
    if (useForAi && !content) {
      showModalMsg('AI guidance text is required when AI assistant is selected.', true);
      return;
    }
    if (useForHuman && !humanContent) {
      showModalMsg('Step guidance content is required when Step guidance is selected.', true);
      return;
    }
    if (stages.length === 0) {
      showModalMsg('Select at least one step.', true);
      return;
    }
    var row = {
      title: title,
      content: content,
      humanContent: humanContent,
      useForAi: useForAi,
      useForHuman: useForHuman,
      stages: stages,
    };
    var nextItems = applyRowToClone(cloneItems(), row, editIndex);

    var submitBtn = document.getElementById('orgScanGuidanceDialogSubmit');
    if (submitBtn) submitBtn.disabled = true;
    hideModalMsg();
    showModalMsg('Saving…', false);

    fetch('/organisation/scan-context', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ items: nextItems }),
    })
      .then(function (res) {
        return res.json().then(function (data) {
          if (!res.ok) throw new Error(data.message || res.statusText);
          hideModalMsg();
          mergeServerGuidanceResponse(data);
          dialog.close();
          showScanCtxMsg(data.message || 'Saved', false);
        });
      })
      .catch(function (e) {
        hideModalMsg();
        showModalMsg(e.message || String(e), true);
        fetch('/organisation/scan-context', { headers: { Accept: 'application/json' } })
          .then(function (r) {
            return r.json().then(function (d) {
              return { ok: r.ok, d: d };
            });
          })
          .then(function (x) {
            if (x.ok) mergeServerGuidanceResponse(x.d);
          })
          .catch(function () {});
      })
      .finally(function () {
        if (submitBtn) submitBtn.disabled = false;
      });
  }

  function loadFromServer(d) {
    if (dialog.open) dialog.close();
    labels = (d && d.labels) || {};
    stageKeys = Array.isArray(d && d.stageKeys) ? d.stageKeys.slice() : [];
    aiStageKeys = Array.isArray(d && d.aiStageKeys) ? d.aiStageKeys.slice() : [];
    humanStageKeys = Array.isArray(d && d.humanStageKeys) ? d.humanStageKeys.slice() : [];
    careHumanTemplates =
      d && d.careHumanTemplates && typeof d.careHumanTemplates === 'object'
        ? Object.assign({}, d.careHumanTemplates)
        : {};
    items = Array.isArray(d && d.items) ? JSON.parse(JSON.stringify(d.items)) : [];
    renderStageCheckboxes();
    syncGuidanceStepsFilterOptions();
    renderTable();
  }

  var addBtn = document.getElementById('orgAddScanGuidanceBtn');
  if (addBtn) addBtn.addEventListener('click', openAddModal);

  var useAiEl = document.getElementById('orgScanGuidanceUseForAi');
  var useHumanEl = document.getElementById('orgScanGuidanceUseForHuman');
  if (useAiEl) useAiEl.addEventListener('change', syncAudienceFields);
  if (useHumanEl) useHumanEl.addEventListener('change', syncAudienceFields);
  var loadTplBtn = document.getElementById('orgScanGuidanceLoadTemplate');
  if (loadTplBtn) loadTplBtn.addEventListener('click', loadCareTemplateIntoEditor);

  modalForm.addEventListener('submit', commitGuidanceModal);

  document.getElementById('orgScanGuidanceDialogCancel').addEventListener('click', function () {
    closeGuidanceModal();
  });
  dialog.addEventListener('click', function (ev) {
    if (ev.target === dialog) closeGuidanceModal();
  });
  dialog.addEventListener('close', function () {
    hideModalMsg();
    resetEditor();
  });

  fetch('/organisation/scan-context', { headers: { Accept: 'application/json' } })
    .then(function (r) {
      return r.json().then(function (d) {
        return { ok: r.ok, d: d };
      });
    })
    .then(function (x) {
      if (!x.ok) throw new Error(x.d.message || 'Could not load scan guidance');
      loadFromServer(x.d);
    })
    .catch(function (e) {
      showScanCtxMsg(e.message || String(e), true);
    });
})();

(function () {
  document.querySelectorAll('.removeMemberBtn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-membership-id');
      if (!confirm('Remove this licensed user from the organisation?')) return;
      var msg = document.getElementById('orgMessage');
      msg.style.display = 'none';
      fetch('/organisation/members/' + encodeURIComponent(id), {
        method: 'DELETE',
        headers: { Accept: 'application/json' },
      })
        .then(function (res) {
          return res.json().then(function (data) {
            if (!res.ok) throw new Error(data.message || res.statusText);
            window.location.reload();
          });
        })
        .catch(function (e) {
          msg.style.display = 'block';
          msg.textContent = e.message;
          msg.style.color = '#c00';
        });
    });
  });
})();

(function () {
  var dialog = document.getElementById('orgAccessEditDialog');
  var form = document.getElementById('orgAccessEditForm');
  if (!dialog || !form) return;

  var isOrgAdmin = dialog.getAttribute('data-is-org-admin') === 'true';
  var roleSel = document.getElementById('orgAccessEditRole');
  var wrap = document.getElementById('orgAccessEditDelegatedWrap');
  var roleRow = document.getElementById('orgAccessRoleRow');
  var emailRow = document.getElementById('orgAccessEmailRow');
  var modalMsg = document.getElementById('orgAccessEditModalMsg');
  var pageMsg = document.getElementById('orgMessage');
  var titleEl = document.getElementById('orgAccessDialogTitle');
  var forEmailEl = document.getElementById('orgAccessEditForEmail');
  var submitBtn = document.getElementById('orgAccessDialogSubmit');
  var addEmailInput = document.getElementById('orgAccessAddEmail');

  function showModalMsg(text, isError) {
    if (!modalMsg) return;
    modalMsg.style.display = 'block';
    modalMsg.textContent = text;
    modalMsg.style.color = isError ? '#c00' : '';
  }
  function hideModalMsg() {
    if (!modalMsg) return;
    modalMsg.style.display = 'none';
    modalMsg.textContent = '';
    modalMsg.style.color = '';
  }

  function refreshSingleSectionClass() {
    if (!form || !roleSel) return;
    var mode = form.getAttribute('data-mode');
    if (mode === 'add' && !isOrgAdmin) {
      form.classList.add('org-access-edit--single-section');
      return;
    }
    form.classList.toggle('org-access-edit--single-section', roleSel.value === 'admin');
  }

  function syncDelegatedVisibility() {
    if (!wrap || !roleSel || !form) return;
    wrap.style.display = roleSel.value === 'admin' ? 'none' : '';
    refreshSingleSectionClass();
  }
  if (roleSel) roleSel.addEventListener('change', syncDelegatedVisibility);

  function openAddModal() {
    hideModalMsg();
    form.setAttribute('data-mode', 'add');
    document.getElementById('orgAccessEditMembershipId').value = '';
    if (titleEl) titleEl.textContent = 'Add licensed user';
    if (submitBtn) submitBtn.textContent = 'Add';
    if (forEmailEl) {
      forEmailEl.style.display = 'none';
      forEmailEl.textContent = '';
    }
    if (emailRow) emailRow.style.display = '';
    if (addEmailInput) addEmailInput.value = '';
    if (isOrgAdmin) {
      if (roleRow) roleRow.style.display = '';
      roleSel.value = 'member';
      document.getElementById('orgAccessEditLicenseAdmin').checked = false;
      document.getElementById('orgAccessEditAiModelAdmin').checked = false;
      document.getElementById('orgAccessEditPromptAdmin').checked = false;
      document.getElementById('orgAccessEditReportAdmin').checked = false;
      document.getElementById('orgAccessEditProjectManager').checked = false;
      syncDelegatedVisibility();
    } else {
      if (roleRow) roleRow.style.display = 'none';
      if (wrap) wrap.style.display = 'none';
      roleSel.value = 'member';
      form.classList.add('org-access-edit--single-section');
    }
    if (typeof dialog.showModal === 'function') dialog.showModal();
  }

  function openEditModal(btn) {
    hideModalMsg();
    form.setAttribute('data-mode', 'edit');
    if (titleEl) titleEl.textContent = 'Edit access';
    if (submitBtn) submitBtn.textContent = 'Save';
    if (emailRow) emailRow.style.display = 'none';
    if (roleRow) roleRow.style.display = '';
    var id = btn.getAttribute('data-membership-id');
    var email = btn.getAttribute('data-email') || '';
    document.getElementById('orgAccessEditMembershipId').value = id;
    if (forEmailEl) {
      forEmailEl.style.display = 'block';
      forEmailEl.textContent = email ? 'User: ' + email : '';
    }
    roleSel.value = btn.getAttribute('data-role') === 'admin' ? 'admin' : 'member';
    document.getElementById('orgAccessEditLicenseAdmin').checked =
      btn.getAttribute('data-license-admin') === 'true';
    document.getElementById('orgAccessEditAiModelAdmin').checked =
      btn.getAttribute('data-ai-model-admin') === 'true';
    document.getElementById('orgAccessEditPromptAdmin').checked =
      btn.getAttribute('data-prompt-admin') === 'true';
    document.getElementById('orgAccessEditReportAdmin').checked =
      btn.getAttribute('data-report-admin') === 'true';
    document.getElementById('orgAccessEditProjectManager').checked =
      btn.getAttribute('data-project-manager') === 'true';
    syncDelegatedVisibility();
    if (typeof dialog.showModal === 'function') dialog.showModal();
  }

  var addBtn = document.getElementById('orgAddLicensedUserBtn');
  if (addBtn) addBtn.addEventListener('click', openAddModal);

  document.querySelectorAll('.orgEditAccessBtn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      openEditModal(btn);
    });
  });

  var cancelBtn = document.getElementById('orgAccessEditCancel');
  if (cancelBtn) cancelBtn.addEventListener('click', function () {
    dialog.close();
  });
  dialog.addEventListener('click', function (ev) {
    if (ev.target === dialog) dialog.close();
  });

  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    hideModalMsg();
    var mode = form.getAttribute('data-mode');
    if (pageMsg) pageMsg.style.display = 'none';

    if (mode === 'add') {
      var email = addEmailInput ? addEmailInput.value.trim() : '';
      if (!email) {
        showModalMsg('Email is required.', true);
        return;
      }
      var payload = { email: email, membershipRole: 'member' };
      if (isOrgAdmin) {
        payload.membershipRole = roleSel.value;
        if (roleSel.value === 'member') {
          payload.licenseAdmin = document.getElementById('orgAccessEditLicenseAdmin').checked;
          payload.aiModelAdmin = document.getElementById('orgAccessEditAiModelAdmin').checked;
          payload.promptAdmin = document.getElementById('orgAccessEditPromptAdmin').checked;
          payload.reportAdmin = document.getElementById('orgAccessEditReportAdmin').checked;
          payload.projectManager = document.getElementById('orgAccessEditProjectManager').checked;
        }
      }
      showModalMsg('Adding…', false);
      fetch('/organisation/members', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function (res) {
          return res.json().then(function (data) {
            if (!res.ok) throw new Error(data.message || res.statusText);
            window.location.reload();
          });
        })
        .catch(function (e) {
          hideModalMsg();
          showModalMsg(e.message || String(e), true);
        });
      return;
    }

    var id = document.getElementById('orgAccessEditMembershipId').value;
    var body = {
      membershipRole: roleSel.value,
      licenseAdmin: document.getElementById('orgAccessEditLicenseAdmin').checked,
      aiModelAdmin: document.getElementById('orgAccessEditAiModelAdmin').checked,
      promptAdmin: document.getElementById('orgAccessEditPromptAdmin').checked,
      reportAdmin: document.getElementById('orgAccessEditReportAdmin').checked,
      projectManager: document.getElementById('orgAccessEditProjectManager').checked,
    };
    if (roleSel.value === 'admin') {
      body.licenseAdmin = false;
      body.aiModelAdmin = false;
      body.promptAdmin = false;
      body.reportAdmin = false;
      body.projectManager = false;
    }
    showModalMsg('Saving…', false);
    fetch('/organisation/members/' + encodeURIComponent(id), {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body),
    })
      .then(function (res) {
        return res.json().then(function (data) {
          if (!res.ok) throw new Error(data.message || res.statusText);
          window.location.reload();
        });
      })
      .catch(function (e) {
        hideModalMsg();
        showModalMsg(e.message || String(e), true);
      });
  });
})();

(function () {
  var section = document.getElementById('orgIntegrationApiSection');
  if (!section) return;
  var tenantId = section.getAttribute('data-tenant-id') || '';
  var msgEl = document.getElementById('orgIntegrationApiMsg');
  var keysBody = document.getElementById('orgIntegrationKeysBody');
  var baseUrlField = document.getElementById('orgIntegrationBaseUrlField');
  var copyTenantBtn = document.getElementById('orgIntegrationCopyTenantId');
  var dialog = document.getElementById('orgIntegrationKeyDialog');
  var stepCreate = document.getElementById('orgIntegrationKeyStepCreate');
  var stepReveal = document.getElementById('orgIntegrationKeyStepReveal');
  var modalMsg = document.getElementById('orgIntegrationKeyModalMsg');
  var keyForm = document.getElementById('orgIntegrationKeyForm');
  var labelInput = document.getElementById('orgIntegrationKeyModalLabel');
  var revealInput = document.getElementById('orgIntegrationKeyRevealValue');
  var titleEl = document.getElementById('orgIntegrationKeyDialogTitle');
  var submitBtn = document.getElementById('orgIntegrationKeySubmitBtn');
  var addBtn = document.getElementById('orgAddIntegrationKeyBtn');

  function showMsg(text, isErr) {
    if (!msgEl) return;
    msgEl.style.display = text ? 'block' : 'none';
    msgEl.textContent = text || '';
    msgEl.style.color = isErr ? '#c00' : '';
  }

  function showModalMsg(text, isErr) {
    if (!modalMsg) return;
    if (!text) {
      modalMsg.style.display = 'none';
      modalMsg.textContent = '';
      modalMsg.style.color = '';
      return;
    }
    modalMsg.style.display = 'block';
    modalMsg.textContent = text;
    modalMsg.style.color = isErr ? '#c00' : '';
  }

  function integrationProjectsUrl() {
    return window.location.origin + '/organisation/' + tenantId + '/api/v1/projects';
  }

  if (baseUrlField) baseUrlField.value = integrationProjectsUrl();

  function formatIso(iso) {
    if (!iso) return '—';
    try {
      return new Date(iso).toLocaleString();
    } catch (e) {
      return '—';
    }
  }

  function renderKeyRows(keys) {
    if (!keysBody) return;
    keysBody.textContent = '';
    if (!keys || keys.length === 0) {
      var tr0 = document.createElement('tr');
      var td0 = document.createElement('td');
      td0.colSpan = 5;
      td0.className = 'small';
      td0.textContent = 'No keys yet. Use Create integration key for Zapier, Make, n8n, or your own scripts.';
      tr0.appendChild(td0);
      keysBody.appendChild(tr0);
      return;
    }
    keys.forEach(function (k) {
      var tr = document.createElement('tr');
      function tdText(t) {
        var td = document.createElement('td');
        td.textContent = t;
        return td;
      }
      tr.appendChild(tdText(k.prefix || ''));
      tr.appendChild(tdText(k.label || '—'));
      tr.appendChild(tdText(formatIso(k.createdAt)));
      tr.appendChild(tdText(formatIso(k.lastUsedAt)));
      var tdAct = document.createElement('td');
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'transparent org-integration-revoke-key';
      btn.textContent = 'Revoke';
      if (k.id) btn.setAttribute('data-key-id', k.id);
      tdAct.appendChild(btn);
      tr.appendChild(tdAct);
      keysBody.appendChild(tr);
    });
  }

  var initial = window.__orgIntegrationInitialKeys;
  if (!Array.isArray(initial)) initial = [];
  renderKeyRows(initial);

  function copyEl(el) {
    if (!el || !navigator.clipboard || !navigator.clipboard.writeText) return;
    var t =
      el.tagName === 'INPUT' || el.tagName === 'TEXTAREA'
        ? String(el.value || '')
        : String(el.textContent || '').trim();
    if (!t) return;
    navigator.clipboard.writeText(t);
  }

  if (copyTenantBtn) {
    copyTenantBtn.addEventListener('click', function () {
      copyEl(document.getElementById('orgIntegrationTenantIdDisplay'));
      showMsg('Tenant ID copied.', false);
      setTimeout(function () {
        showMsg('', false);
      }, 2000);
    });
  }

  function resetIntegrationKeyModal() {
    showModalMsg('', false);
    if (stepCreate) stepCreate.hidden = false;
    if (stepReveal) stepReveal.hidden = true;
    if (labelInput) labelInput.value = '';
    if (revealInput) revealInput.value = '';
    if (titleEl) titleEl.textContent = 'Create integration key';
    if (submitBtn) submitBtn.disabled = false;
  }

  function openIntegrationKeyModal() {
    resetIntegrationKeyModal();
    if (typeof dialog.showModal === 'function') dialog.showModal();
    if (labelInput) labelInput.focus();
  }

  function closeIntegrationKeyModal() {
    if (dialog && typeof dialog.close === 'function') dialog.close();
  }

  if (addBtn) {
    addBtn.addEventListener('click', openIntegrationKeyModal);
  }

  if (dialog) {
    dialog.addEventListener('close', function () {
      resetIntegrationKeyModal();
    });
  }

  var cancelBtn = document.getElementById('orgIntegrationKeyCancelBtn');
  if (cancelBtn) {
    cancelBtn.addEventListener('click', function () {
      closeIntegrationKeyModal();
    });
  }

  var copyRevealBtn = document.getElementById('orgIntegrationKeyCopyRevealBtn');
  if (copyRevealBtn && revealInput) {
    copyRevealBtn.addEventListener('click', function () {
      copyEl(revealInput);
      showModalMsg('Key copied to clipboard.', false);
      setTimeout(function () {
        if (stepReveal && !stepReveal.hidden) showModalMsg('', false);
      }, 2000);
    });
  }

  var doneBtn = document.getElementById('orgIntegrationKeyDoneBtn');
  if (doneBtn) {
    doneBtn.addEventListener('click', function () {
      closeIntegrationKeyModal();
    });
  }

  if (keysBody) {
    keysBody.addEventListener('click', function (ev) {
      var t = ev.target;
      if (!t || !t.classList || !t.classList.contains('org-integration-revoke-key')) return;
      var kid = t.getAttribute('data-key-id');
      if (!kid) return;
      if (!confirm('Revoke this key? Automations using it will stop working.')) return;
      showMsg('', false);
      fetch('/organisation/integration-api-keys/' + encodeURIComponent(kid), {
        method: 'DELETE',
        headers: { Accept: 'application/json' },
      })
        .then(function (res) {
          return res.json().then(function (d) {
            if (!res.ok) throw new Error(d.message || res.statusText);
            return d;
          });
        })
        .then(function () {
          return fetch('/organisation', { headers: { Accept: 'application/json' } });
        })
        .then(function (res) {
          return res.json();
        })
        .then(function (ctx) {
          renderKeyRows((ctx.subscription && ctx.subscription.integrationApiKeys) || []);
          showMsg('Key revoked.', false);
        })
        .catch(function (e) {
          showMsg(e.message || String(e), true);
        });
    });
  }

  if (keyForm) {
    keyForm.addEventListener('submit', function (ev) {
      ev.preventDefault();
      var label = labelInput ? labelInput.value.trim() : '';
      showModalMsg('', false);
      if (submitBtn) submitBtn.disabled = true;
      showModalMsg('Creating key…', false);
      fetch('/organisation/integration-api-keys', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ label: label }),
      })
        .then(function (res) {
          return res.json().then(function (d) {
            if (!res.ok) throw new Error(d.message || res.statusText);
            return d;
          });
        })
        .then(function (d) {
          return fetch('/organisation', { headers: { Accept: 'application/json' } }).then(function (res) {
            return res.json().then(function (ctx) {
              return { key: d.key, ctx: ctx };
            });
          });
        })
        .then(function (bundle) {
          renderKeyRows(
            (bundle.ctx.subscription && bundle.ctx.subscription.integrationApiKeys) || []
          );
          showModalMsg('', false);
          if (stepCreate) stepCreate.hidden = true;
          if (stepReveal) stepReveal.hidden = false;
          if (revealInput) {
            revealInput.value = bundle.key || '';
            revealInput.select();
          }
          if (titleEl) titleEl.textContent = 'Your new key';
          if (submitBtn) submitBtn.disabled = false;
          showMsg('Integration key created. Copy it in the dialog before closing.', false);
        })
        .catch(function (e) {
          if (submitBtn) submitBtn.disabled = false;
          showModalMsg(e.message || String(e), true);
        });
    });
  }
})();
</script>
<% } %>
