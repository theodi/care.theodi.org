[
    {
        "key": "stakeholders",
        "prepend": "<div class='care-step-help-source' hidden aria-hidden='true'><h2>Who are the stakeholders?</h2><p>Please list the names or titles of individuals, teams, or organisations that are <b>involved in</b>, or <b>impacted by</b> your project.</p><p>For each stakeholder, indicate whether they are an \"internal\" stakeholder (part of your organisation or project team) or an \"external\" stakeholder (outside the organisation or project team).</p></div>",
        "notitle": true,
        "htmlClass": "content-block white stakeholders",
        "type": "array",
        "items": {
            "type": "section",
            "items": [
                {
                    "key": "stakeholders[].stakeholder",
                    "fieldHtmlClass": "input inputText",
                    "placeholder": "Enter a stakeholder here",
                    "prepend": "<h2 class='draggable'>Stakeholder</h2>",
                    "notitle": true
                },
                {
                    "key": "stakeholders[].type",
                    "fieldHtmlClass": "input inputSelect",
                    "placeholder": "internal/external",
                    "prepend": "<h4>Type</h4>",
                    "notitle": true
                }
            ]
        }
    },
    {
        "type": "submit",
        "title": "Proceed to action planning",
        "htmlClass": "submitButton",
        "next": "actionPlanning",
        "quickNav": "true"
    }
]
