# Server config
PORT=3080
HOST=http://localhost:{PORT}

# OAuth Credentials
DJANGO_CLIENT_ID=your_django_client_id
DJANGO_CLIENT_SECRET=your_django_client_secret
DJANGO_CALLBACK_URL=/auth/django/callback

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=/auth/google/callback

# Default local account password for demo/test accounts

# Session Secret
SESSION_SECRET=your_session_secret

# Optional: extra pepper for hashing tenant integration API keys (defaults to SESSION_SECRET if unset)
# TENANT_INTEGRATION_API_PEPPER=

# MONGO DB config (sessions are stored in the same DB, collection `sessions`)
MONGO_URI=mongodb://localhost:27017/database
MONGO_DB=database

# --- AI assistant (pick one provider) ---
# Most hosted APIs use either the OpenAI chat-completions shape or their own:
# - openai, openai_compatible (same JSON format; includes Azure OpenAI, Groq, LiteLLM, many proxies)
# - anthropic (Claude Messages API)
# - google (Gemini REST; different request/response shape — handled in code)
#
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=           # optional umbrella; else use provider-specific keys below
# OPENAI_API_KEY=your_openai_api_key
#
# OpenAI-compatible / custom base URL (Azure OpenAI, Groq, self-hosted, etc.):
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# AI_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI=true
# AI_API_KEY=your_azure_openai_key
# AI_MODEL=YOUR_DEPLOYMENT_NAME
#
# Anthropic:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_key
# AI_MODEL=claude-3-5-sonnet-20241022
#
# Google Gemini (structured outputs: responseMimeType application/json + responseJsonSchema in API)
# AI_PROVIDER=google
# GOOGLE_API_KEY=your_key
# AI_MODEL=gemini-2.0-flash   # use a model that supports responseJsonSchema (see Google AI docs)
#
# Optional for all: AI_MAX_TOKENS=24000
# Anthropic streaming thinking budget (must be < AI_MAX_TOKENS; higher = more verbose/slower): AI_ANTHROPIC_THINKING_BUDGET=10000
# OpenAI: newer models need max_completion_tokens (default). Old/Azure-only endpoints: AI_OPENAI_LEGACY_MAX_TOKENS=true
# Disable OpenAI json_schema / Anthropic forced tools (use plain completion + markdown JSON parse only): AI_DISABLE_STRUCTURED_OUTPUT=true
# Optional: override vendor name / privacy link on the About page (e.g. custom OpenAI-compatible gateway)
# AI_PUBLIC_VENDOR_NAME=Our organisation AI
# AI_PUBLIC_VENDOR_PRIVACY_URL=https://example.com/privacy
# Future: per-organisation overrides (endpoint, model, key) can be layered in the assistant route.
# Smoke-test from CLI (loads config.env then .env): npm run test-ai
#   Step 1 = plain chat; step 2 = json_schema (OpenAI) or tool use (Anthropic). Flags: --simple-only, --structured-only

OPENAI_API_KEY=your_openai_api_key

# HubSpot KEY
HUBSPOT_API_KEY=your_hubspot_key

# Set the limit for the number of free projects
FREE_PROJECT_LIMIT=1